<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
  xmlns:owl="http://www.w3.org/2002/07/owl#"
  xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
  xmlns:dcterms="http://purl.org/dc/terms/"
  xmlns:dc11="http://purl.org/dc/elements/1.1/"
  xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
  xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
  xmlns:skos="http://www.w3.org/2004/02/skos/core#"
>
  <owl:Class rdf:about="https://w3id.org/rbaco/bfo/RBACO_0000019">
    <rdfs:subClassOf rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000018"/>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="n98c48ae2dbe045be825f75f4e24d694fb69">
        <owl:onProperty rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000125"/>
        <owl:allValuesFrom rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000013"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <owl:disjointWith rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000020"/>
    <dc11:identifier>019-RBACO</dc11:identifier>
    <rdfs:label xml:lang="en">static separation of duty conflict report</rdfs:label>
    <skos:definition xml:lang="en">A conflict report describing an agent authorized for n or more members of a static separation of duty constraint's set.</skos:definition>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://w3id.org/rbaco/bfo/RBACO_0000136">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000003"/>
    <rdfs:range rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000041"/>
    <dc11:identifier>136-RBACO</dc11:identifier>
    <rdfs:label xml:lang="en">is activated for</rdfs:label>
    <skos:definition xml:lang="en">Relates an active role to the task instance it was activated to perform.</skos:definition>
    <skos:scopeNote xml:lang="en">Botha and Eloff's WSession, "a run-time mapping of one user to the most junior role required for a specific task" (2001, p.674). Optional, because "not all access control decisions in an organization will be made in the context of a workflow" (p.671). The task instance is an occurrent part of the business process instance the role is activated in ([rbaco-k2]); the role concretizes the task's required role definition itself and inheres in the task instance's agent ([rbaco-k3]). Several WSessions for one task instance are several active roles over time.</skos:scopeNote>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/rbaco/bfo/RBACO_0000139">
    <rdfs:subPropertyOf>
      <rdf:Description rdf:about="https://www.commoncoreontologies.org/ont00001808">
        <owl:equivalentProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000136"/>
        <skos:editorialNote xml:lang="en">Interpretation, not asserted by CCO or IAO: CCO cites IAO_0000136 as the definition source of its is about (InformationEntityOntology.ttl ont00001808), and declares nothing about it. Declaring the two equivalent makes CCO's ICE (ont00000958) and IAO's ICE (IAO_0000030) equivalent: IAO_0000030 is a subclass of GDC and of (IAO_0000136 some entity), which then satisfies CCO's definition; and CCO's ICE has some is-about value, so it falls in IAO_0000136's domain. See docs/verification.md for the reasoner status of this entailment.</skos:editorialNote>
      </rdf:Description>
    </rdfs:subPropertyOf>
    <rdfs:domain rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000045"/>
    <rdfs:range rdf:resource="https://www.commoncoreontologies.org/ont00000300"/>
    <dc11:identifier>139-RBACO</dc11:identifier>
    <rdfs:label xml:lang="en">designates conflicting group</rdfs:label>
    <skos:definition xml:lang="en">Relates a conflicting agent designation to a group of agents whose member parts at a time count as one agent at that time.</skos:definition>
    <skos:scopeNote xml:lang="en">Member part of (BFO_0000129) is time-indexed in BFO 2020, so a group such as a CCO Family (ont00000837) gains and loses members without the designation changing ([rbaco-u3]). The SPARQL queries read member part of without its time, as OWL states it.</skos:scopeNote>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/rbaco/bfo/RBACO_0000131">
    <rdfs:domain rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000001"/>
    <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/BFO_0000040"/>
    <dc11:identifier>131-RBACO</dc11:identifier>
    <rdfs:label xml:lang="en">has authorized member</rdfs:label>
    <skos:definition xml:lang="en">Relates a role definition to a material entity that, at one evaluation time, holds an assigned role concretizing it or a senior role definition, or is a member by the RT statements in force.</skos:definition>
    <skos:scopeNote xml:lang="en">Snapshot property: derived by queries/derive-authorized-members.rq and queries/derive-rt-membership.rq, never asserted in base data. NIST authorized_users (Def. 2a, p.235).</skos:scopeNote>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/rbaco/bfo/RBACO_0000146">
    <rdfs:subPropertyOf>
      <owl:ObjectProperty rdf:about="https://w3id.org/rbaco/bfo/RBACO_0000149">
        <rdfs:subPropertyOf rdf:resource="https://www.commoncoreontologies.org/ont00001982"/>
        <rdfs:domain rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000018"/>
        <rdfs:range rdf:resource="https://www.commoncoreontologies.org/ont00000965"/>
        <dc11:identifier>149-RBACO</dc11:identifier>
        <rdfs:label xml:lang="en">describes conflicting member</rdfs:label>
        <skos:definition xml:lang="en">Relates a conflict report to a member of the violated constraint's set that the breach counts: a role definition, access permission or task specification.</skos:definition>
        <skos:scopeNote xml:lang="en">The parent of RBACO_0000126, RBACO_0000146 and RBACO_0000147, so that a conflict report's minimum of two members holds whatever kind of set it describes. A permission report names every member whose content was counted, so members of one content are named together and count once.</skos:scopeNote>
      </owl:ObjectProperty>
    </rdfs:subPropertyOf>
    <rdfs:domain rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000018"/>
    <rdfs:range rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000007"/>
    <dc11:identifier>146-RBACO</dc11:identifier>
    <rdfs:label xml:lang="en">describes conflicting permission</rdfs:label>
    <skos:definition xml:lang="en">Relates a conflict report to a permission of the violated constraint's set that the subject holds or has exercised.</skos:definition>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://w3id.org/rbaco/bfo/RBACO_0000015">
    <rdfs:subClassOf rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000014"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000042"/>
    <owl:disjointWith rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000016"/>
    <dc11:identifier>015-RBACO</dc11:identifier>
    <rdfs:label xml:lang="en">same-time dynamic separation of duty constraint</rdfs:label>
    <skos:definition xml:lang="en">A dynamic separation of duty constraint that counts only the roles an agent has active in the instance at the time of the activation request.</skos:definition>
    <skos:scopeNote xml:lang="en">NIST as written: a cashier who wants to act as cashier supervisor must drop the cashier role first (p.240).</skos:scopeNote>
  </owl:Class>
  <owl:Ontology rdf:about="https://w3id.org/rbaco/bfo/rbaco-bfo.owl">
    <owl:versionIRI rdf:resource="https://w3id.org/rbaco/bfo/2026-11-05/rbaco-bfo.owl"/>
    <owl:imports rdf:resource="http://purl.obolibrary.org/obo/bfo/2020/bfo-core.ttl"/>
    <owl:imports rdf:resource="https://www.commoncoreontologies.org/AgentOntology"/>
    <owl:imports rdf:resource="https://www.commoncoreontologies.org/EventOntology"/>
    <owl:imports rdf:resource="https://www.commoncoreontologies.org/InformationEntityOntology"/>
    <owl:imports rdf:resource="https://www.commoncoreontologies.org/ArtifactOntology"/>
    <owl:imports rdf:resource="https://www.commoncoreontologies.org/ExtendedRelationOntology"/>
    <owl:imports rdf:resource="https://w3id.org/rbaco/bfo/imports/iao-extract.owl"/>
    <rdfs:label xml:lang="en">Role-Based Access Control Ontology, BFO edition (RBACO-BFO)</rdfs:label>
    <dcterms:title xml:lang="en">Role-Based Access Control Ontology, BFO edition (RBACO-BFO)</dcterms:title>
    <dcterms:description xml:lang="en">A BFO 2020 and CCO conformant ontology covering the patterns of ROWLBAC (Finin et al., SACMAT 2008) to the semantics of the proposed NIST RBAC standard (Ferraiolo et al., ACM TISSEC 4(3), 2001). Sessions are business process instances, and tasks within them carry the separation of duty patterns of Botha and Eloff (IBM Systems Journal 40(3), 2001). An RBAC role is a role definition (an information content entity) concretized by a BFO role of each assigned person. Constraints are regulations whose violations are found by SPARQL queries and recorded as conflict reports.</dcterms:description>
    <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
    <rdfs:comment xml:lang="en">Source, releases and documentation: https://github.com/a-pereira/rbaco-bfo</rdfs:comment>
    <owl:versionInfo xml:lang="en">0.1.0 of 2026-11-05, the first release, with tasks and conflicting entities after Botha and Eloff 2001, task-bound operations, and conflict reports over role, permission and task members</owl:versionInfo>
  </owl:Ontology>
  <owl:ObjectProperty rdf:about="https://w3id.org/rbaco/bfo/RBACO_0000128">
    <rdfs:subPropertyOf rdf:resource="https://www.commoncoreontologies.org/ont00001982"/>
    <rdfs:domain rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000018"/>
    <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
    <dc11:identifier>128-RBACO</dc11:identifier>
    <rdfs:label xml:lang="en">describes conflicting act</rdfs:label>
    <skos:definition xml:lang="en">Relates a conflict report to the act that produced the breach: the role assignment or policy issuing act that completed it, or the activation or access request refused for it.</skos:definition>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://w3id.org/rbaco/bfo/RBACO_0000028">
    <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00001194"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000030"/>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="n98c48ae2dbe045be825f75f4e24d694fb87">
        <owl:onProperty rdf:resource="https://www.commoncoreontologies.org/ont00001986"/>
        <owl:someValuesFrom rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000002"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <dc11:identifier>028-RBACO</dc11:identifier>
    <rdfs:label xml:lang="en">role assignment</rdfs:label>
    <skos:definition xml:lang="en">A Gain of Role and policy administration act whose output is an assigned role.</skos:definition>
    <skos:scopeNote xml:lang="en">NIST AssignUser (p.245).</skos:scopeNote>
    <skos:editorialNote xml:lang="en">Interpretation, not asserted by any source: that one process is both the officer's declaration and the assignee's Gain of Role, and that it realizes an Authority Role, which CCO defines as realized by processes that create, modify, transfer or eliminate Process Regulations or other Authority Roles (AgentOntology.ttl ont00000187). An assigned role is neither; the reading takes the assignment as a change to the policy that governs access. The alternative is two processes, the declaration and the gain it brings about (design record D4).</skos:editorialNote>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/rbaco/bfo/RBACO_0000046">
    <rdfs:subClassOf rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000045"/>
    <owl:disjointWith rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000047"/>
    <dc11:identifier>046-RBACO</dc11:identifier>
    <rdfs:label xml:lang="en">static conflicting agent designation</rdfs:label>
    <skos:definition xml:lang="en">A conflicting agent designation applying to static separation of duty constraints.</skos:definition>
  </owl:Class>
  <owl:AnnotationProperty rdf:about="https://w3id.org/rbaco/bfo/RBACO_0000301">
    <dc11:identifier>301-RBACO</dc11:identifier>
    <rdfs:label xml:lang="en">corresponds to role definition</rdfs:label>
    <skos:definition xml:lang="en">Relates a role universal (an OWL class) to the role definition individual in an access-control system whose seniority edges the universal's subclass axioms mirror.</skos:definition>
    <skos:scopeNote xml:lang="en">Used by the hierarchy drift check (queries/check-hierarchy-drift.rq). An annotation, so it carries no OWL semantics and keeps class and individual apart.</skos:scopeNote>
  </owl:AnnotationProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/rbaco/bfo/RBACO_0000120">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000001"/>
    <rdfs:range rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000001"/>
    <dc11:identifier>120-RBACO</dc11:identifier>
    <rdfs:label xml:lang="en">is senior to</rdfs:label>
    <skos:definition xml:lang="en">Relates a role definition to a distinct role definition below it in the role hierarchy, according to the role inheritance statements in force at one evaluation time.</skos:definition>
    <skos:scopeNote xml:lang="en">Snapshot property: derived by queries/derive-hierarchy-snapshot.rq for one evaluation time and never asserted in base data. NIST's ordering is a partial order (Def. 2a, p.235). This property is its strict part; reflexivity is supplied by the zero-length path in queries, and acyclicity, which with transitivity gives antisymmetry, is checked by queries/check-hierarchy-cycles.rq because OWL 2 cannot state it.</skos:scopeNote>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/rbaco/bfo/RBACO_0000137">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000025"/>
    <rdfs:range rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000048"/>
    <dc11:identifier>137-RBACO</dc11:identifier>
    <rdfs:label xml:lang="en">requests activation for</rdfs:label>
    <skos:definition xml:lang="en">Relates a role activation request to the work item the requested active role would serve.</skos:definition>
    <skos:scopeNote xml:lang="en">A work item, not a task instance, because a refused request leaves no task instance to name: the task instance begins only when the activation is granted, prescribed by the work item, with the requester as agent. Functional: a request serves one work item. The request is where strict least privilege, task-based separation of duty, the human-performer requirement and the prior-task guard are enforced (queries/decide-activation.rq), since task acceptance is recorded as the task instance's agent and is no act of its own.</skos:scopeNote>
  </owl:ObjectProperty>
  <owl:AnnotationProperty rdf:about="https://w3id.org/rbaco/bfo/RBACO_0000303">
    <dc11:identifier>303-RBACO</dc11:identifier>
    <rdfs:label xml:lang="en">has object location type criterion</rdfs:label>
    <skos:definition xml:lang="en">Relates an object description to a class whose instances the described objects must be located in.</skos:definition>
  </owl:AnnotationProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/rbaco/bfo/RBACO_0000143">
    <rdfs:domain rdf:resource="https://www.commoncoreontologies.org/ont00000228"/>
    <rdfs:range rdf:resource="https://www.commoncoreontologies.org/ont00001017"/>
    <dc11:identifier>143-RBACO</dc11:identifier>
    <rdfs:label xml:lang="en">is performed on behalf of</rdfs:label>
    <skos:definition xml:lang="en">Relates a planned act to the agent on whose behalf its agent performed it.</skos:definition>
    <skos:scopeNote xml:lang="en">Separation of duty compares the principal of an act: the agent it was performed on behalf of, if any, else its agent ([rbaco-p1]). A relation between acts and agents, not between agents, because one workflow host acts for many people. The counterpart in PROV-O (W3C Recommendation 2013-04-30) is prov:actedOnBehalfOf qualified by a prov:Delegation naming the activity; PROV-O is not imported, since it is not built on BFO.</skos:scopeNote>
    <rdfs:seeAlso rdf:resource="http://www.w3.org/ns/prov#qualifiedDelegation"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/rbaco/bfo/RBACO_0000144">
    <rdfs:subPropertyOf rdf:resource="https://www.commoncoreontologies.org/ont00001808"/>
    <rdfs:domain rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000040"/>
    <rdfs:range rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000040"/>
    <dc11:identifier>144-RBACO</dc11:identifier>
    <rdfs:label xml:lang="en">requires prior</rdfs:label>
    <skos:definition xml:lang="en">Relates a task specification to one of which an instance must have finished, with a person as agent, earlier in the same business process instance before an instance of the first may be activated for.</skos:definition>
    <skos:scopeNote xml:lang="en">The completion guard for human-in-the-loop processes ([rbaco-g2]). Unconditional: routing predicates such as the approval threshold of Botha and Eloff's purchase process (VALUE &gt;= 10 000, Figure 2, p.669) are not modeled, so a branching route makes its branches separate plans. The guard belongs to the specification, not to a plan: the human performer and task-binding requirements are scoped to plans by applies within (RBACO_0000115), but a specification that requires prior another carries the guard into every plan it is part of. In the examples the one guarded specification, issue items, is part of a single plan, while five others are each part of four or five.</skos:scopeNote>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/rbaco/bfo/RBACO_0000147">
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000149"/>
    <rdfs:domain rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000018"/>
    <rdfs:range rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000040"/>
    <dc11:identifier>147-RBACO</dc11:identifier>
    <rdfs:label xml:lang="en">describes conflicting task specification</rdfs:label>
    <skos:definition xml:lang="en">Relates a conflict report to a task specification of the violated constraint's set that the subject can perform or has performed.</skos:definition>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://w3id.org/rbaco/bfo/RBACO_0000011">
    <rdfs:subClassOf rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000009"/>
    <dc11:identifier>011-RBACO</dc11:identifier>
    <rdfs:label xml:lang="en">requester office condition</rdfs:label>
    <skos:definition xml:lang="en">An object description that additionally requires the object to be located in the office of the requester.</skos:definition>
    <skos:scopeNote xml:lang="en">ROWLBAC's second §4.1 example. The equality of the object's location and the subject's office is a role value map in description logic terms, so this condition has no criteria class and is decided by query only.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/rbaco/bfo/RBACO_0000027">
    <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000613"/>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="n98c48ae2dbe045be825f75f4e24d694fb86">
        <owl:onProperty rdf:resource="https://www.commoncoreontologies.org/ont00001921"/>
        <owl:someValuesFrom rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000003"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <dc11:identifier>027-RBACO</dc11:identifier>
    <rdfs:label xml:lang="en">role deactivation</rdfs:label>
    <skos:definition xml:lang="en">A Loss of Role whose input is an active role, which ceases to exist.</skos:definition>
    <skos:scopeNote xml:lang="en">NIST DropActiveRole (p.254), or the end of the business process instance.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/rbaco/bfo/RBACO_0000029">
    <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000613"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000030"/>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="n98c48ae2dbe045be825f75f4e24d694fb88">
        <owl:onProperty rdf:resource="https://www.commoncoreontologies.org/ont00001921"/>
        <owl:someValuesFrom rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000002"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <dc11:identifier>029-RBACO</dc11:identifier>
    <rdfs:label xml:lang="en">role deassignment</rdfs:label>
    <skos:definition xml:lang="en">A Loss of Role and policy administration act whose input is an assigned role, which ceases to exist.</skos:definition>
    <skos:scopeNote xml:lang="en">NIST DeassignUser (p.252).</skos:scopeNote>
  </owl:Class>
  <owl:AnnotationProperty rdf:about="https://w3id.org/rbaco/bfo/RBACO_0000305">
    <dc11:identifier>305-RBACO</dc11:identifier>
    <rdfs:label xml:lang="en">has criteria class</rdfs:label>
    <skos:definition xml:lang="en">Relates a description to an OWL defined class equivalent to its criteria, where the criteria are expressible in OWL 2 DL.</skos:definition>
    <skos:scopeNote xml:lang="en">Lets a DL reasoner classify matching objects (ROWLBAC §4.1, first example). Criteria that need a role value map have no criteria class.</skos:scopeNote>
  </owl:AnnotationProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/rbaco/bfo/RBACO_0000111">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000025"/>
    <rdfs:range rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000026"/>
    <dc11:identifier>111-RBACO</dc11:identifier>
    <rdfs:label xml:lang="en">is fulfilled by</rdfs:label>
    <skos:definition xml:lang="en">Relates a role activation request to the role activation that granted it.</skos:definition>
    <skos:scopeNote xml:lang="en">A refused activation is a request with no fulfillment; nothing else marks it. Functional and inverse functional: a request is fulfilled by at most one activation, and an activation fulfills at most one request.</skos:scopeNote>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://w3id.org/rbaco/bfo/RBACO_0000031">
    <rdfs:subClassOf rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000030"/>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="n98c48ae2dbe045be825f75f4e24d694fb90">
        <owl:onProperty rdf:resource="https://www.commoncoreontologies.org/ont00001986"/>
        <owl:someValuesFrom rdf:resource="https://www.commoncoreontologies.org/ont00000958"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <dc11:identifier>031-RBACO</dc11:identifier>
    <rdfs:label xml:lang="en">policy issuing act</rdfs:label>
    <skos:definition xml:lang="en">A policy administration act whose output is an information content entity that comes into force with it.</skos:definition>
    <skos:example xml:lang="en">AddRole (NIST p.251), GrantPermission (p.252), AddInheritance (p.244), CreateSsdSet (p.261); issuing an RT statement.</skos:example>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://w3id.org/rbaco/bfo/RBACO_0000138">
    <rdfs:subPropertyOf rdf:resource="https://www.commoncoreontologies.org/ont00001808"/>
    <rdfs:domain rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000045"/>
    <rdfs:range rdf:resource="https://www.commoncoreontologies.org/ont00001017"/>
    <dc11:identifier>138-RBACO</dc11:identifier>
    <rdfs:label xml:lang="en">designates conflicting agent</rdfs:label>
    <skos:definition xml:lang="en">Relates a conflicting agent designation to an agent it names.</skos:definition>
  </owl:ObjectProperty>
  <owl:AnnotationProperty rdf:about="https://w3id.org/rbaco/bfo/RBACO_0000302">
    <dc11:identifier>302-RBACO</dc11:identifier>
    <rdfs:label xml:lang="en">has object type criterion</rdfs:label>
    <skos:definition xml:lang="en">Relates an object description to a class whose instances the described objects must be.</skos:definition>
  </owl:AnnotationProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/rbaco/bfo/RBACO_0000130">
    <rdfs:subPropertyOf rdf:resource="https://www.commoncoreontologies.org/ont00001808"/>
    <rdfs:domain rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000039"/>
    <rdfs:range rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000033"/>
    <dc11:identifier>130-RBACO</dc11:identifier>
    <rdfs:label xml:lang="en">treats as shrink-restricted</rdfs:label>
    <skos:definition xml:lang="en">Relates a security analysis specification to an RT role definition that the analysis assumes will lose none of its defining statements.</skos:definition>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/rbaco/bfo/RBACO_0000204">
    <rdfs:domain rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000018"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <dc11:identifier>204-RBACO</dc11:identifier>
    <rdfs:label xml:lang="en">has justification</rdfs:label>
    <skos:definition xml:lang="en">A human-readable statement of why the conflict report was produced.</skos:definition>
    <skos:scopeNote xml:lang="en">ROWLBAC's justification (§3.3.5).</skos:scopeNote>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/rbaco/bfo/RBACO_0000133">
    <rdfs:subPropertyOf rdf:resource="https://www.commoncoreontologies.org/ont00001808"/>
    <rdfs:domain rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000040"/>
    <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/IAO_0000104"/>
    <dc11:identifier>133-RBACO</dc11:identifier>
    <rdfs:label xml:lang="en">requires operation</rdfs:label>
    <skos:definition xml:lang="en">Relates a task specification to an operation its instances need.</skos:definition>
    <skos:scopeNote xml:lang="en">A statement of need, not a grant: access is decided through the required role definition. It becomes a condition of access only for an operation a task-bound operation requirement (RBACO_0000050) names: a request for that operation is then denied unless it is part of a task instance whose specification requires the operation. Read by queries/decide-access.rq, queries/check-task-specs.rq (coverage, least-privilege slack, requests outside the task's needs), queries/check-conflict-coverage.rq, queries/check-sod-hierarchy.rq and queries/cq-worklist.rq.</skos:scopeNote>
  </owl:ObjectProperty>
  <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#example"/>
  <owl:DatatypeProperty rdf:about="https://w3id.org/rbaco/bfo/RBACO_0000205">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/BFO_0000203"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <dc11:identifier>205-RBACO</dc11:identifier>
    <rdfs:label xml:lang="en">has timestamp</rdfs:label>
    <skos:definition xml:lang="en">The calendar date and clock time at which a temporal instant falls.</skos:definition>
    <skos:scopeNote xml:lang="en">CCO deprecates its generic datetime value property in favor of domain-specific ones.</skos:scopeNote>
  </owl:DatatypeProperty>
  <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#definition"/>
  <owl:ObjectProperty rdf:about="https://w3id.org/rbaco/bfo/RBACO_0000126">
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000149"/>
    <rdfs:domain rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000018"/>
    <rdfs:range rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000001"/>
    <dc11:identifier>126-RBACO</dc11:identifier>
    <rdfs:label xml:lang="en">describes conflicting role definition</rdfs:label>
    <skos:definition xml:lang="en">Relates a conflict report to a role definition from the constraint's set that the agent holds or would hold.</skos:definition>
    <skos:scopeNote xml:lang="en">ROWLBAC's ssod-role (§3.4.4).</skos:scopeNote>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/rbaco/bfo/RBACO_0000140">
    <rdfs:subPropertyOf rdf:resource="https://www.commoncoreontologies.org/ont00001808"/>
    <rdfs:domain rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000045"/>
    <rdfs:range rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000012"/>
    <dc11:identifier>140-RBACO</dc11:identifier>
    <rdfs:label xml:lang="en">applies to constraint</rdfs:label>
    <skos:definition xml:lang="en">Relates a conflicting agent designation to a separation of duty constraint it applies to.</skos:definition>
    <skos:scopeNote xml:lang="en">A designation with no value applies to every constraint of its kind: a static designation to every static constraint, a dynamic one to every dynamic constraint.</skos:scopeNote>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/rbaco/bfo/RBACO_0000129">
    <rdfs:subPropertyOf rdf:resource="https://www.commoncoreontologies.org/ont00001808"/>
    <rdfs:domain rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000039"/>
    <rdfs:range rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000033"/>
    <dc11:identifier>129-RBACO</dc11:identifier>
    <rdfs:label xml:lang="en">treats as growth-restricted</rdfs:label>
    <skos:definition xml:lang="en">Relates a security analysis specification to an RT role definition that the analysis assumes will gain no new defining statements.</skos:definition>
    <skos:scopeNote xml:lang="en">An assumption of one analysis, not a fact about the role: the restrictions are not actually enforced, but are assumptions underlying the analysis (ROWLBAC §4.2).</skos:scopeNote>
  </owl:ObjectProperty>
  <owl:AllDisjointClasses rdf:nodeID="n98c48ae2dbe045be825f75f4e24d694fb54">
    <owl:members rdf:parseType="Collection">
      <rdf:Description rdf:about="https://w3id.org/rbaco/bfo/RBACO_0000042"/>
      <rdf:Description rdf:about="https://w3id.org/rbaco/bfo/RBACO_0000043"/>
      <rdf:Description rdf:about="https://w3id.org/rbaco/bfo/RBACO_0000044"/>
    </owl:members>
  </owl:AllDisjointClasses>
  <owl:Class rdf:about="https://w3id.org/rbaco/bfo/RBACO_0000032">
    <rdfs:subClassOf rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000030"/>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="n98c48ae2dbe045be825f75f4e24d694fb91">
        <owl:onProperty rdf:resource="https://www.commoncoreontologies.org/ont00001921"/>
        <owl:someValuesFrom rdf:resource="https://www.commoncoreontologies.org/ont00000958"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <dc11:identifier>032-RBACO</dc11:identifier>
    <rdfs:label xml:lang="en">policy retiring act</rdfs:label>
    <skos:definition xml:lang="en">A policy administration act whose input is an information content entity that ceases to be in force with it.</skos:definition>
    <skos:example xml:lang="en">DeleteRole (NIST p.251), RevokePermission (p.252), DeleteInheritance (p.244); revoking an RT statement.</skos:example>
    <skos:scopeNote xml:lang="en">An information content entity is in force at t when its issuing act starts at or before t and no retiring act with it as input starts at or before t.</skos:scopeNote>
  </owl:Class>
  <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#editorialNote"/>
  <owl:AllDisjointClasses rdf:nodeID="n98c48ae2dbe045be825f75f4e24d694fb99">
    <owl:members rdf:parseType="Collection">
      <rdf:Description rdf:about="https://w3id.org/rbaco/bfo/RBACO_0000035"/>
      <rdf:Description rdf:about="https://w3id.org/rbaco/bfo/RBACO_0000036"/>
      <rdf:Description rdf:about="https://w3id.org/rbaco/bfo/RBACO_0000037"/>
      <rdf:Description rdf:about="https://w3id.org/rbaco/bfo/RBACO_0000038"/>
    </owl:members>
  </owl:AllDisjointClasses>
  <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#scopeNote"/>
  <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/identifier"/>
  <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/source"/>
  <owl:ObjectProperty rdf:about="https://w3id.org/rbaco/bfo/RBACO_0000112">
    <rdfs:subPropertyOf rdf:resource="https://www.commoncoreontologies.org/ont00001982"/>
    <rdfs:domain rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000021"/>
    <rdfs:range rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000024"/>
    <dc11:identifier>112-RBACO</dc11:identifier>
    <rdfs:label xml:lang="en">decides on</rdfs:label>
    <skos:definition xml:lang="en">Relates an access decision to the access request it answers.</skos:definition>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://w3id.org/rbaco/bfo/RBACO_0000044">
    <owl:equivalentClass>
      <owl:Class rdf:nodeID="n98c48ae2dbe045be825f75f4e24d694fb50">
        <owl:intersectionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="https://w3id.org/rbaco/bfo/RBACO_0000012"/>
          <owl:Restriction rdf:nodeID="n98c48ae2dbe045be825f75f4e24d694fb51">
            <owl:onProperty>
              <owl:ObjectProperty rdf:about="https://w3id.org/rbaco/bfo/RBACO_0000135">
                <rdfs:subPropertyOf rdf:resource="https://www.commoncoreontologies.org/ont00001808"/>
                <rdfs:domain rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000012"/>
                <rdfs:range rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000040"/>
                <dc11:identifier>135-RBACO</dc11:identifier>
                <rdfs:label xml:lang="en">has constrained task specification</rdfs:label>
                <skos:definition xml:lang="en">Relates a separation of duty constraint to a task specification in its task set.</skos:definition>
              </owl:ObjectProperty>
            </owl:onProperty>
            <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</owl:minQualifiedCardinality>
            <owl:onClass rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000040"/>
          </owl:Restriction>
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
    <dc11:identifier>044-RBACO</dc11:identifier>
    <rdfs:label xml:lang="en">task separation of duty constraint</rdfs:label>
    <skos:definition xml:lang="en">A separation of duty constraint whose set holds at least two task specifications.</skos:definition>
    <skos:scopeNote xml:lang="en">Botha and Eloff 2001, Table 1 row 4 (static, p.673) and Table 2 row 4 (dynamic, p.676). Static: no agent authorized for the required role definitions of n of them. For two specifications that require distinct role definitions, with no conflicting agent designations ([rbaco-u1], [rbaco-u3]), this is equivalent to a static role constraint over those definitions in force at the same time (Prover9 lemmas p9a and p9b in docs/fol-results.md). Dynamic: no agent the principal of instances of n of them within one instance; repeated instances of one specification count once.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/rbaco/bfo/RBACO_0000013">
    <rdfs:subClassOf rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000012"/>
    <owl:disjointWith rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000014"/>
    <dc11:identifier>013-RBACO</dc11:identifier>
    <rdfs:label xml:lang="en">static separation of duty constraint</rdfs:label>
    <skos:definition xml:lang="en">A separation of duty constraint that prohibits the role assignments and policy issuing acts by which one agent would come to be authorized, at one time, for n or more members of the set: role definitions, permissions through the role definitions they are assigned to, or task specifications through their required role definitions.</skos:definition>
    <skos:scopeNote xml:lang="en">NIST Def. 3b (p.240): authorization counts inherited roles, so holding a senior role counts as holding each of its juniors. Agents a static conflicting agent designation names count as one. NIST enforces static constraints during user assignment and while role hierarchies are created (p.246); RBACO reports a breach at the role assignment, or at the issuing of the inheritance statement, constraint or static designation, that completes it.</skos:scopeNote>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://w3id.org/rbaco/bfo/RBACO_0000123">
    <rdfs:subPropertyOf>
      <owl:ObjectProperty rdf:about="https://w3id.org/rbaco/bfo/RBACO_0000117">
        <rdfs:subPropertyOf rdf:resource="https://www.commoncoreontologies.org/ont00001808"/>
        <rdfs:range rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000001"/>
        <dc11:identifier>117-RBACO</dc11:identifier>
        <rdfs:label xml:lang="en">has body role</rdfs:label>
        <skos:definition xml:lang="en">Relates a membership statement to a role definition whose members it adds to the head role.</skos:definition>
      </owl:ObjectProperty>
    </rdfs:subPropertyOf>
    <rdfs:domain rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000037"/>
    <rdfs:range rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000033"/>
    <dc11:identifier>123-RBACO</dc11:identifier>
    <rdfs:label xml:lang="en">has linking base role</rdfs:label>
    <skos:definition xml:lang="en">Relates an RT linking inclusion statement A.r &lt;- B.r1.r2 to B.r1, whose members' r2 roles are included.</skos:definition>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/rbaco/bfo/RBACO_0000141">
    <rdfs:subPropertyOf rdf:resource="https://www.commoncoreontologies.org/ont00001808"/>
    <rdfs:domain rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000048"/>
    <rdfs:range rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000040"/>
    <dc11:identifier>141-RBACO</dc11:identifier>
    <rdfs:label xml:lang="en">is work item for</rdfs:label>
    <skos:definition xml:lang="en">Relates a work item to the task specification whose instance it prescribes.</skos:definition>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/rbaco/bfo/RBACO_0000148">
    <rdfs:subPropertyOf rdf:resource="https://www.commoncoreontologies.org/ont00001808"/>
    <rdfs:domain rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000050"/>
    <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/IAO_0000104"/>
    <dc11:identifier>148-RBACO</dc11:identifier>
    <rdfs:label xml:lang="en">requires task binding for</rdfs:label>
    <skos:definition xml:lang="en">Relates a task-bound operation requirement to an operation that may be requested only within a task instance whose specification requires it.</skos:definition>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://w3id.org/rbaco/bfo/RBACO_0000039">
    <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000965"/>
    <dc11:identifier>039-RBACO</dc11:identifier>
    <rdfs:label xml:lang="en">security analysis specification</rdfs:label>
    <skos:definition xml:lang="en">A Prescriptive Information Content Entity that prescribes a security analysis of an RT policy, naming the RT roles the analysis treats as growth-restricted and as shrink-restricted.</skos:definition>
    <skos:scopeNote xml:lang="en">The four security properties of ROWLBAC §4.2 (restriction, access, availability, safety) are queries evaluated against one specification (queries/rt-security-properties.rq). Model checking, which ROWLBAC says the last two need, is out of scope.</skos:scopeNote>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://w3id.org/rbaco/bfo/RBACO_0000118">
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000117"/>
    <rdfs:domain rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000017"/>
    <rdfs:range rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000001"/>
    <dc11:identifier>118-RBACO</dc11:identifier>
    <rdfs:label xml:lang="en">has senior role definition</rdfs:label>
    <skos:definition xml:lang="en">Relates a role inheritance statement to its senior role definition, which acquires the junior's regulations.</skos:definition>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://w3id.org/rbaco/bfo/RBACO_0000006">
    <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00001324"/>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="n98c48ae2dbe045be825f75f4e24d694fb27">
        <owl:onProperty rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000101"/>
        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
        <owl:onClass rdf:resource="http://purl.obolibrary.org/obo/IAO_0000104"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="n98c48ae2dbe045be825f75f4e24d694fb28">
        <owl:onProperty rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000102"/>
        <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="n98c48ae2dbe045be825f75f4e24d694fb29">
        <owl:onProperty rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000103"/>
        <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="n98c48ae2dbe045be825f75f4e24d694fb30">
        <owl:onProperty rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000105"/>
        <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="n98c48ae2dbe045be825f75f4e24d694fb31">
        <owl:onProperty rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000105"/>
        <owl:someValuesFrom rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000001"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Class rdf:nodeID="n98c48ae2dbe045be825f75f4e24d694fb32">
        <owl:complementOf>
          <owl:Class rdf:nodeID="n98c48ae2dbe045be825f75f4e24d694fb33">
            <owl:intersectionOf rdf:parseType="Collection">
              <owl:Restriction rdf:nodeID="n98c48ae2dbe045be825f75f4e24d694fb34">
                <owl:onProperty>
                  <owl:ObjectProperty rdf:about="https://w3id.org/rbaco/bfo/RBACO_0000102">
                    <rdfs:subPropertyOf rdf:resource="https://www.commoncoreontologies.org/ont00001808"/>
                    <rdfs:domain rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000006"/>
                    <dc11:identifier>102-RBACO</dc11:identifier>
                    <rdfs:label xml:lang="en">has access object</rdfs:label>
                    <skos:definition xml:lang="en">Relates an access regulation to the one entity on which its operation is permitted or prohibited.</skos:definition>
                    <skos:scopeNote xml:lang="en">Optional: ROWLBAC allows actions with no object, such as login (§3.2.1). A regulation may name an object description instead (rbaco:RBACO_0000103).</skos:scopeNote>
                  </owl:ObjectProperty>
                </owl:onProperty>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
              </owl:Restriction>
              <owl:Restriction rdf:nodeID="n98c48ae2dbe045be825f75f4e24d694fb35">
                <owl:onProperty>
                  <owl:ObjectProperty rdf:about="https://w3id.org/rbaco/bfo/RBACO_0000103">
                    <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000178"/>
                    <rdfs:domain rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000006"/>
                    <rdfs:range rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000009"/>
                    <dc11:identifier>103-RBACO</dc11:identifier>
                    <rdfs:label xml:lang="en">has object description</rdfs:label>
                    <skos:definition xml:lang="en">Relates an access regulation to the description, part of it, that states which objects the regulation covers.</skos:definition>
                    <skos:scopeNote xml:lang="en">Parthood between information content entities follows CCO's Plan, which has an Objective as continuant part (AgentOntology.ttl ont00000974).</skos:scopeNote>
                  </owl:ObjectProperty>
                </owl:onProperty>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
              </owl:Restriction>
            </owl:intersectionOf>
          </owl:Class>
        </owl:complementOf>
      </owl:Class>
    </rdfs:subClassOf>
    <dc11:identifier>006-RBACO</dc11:identifier>
    <rdfs:label xml:lang="en">access regulation</rdfs:label>
    <skos:definition xml:lang="en">A Process Regulation about exactly one operation and at most one object or object description, assigned to one role definition.</skos:definition>
    <skos:scopeNote xml:lang="en">Placed under Process Regulation rather than Action Permission or Process Prohibition: those CCO classes are defined by permits some process and prohibits some process (AgentOntology.ttl ont00000751, ont00000553), so asserting them of an unused regulation would entail that a regulated process exists. A regulation is classified into them once a permits or prohibits link to an actual process is asserted.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/rbaco/bfo/RBACO_0000034">
    <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000965"/>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="n98c48ae2dbe045be825f75f4e24d694fb94">
        <owl:onProperty rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000116"/>
        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
        <owl:onClass rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000033"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <dc11:identifier>034-RBACO</dc11:identifier>
    <rdfs:label xml:lang="en">RT statement</rdfs:label>
    <skos:definition xml:lang="en">A Prescriptive Information Content Entity, issued by the issuer of its head role, that states who is a member of that RT role.</skos:definition>
    <skos:scopeNote xml:lang="en">That the issuing act's agent is the head role's issuer is checked by queries/check-rt-issuers.rq.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/rbaco/bfo/RBACO_0000047">
    <rdfs:subClassOf rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000045"/>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="n98c48ae2dbe045be825f75f4e24d694fb58">
        <owl:onProperty rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000115"/>
        <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
        <owl:onClass rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000005"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <dc11:identifier>047-RBACO</dc11:identifier>
    <rdfs:label xml:lang="en">dynamic conflicting agent designation</rdfs:label>
    <skos:definition xml:lang="en">A conflicting agent designation applying to dynamic separation of duty constraints, within the instances of the plan it applies within, or of every plan if none.</skos:definition>
    <skos:scopeNote xml:lang="en">Botha and Eloff: Tom and Dick "would thus be considered as one user in the context of each process instance" (2001, p.676).</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/rbaco/bfo/RBACO_0000017">
    <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000965"/>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="n98c48ae2dbe045be825f75f4e24d694fb64">
        <owl:onProperty rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000118"/>
        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
        <owl:onClass rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000001"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="n98c48ae2dbe045be825f75f4e24d694fb65">
        <owl:onProperty rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000119"/>
        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
        <owl:onClass rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000001"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <dc11:identifier>017-RBACO</dc11:identifier>
    <rdfs:label xml:lang="en">role inheritance statement</rdfs:label>
    <skos:definition xml:lang="en">A Prescriptive Information Content Entity stating that one role definition is immediately senior to another: the senior acquires the junior's regulations, and the junior's authorized members include the senior's.</skos:definition>
    <skos:scopeNote xml:lang="en">One edge of the NIST role hierarchy (Def. 2a, p.235), output of an AddInheritance act and input of the DeleteInheritance act that retires it (NIST p.244). Reified so that a hierarchy edit is a dated act.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/rbaco/bfo/RBACO_0000040">
    <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000974"/>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="n98c48ae2dbe045be825f75f4e24d694fb20">
        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000176"/>
        <owl:someValuesFrom rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000005"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="n98c48ae2dbe045be825f75f4e24d694fb21">
        <owl:onProperty rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000132"/>
        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
        <owl:onClass rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000001"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <dc11:identifier>040-RBACO</dc11:identifier>
    <rdfs:label xml:lang="en">task specification</rdfs:label>
    <skos:definition xml:lang="en">A Plan that is a continuant part of a business process plan, prescribes one step of its instances, and requires exactly one role definition of whoever performs that step.</skos:definition>
    <skos:scopeNote xml:lang="en">Botha and Eloff 2001: a process definition is a set of tasks linked as a directed graph with predicates on the arcs, and a human task is the responsibility of a single user (pp.667-668). The arcs and their predicates are not modeled. Automated tasks also require a role, held by the workflow automation agent, so that its permissions are assigned and limited like anyone else's.</skos:scopeNote>
    <skos:editorialNote xml:lang="en">A missing required role leaves the ontology consistent under OWL's open world; queries/check-task-specs.rq reports it. Two required roles declared distinct make it inconsistent.</skos:editorialNote>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://w3id.org/rbaco/bfo/RBACO_0000108">
    <rdfs:domain rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000024"/>
    <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/IAO_0000104"/>
    <dc11:identifier>108-RBACO</dc11:identifier>
    <rdfs:label xml:lang="en">requests operation</rdfs:label>
    <skos:definition xml:lang="en">Relates an access request to the operation the requester asks to perform.</skos:definition>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://w3id.org/rbaco/bfo/RBACO_0000022">
    <rdfs:subClassOf rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000021"/>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="n98c48ae2dbe045be825f75f4e24d694fb76">
        <owl:onProperty rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000113"/>
        <owl:someValuesFrom rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000007"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <owl:disjointWith rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000023"/>
    <dc11:identifier>022-RBACO</dc11:identifier>
    <rdfs:label xml:lang="en">access grant</rdfs:label>
    <skos:definition xml:lang="en">An access decision that grants its request, citing a permission that covers it.</skos:definition>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://w3id.org/rbaco/bfo/RBACO_0000132">
    <rdfs:subPropertyOf rdf:resource="https://www.commoncoreontologies.org/ont00001808"/>
    <rdfs:domain rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000040"/>
    <rdfs:range rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000001"/>
    <dc11:identifier>132-RBACO</dc11:identifier>
    <rdfs:label xml:lang="en">requires role definition</rdfs:label>
    <skos:definition xml:lang="en">Relates a task specification to the one role definition whose holders, or holders of a senior one, may perform its instances.</skos:definition>
    <skos:scopeNote xml:lang="en">Botha and Eloff 2001: each task of the purchase process names one role (Figure 2, p.669), and a WSession activates the role associated with the task, the most junior role the task requires (p.674). Access in a task instance is granted through this role only (clif/rbaco-bfo-access.cl [rbaco-a4]).</skos:scopeNote>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/rbaco/bfo/RBACO_0000202">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000033"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <dc11:identifier>202-RBACO</dc11:identifier>
    <rdfs:label xml:lang="en">has RT role name</rdfs:label>
    <skos:definition xml:lang="en">The role name r of an RT role A.r, which RT linking inclusion matches across issuers.</skos:definition>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://w3id.org/rbaco/bfo/RBACO_0000001">
    <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000965"/>
    <dc11:identifier>001-RBACO</dc11:identifier>
    <rdfs:label xml:lang="en">role definition</rdfs:label>
    <skos:definition xml:lang="en">A Prescriptive Information Content Entity held in an access-control system that names a job function or status, and that the roles of the agents assigned to it concretize.</skos:definition>
    <skos:example xml:lang="en">The Submitter role definition in a code review system; the US Citizen role definition in the ROWLBAC scenario.</skos:example>
    <skos:scopeNote xml:lang="en">The NIST role as an administrative object: AddRole creates a role to which, initially, no user or permission is assigned (Ferraiolo et al. 2001, p.251). A BFO role particular exists only because there is some single bearer (BFO 2020 elucidation of role), so a role with no members can only be information. Whenever the definition exists it is concretized by something, as every generically dependent continuant is (BFO 2020 CLIF, generic-dependence [ibk-1] with universal-declaration [iup-1]): by a pattern its database record bears, since only a specifically dependent continuant or a process concretizes ([rog-1]). The record is the carrier (is carrier of, BFO_0000101).</skos:scopeNote>
    <skos:editorialNote xml:lang="en">Interpretation, not asserted by any source: that a person's role can concretize an access-control role definition, and that the definition is prescriptive in CCO's sense. CCO's Planned Act already relies on roles concretizing Prescriptive ICEs (EventOntology.ttl ont00000228).</skos:editorialNote>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://w3id.org/rbaco/bfo/RBACO_0000134">
    <rdfs:subPropertyOf rdf:resource="https://www.commoncoreontologies.org/ont00001808"/>
    <rdfs:domain rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000012"/>
    <rdfs:range rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000007"/>
    <dc11:identifier>134-RBACO</dc11:identifier>
    <rdfs:label xml:lang="en">has constrained permission</rdfs:label>
    <skos:definition xml:lang="en">Relates a separation of duty constraint to an access permission in its permission set.</skos:definition>
    <skos:scopeNote xml:lang="en">Botha and Eloff 2001: conflicting permissions are those that "together, provide more ability than required to a single user" (p.671).</skos:scopeNote>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/rbaco/bfo/RBACO_0000142">
    <rdfs:subPropertyOf rdf:resource="https://www.commoncoreontologies.org/ont00001808"/>
    <rdfs:domain rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000048"/>
    <rdfs:range rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000004"/>
    <dc11:identifier>142-RBACO</dc11:identifier>
    <rdfs:label xml:lang="en">is work item in</rdfs:label>
    <skos:definition xml:lang="en">Relates a work item to the business process instance its task instance would be part of.</skos:definition>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://w3id.org/rbaco/bfo/RBACO_0000003">
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000023"/>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="n98c48ae2dbe045be825f75f4e24d694fb16">
        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000059"/>
        <owl:someValuesFrom rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000001"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="n98c48ae2dbe045be825f75f4e24d694fb17">
        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000195"/>
        <owl:someValuesFrom rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000002"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="n98c48ae2dbe045be825f75f4e24d694fb18">
        <owl:onProperty rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000106"/>
        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
        <owl:onClass rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000004"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <dc11:identifier>003-RBACO</dc11:identifier>
    <rdfs:label xml:lang="en">active role</rdfs:label>
    <skos:definition xml:lang="en">A Role that concretizes some role definition, specifically depends on an assigned role of the same bearer concretizing that definition or a senior one, and is activated in exactly one business process instance.</skos:definition>
    <skos:scopeNote xml:lang="en">NIST session_roles (Def. 1, p.234), with the session read as a business process instance. Output of a role activation; input of the role deactivation that ends it, which also happens when the instance ends. An active role can exist unrealized, which is the state NIST's CheckAccess reads before the act it authorizes (p.254); only a process realizes (BFO 2020 CLIF, specific-dependency [oot-1]).</skos:scopeNote>
    <skos:editorialNote xml:lang="en">Interpretation, not asserted by any source: that activation produces a second role rather than realizing the assigned one. The same-bearer and same-or-senior-definition conditions are checked by queries/check-active-roles.rq, since OWL cannot relate the two concretized definitions.</skos:editorialNote>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/rbaco/bfo/RBACO_0000041">
    <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000228"/>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="n98c48ae2dbe045be825f75f4e24d694fb22">
        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000132"/>
        <owl:someValuesFrom rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000004"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="n98c48ae2dbe045be825f75f4e24d694fb23">
        <owl:onProperty rdf:resource="https://www.commoncoreontologies.org/ont00001920"/>
        <owl:someValuesFrom rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000040"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="n98c48ae2dbe045be825f75f4e24d694fb24">
        <owl:onProperty rdf:resource="https://www.commoncoreontologies.org/ont00001833"/>
        <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
        <owl:onClass rdf:resource="https://www.commoncoreontologies.org/ont00001017"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <dc11:identifier>041-RBACO</dc11:identifier>
    <rdfs:label xml:lang="en">task instance</rdfs:label>
    <skos:definition xml:lang="en">A Planned Act that is an occurrent part of a business process, is prescribed by a task specification, and has as agent the one agent who accepted it.</skos:definition>
    <skos:scopeNote xml:lang="en">Botha and Eloff 2001: once a user selects an item from the worklist, the user takes responsibility for the task instance and must complete it, and is recorded as an attribute of it (p.674). Acceptance is therefore the agent relation (CCO has agent, ont00001833), not an act of its own.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/rbaco/bfo/RBACO_0000043">
    <owl:equivalentClass>
      <owl:Class rdf:nodeID="n98c48ae2dbe045be825f75f4e24d694fb46">
        <owl:intersectionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="https://w3id.org/rbaco/bfo/RBACO_0000012"/>
          <owl:Restriction rdf:nodeID="n98c48ae2dbe045be825f75f4e24d694fb47">
            <owl:onProperty rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000134"/>
            <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</owl:minQualifiedCardinality>
            <owl:onClass rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000007"/>
          </owl:Restriction>
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
    <dc11:identifier>043-RBACO</dc11:identifier>
    <rdfs:label xml:lang="en">permission separation of duty constraint</rdfs:label>
    <skos:definition xml:lang="en">A separation of duty constraint whose set holds at least two access permissions.</skos:definition>
    <skos:scopeNote xml:lang="en">Botha and Eloff 2001, Table 1 row 2 (static, p.673) and Table 2 row 2 (dynamic, p.676). Static: no agent authorized, through the role definitions the permissions are assigned to, for n of them. Dynamic: no agent granted, within one instance, requests citing n of them; a decision record stands in for the exercise, since RBACO records requests and decisions, not performed acts. Members are compared by content (operation, named object and object description; [rbaco-s17]): a permission with a member's content, assigned to another role definition, counts as that member, and members of one content count once.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/rbaco/bfo/RBACO_0000049">
    <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00001324"/>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="n98c48ae2dbe045be825f75f4e24d694fb59">
        <owl:onProperty rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000145"/>
        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
        <owl:onClass rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000040"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="n98c48ae2dbe045be825f75f4e24d694fb60">
        <owl:onProperty rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000115"/>
        <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
        <owl:onClass rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000005"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <dc11:identifier>049-RBACO</dc11:identifier>
    <rdfs:label xml:lang="en">human performer requirement</rdfs:label>
    <skos:definition xml:lang="en">A Process Regulation requiring that the agent of every instance of a task specification be a person.</skos:definition>
    <skos:scopeNote xml:lang="en">Not in Botha and Eloff, who mention automated activities only as something administrators may intervene in manually (2001, p.668) and as what a module of their prototype executes (p.679). Separation of duty counts distinct agents, so a workflow automation agent approving what a person created satisfies a task constraint; this requirement closes that gap at activation, and requires prior (RBACO_0000144) at completion. It reads the agent of the task instance, not its principal.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/rbaco/bfo/RBACO_0000024">
    <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000769"/>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="n98c48ae2dbe045be825f75f4e24d694fb77">
        <owl:onProperty rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000107"/>
        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
        <owl:onClass rdf:resource="https://www.commoncoreontologies.org/ont00001017"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="n98c48ae2dbe045be825f75f4e24d694fb78">
        <owl:onProperty rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000108"/>
        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
        <owl:onClass rdf:resource="http://purl.obolibrary.org/obo/IAO_0000104"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="n98c48ae2dbe045be825f75f4e24d694fb79">
        <owl:onProperty rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000109"/>
        <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="n98c48ae2dbe045be825f75f4e24d694fb80">
        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000132"/>
        <owl:someValuesFrom rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000004"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <dc11:identifier>024-RBACO</dc11:identifier>
    <rdfs:label xml:lang="en">access request</rdfs:label>
    <skos:definition xml:lang="en">An Act of Requesting, part of a business process instance, in which one agent asks to perform one operation on at most one object.</skos:definition>
    <skos:scopeNote xml:lang="en">ROWLBAC's Action with exactly one subject and at most one object (§3.2.1); NIST's CheckAccess(session, operation, object) (p.254). The act that performs the operation, if any follows, is separate.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/rbaco/bfo/RBACO_0000037">
    <rdfs:subClassOf rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000034"/>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="n98c48ae2dbe045be825f75f4e24d694fb96">
        <owl:onProperty rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000123"/>
        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
        <owl:onClass rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000033"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="n98c48ae2dbe045be825f75f4e24d694fb97">
        <owl:onProperty rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000203"/>
        <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <dc11:identifier>037-RBACO</dc11:identifier>
    <rdfs:label xml:lang="en">RT linking inclusion statement</rdfs:label>
    <skos:definition xml:lang="en">An RT statement A.r &lt;- B.r1.r2 making every member of C.r2 a member of A.r, for every member C of B.r1.</skos:definition>
    <skos:scopeNote xml:lang="en">RT type 3, which ROWLBAC calls problematic in OWL (Fig. 3). Decided by queries/derive-rt-membership.rq, since the role C.r2 varies with C and no OWL 2 property chain ends at it.</skos:scopeNote>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://w3id.org/rbaco/bfo/RBACO_0000122">
    <rdfs:subPropertyOf rdf:resource="https://www.commoncoreontologies.org/ont00001808"/>
    <rdfs:domain rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000035"/>
    <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/BFO_0000040"/>
    <dc11:identifier>122-RBACO</dc11:identifier>
    <rdfs:label xml:lang="en">names member</rdfs:label>
    <skos:definition xml:lang="en">Relates an RT simple member statement to the principal it makes a member of its head role.</skos:definition>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://w3id.org/rbaco/bfo/RBACO_0000050">
    <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00001324"/>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="n98c48ae2dbe045be825f75f4e24d694fb61">
        <owl:onProperty rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000148"/>
        <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
        <owl:onClass rdf:resource="http://purl.obolibrary.org/obo/IAO_0000104"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="n98c48ae2dbe045be825f75f4e24d694fb62">
        <owl:onProperty rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000115"/>
        <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
        <owl:onClass rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000005"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <dc11:identifier>050-RBACO</dc11:identifier>
    <rdfs:label xml:lang="en">task-bound operation requirement</rdfs:label>
    <skos:definition xml:lang="en">A Process Regulation requiring that every request for an operation it names, made within an instance of the business process plan it applies within, be part of a task instance whose specification requires that operation.</skos:definition>
    <skos:scopeNote xml:lang="en">Not in Botha and Eloff, who need no such rule: the workflow enactment environment establishes every WSession (2001, p.673), and a WSession exists only while its user is busy with a particular task (p.674). RBACO lets a role be activated without a task instance, which non-workflow datasets need, but then a task constraint sees nothing: an activation for the Assistant Purchase Manager role outside any task instance lets one agent both create a requisition and approve the order (data/purchase.ttl, po-7b). This requirement closes that gap for the operations it names and leaves every other operation open ([rbaco-g3]). Being part of a task instance alone is not enough: the specification must require the operation (RBACO_0000133), so a task cannot carry an operation it does not need. queries/check-sod-hierarchy.rq warns when a dynamic set's operations are only partly named.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/rbaco/bfo/RBACO_0000042">
    <owl:equivalentClass>
      <owl:Class rdf:nodeID="n98c48ae2dbe045be825f75f4e24d694fb42">
        <owl:intersectionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="https://w3id.org/rbaco/bfo/RBACO_0000012"/>
          <owl:Restriction rdf:nodeID="n98c48ae2dbe045be825f75f4e24d694fb43">
            <owl:onProperty>
              <owl:ObjectProperty rdf:about="https://w3id.org/rbaco/bfo/RBACO_0000114">
                <rdfs:subPropertyOf rdf:resource="https://www.commoncoreontologies.org/ont00001808"/>
                <rdfs:domain rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000012"/>
                <rdfs:range rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000001"/>
                <dc11:identifier>114-RBACO</dc11:identifier>
                <rdfs:label xml:lang="en">has constrained role definition</rdfs:label>
                <skos:definition xml:lang="en">Relates a separation of duty constraint to a role definition in its role set.</skos:definition>
              </owl:ObjectProperty>
            </owl:onProperty>
            <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</owl:minQualifiedCardinality>
            <owl:onClass rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000001"/>
          </owl:Restriction>
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
    <dc11:identifier>042-RBACO</dc11:identifier>
    <rdfs:label xml:lang="en">role separation of duty constraint</rdfs:label>
    <skos:definition xml:lang="en">A separation of duty constraint whose set holds at least two role definitions.</skos:definition>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://w3id.org/rbaco/bfo/RBACO_0000109">
    <rdfs:domain rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000024"/>
    <dc11:identifier>109-RBACO</dc11:identifier>
    <rdfs:label xml:lang="en">requests access to</rdfs:label>
    <skos:definition xml:lang="en">Relates an access request to the object on which the requester asks to perform the operation.</skos:definition>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/rbaco/bfo/RBACO_0000116">
    <rdfs:subPropertyOf rdf:resource="https://www.commoncoreontologies.org/ont00001942"/>
    <rdfs:range rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000001"/>
    <dc11:identifier>116-RBACO</dc11:identifier>
    <rdfs:label xml:lang="en">has head role</rdfs:label>
    <skos:definition xml:lang="en">Relates a membership statement to the role definition whose membership it determines.</skos:definition>
    <skos:scopeNote xml:lang="en">In RT, the role on the left of the arrow. In a role inheritance statement, the junior role, whose authorized members include the senior's.</skos:scopeNote>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://w3id.org/rbaco/bfo/RBACO_0000004">
    <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000228"/>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="n98c48ae2dbe045be825f75f4e24d694fb19">
        <owl:onProperty rdf:resource="https://www.commoncoreontologies.org/ont00001920"/>
        <owl:someValuesFrom rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000005"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <dc11:identifier>004-RBACO</dc11:identifier>
    <rdfs:label xml:lang="en">business process</rdfs:label>
    <skos:definition xml:lang="en">A Planned Act prescribed by a business process plan, in which participating agents activate roles and request operations on objects.</skos:definition>
    <skos:example xml:lang="en">Hiring an employee; ordering a product; a review of a submitted code change.</skos:example>
    <skos:scopeNote xml:lang="en">Plays the part of the NIST session (Def. 1, p.234). Unlike a NIST session, an instance is shared by all its participants, so access is decided per requester and instance.</skos:scopeNote>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://w3id.org/rbaco/bfo/RBACO_0000101">
    <rdfs:subPropertyOf rdf:resource="https://www.commoncoreontologies.org/ont00001808"/>
    <rdfs:domain rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000006"/>
    <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/IAO_0000104"/>
    <dc11:identifier>101-RBACO</dc11:identifier>
    <rdfs:label xml:lang="en">has operation</rdfs:label>
    <skos:definition xml:lang="en">Relates an access regulation to the plan specification whose execution it permits or prohibits.</skos:definition>
    <skos:scopeNote xml:lang="en">NIST defines an operation as an executable image of a program (Ferraiolo et al. 2001, p.233). IAO files software under plan specification (IAO_0000010). For acts that are not program executions, such as voting, the operation is a procedure stated as information.</skos:scopeNote>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/rbaco/bfo/RBACO_0000107">
    <rdfs:subPropertyOf rdf:resource="https://www.commoncoreontologies.org/ont00001833"/>
    <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
    <rdfs:range rdf:resource="https://www.commoncoreontologies.org/ont00001017"/>
    <dc11:identifier>107-RBACO</dc11:identifier>
    <rdfs:label xml:lang="en">has requester</rdfs:label>
    <skos:definition xml:lang="en">Relates a request act to the agent who makes the request.</skos:definition>
    <skos:scopeNote xml:lang="en">ROWLBAC's subject (§3.2.1). NIST's CheckAccess takes a session (p.254); a session shared by several participants needs the requester named.</skos:scopeNote>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://w3id.org/rbaco/bfo/RBACO_0000005">
    <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000974"/>
    <dc11:identifier>005-RBACO</dc11:identifier>
    <rdfs:label xml:lang="en">business process plan</rdfs:label>
    <skos:definition xml:lang="en">A Plan that prescribes a kind of business process, and that dynamic separation of duty constraints can be scoped to.</skos:definition>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/rbaco/bfo/RBACO_0000048">
    <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000965"/>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="n98c48ae2dbe045be825f75f4e24d694fb25">
        <owl:onProperty rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000141"/>
        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
        <owl:onClass rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000040"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="n98c48ae2dbe045be825f75f4e24d694fb26">
        <owl:onProperty rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000142"/>
        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
        <owl:onClass rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000004"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <dc11:identifier>048-RBACO</dc11:identifier>
    <rdfs:label xml:lang="en">work item</rdfs:label>
    <skos:definition xml:lang="en">A Prescriptive Information Content Entity, issued when a task becomes ready, that prescribes an instance of a task specification within a business process instance.</skos:definition>
    <skos:scopeNote xml:lang="en">Botha and Eloff's worklists hold work items (2001, p.680). A task nobody has accepted has no agent and has not begun, so it is not yet a task instance; the task instance that begins on acceptance is prescribed by the work item as well as by its task specification. A work item with no such task instance is unfulfilled (queries/cq-worklist.rq).</skos:scopeNote>
    <skos:editorialNote xml:lang="en">Interpretation, not asserted by the source: that a work item is information rather than an early stage of the task.</skos:editorialNote>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/rbaco/bfo/RBACO_0000023">
    <rdfs:subClassOf rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000021"/>
    <dc11:identifier>023-RBACO</dc11:identifier>
    <rdfs:label xml:lang="en">access denial</rdfs:label>
    <skos:definition xml:lang="en">An access decision that denies its request, because no permission covers it or a prohibition covers it.</skos:definition>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://w3id.org/rbaco/bfo/RBACO_0000115">
    <rdfs:subPropertyOf rdf:resource="https://www.commoncoreontologies.org/ont00001808"/>
    <rdfs:domain>
      <owl:Class rdf:nodeID="n98c48ae2dbe045be825f75f4e24d694fb5">
        <owl:unionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="https://w3id.org/rbaco/bfo/RBACO_0000014"/>
          <rdf:Description rdf:about="https://w3id.org/rbaco/bfo/RBACO_0000047"/>
          <rdf:Description rdf:about="https://w3id.org/rbaco/bfo/RBACO_0000049"/>
          <rdf:Description rdf:about="https://w3id.org/rbaco/bfo/RBACO_0000050"/>
        </owl:unionOf>
      </owl:Class>
    </rdfs:domain>
    <rdfs:range rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000005"/>
    <dc11:identifier>115-RBACO</dc11:identifier>
    <rdfs:label xml:lang="en">applies within</rdfs:label>
    <skos:definition xml:lang="en">Relates a dynamic separation of duty constraint, a dynamic conflicting agent designation, a human performer requirement or a task-bound operation requirement to the business process plan whose instances it governs.</skos:definition>
    <skos:scopeNote xml:lang="en">A constraint, designation or requirement with no value applies in every instance. Botha and Eloff 2001 scope conflicting tasks to one process definition (Figure 8, p.678). NIST: the set name indicates the transaction or business process in which common user membership must be restricted (Ferraiolo et al. 2001, p.245), and creating a DSD set has identical semantics (p.246).</skos:scopeNote>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/rbaco/bfo/RBACO_0000127">
    <rdfs:subPropertyOf rdf:resource="https://www.commoncoreontologies.org/ont00001982"/>
    <rdfs:domain rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000020"/>
    <rdfs:range rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000004"/>
    <dc11:identifier>127-RBACO</dc11:identifier>
    <rdfs:label xml:lang="en">describes conflict instance</rdfs:label>
    <skos:definition xml:lang="en">Relates a dynamic separation of duty conflict report to the business process instance in which the breach would occur.</skos:definition>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://w3id.org/rbaco/bfo/RBACO_0000030">
    <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00001374"/>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="n98c48ae2dbe045be825f75f4e24d694fb89">
        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000055"/>
        <owl:someValuesFrom rdf:resource="https://www.commoncoreontologies.org/ont00000187"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <dc11:identifier>030-RBACO</dc11:identifier>
    <rdfs:label xml:lang="en">policy administration act</rdfs:label>
    <skos:definition xml:lang="en">An Act of Declarative Communication, realizing an Authority Role of its agent, that changes an access-control policy.</skos:definition>
    <skos:scopeNote xml:lang="en">The NIST administrative functions (pp.242-246). CCO's Process Regulation is the output of a process which realizes some Authority Role (AgentOntology.ttl ont00001324).</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/rbaco/bfo/RBACO_0000009">
    <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000853"/>
    <dc11:identifier>009-RBACO</dc11:identifier>
    <rdfs:label xml:lang="en">object description</rdfs:label>
    <skos:definition xml:lang="en">A Descriptive Information Content Entity, part of an access regulation, that states criteria an object must meet for the regulation to cover it.</skos:definition>
    <skos:scopeNote xml:lang="en">Criteria are carried by the annotations has object type criterion and has object location type criterion, read by queries/decide-access.rq; where they are OWL-expressible, has criteria class names an equivalent defined class.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/rbaco/bfo/RBACO_0000012">
    <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00001324"/>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="n98c48ae2dbe045be825f75f4e24d694fb38">
        <owl:onProperty rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000201"/>
        <owl:someValuesFrom>
          <rdfs:Datatype rdf:nodeID="n98c48ae2dbe045be825f75f4e24d694fb39">
            <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
            <owl:withRestrictions rdf:parseType="Collection">
              <rdf:Description rdf:nodeID="n98c48ae2dbe045be825f75f4e24d694fb40">
                <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</xsd:minInclusive>
              </rdf:Description>
            </owl:withRestrictions>
          </rdfs:Datatype>
        </owl:someValuesFrom>
      </owl:Restriction>
    </rdfs:subClassOf>
    <dc11:identifier>012-RBACO</dc11:identifier>
    <rdfs:label xml:lang="en">separation of duty constraint</rdfs:label>
    <skos:definition xml:lang="en">A Process Regulation that names a set of role definitions, access permissions or task specifications and a cardinality n of at least 2, and prohibits the acts by which one agent would come to hold, exercise or perform n or more members of the set.</skos:definition>
    <skos:scopeNote xml:lang="en">NIST's (role set, n) form (Defs. 3a and 4, pp.240-241), replacing ROWLBAC's symmetric, transitive ssod and dsod properties (§3.4.2), and extended to Botha and Eloff's conflicting permissions and tasks (2001, pp.671-676). What the set holds is given by the role, permission and task subclasses, which are disjoint; when it is checked, by the static and dynamic subclasses. Violations are recorded as conflict reports by query; the constraint is not an OWL axiom over roles, so a breach leaves the ontology consistent.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/rbaco/bfo/RBACO_0000008">
    <rdfs:subClassOf rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000006"/>
    <dc11:identifier>008-RBACO</dc11:identifier>
    <rdfs:label xml:lang="en">access prohibition</rdfs:label>
    <skos:definition xml:lang="en">An access regulation that prescribes that executions of its operation on its objects by bearers of active roles concretizing its role definition, or a senior one, must not occur.</skos:definition>
    <skos:scopeNote xml:lang="en">Beyond NIST, which leaves negative permissions out of its model (Ferraiolo et al. 2001, p.233 fn. 2). Kept because ROWLBAC's prohibited (§3.4.3) is in scope. A prohibition overrides any permission for the same request (deny-overrides). Nothing is prohibited merely because it is not permitted: ROWLBAC's covering axiom on Action (§3.2.1) is not carried over.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/rbaco/bfo/RBACO_0000007">
    <rdfs:subClassOf rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000006"/>
    <owl:disjointWith rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000008"/>
    <dc11:identifier>007-RBACO</dc11:identifier>
    <rdfs:label xml:lang="en">access permission</rdfs:label>
    <skos:definition xml:lang="en">An access regulation that prescribes that executions of its operation on its objects by bearers of active roles concretizing its role definition, or a senior one, may occur.</skos:definition>
    <skos:scopeNote xml:lang="en">The NIST permission, an approval to perform an operation on an object (Def. 1, p.234), held once per role it is assigned to.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/rbaco/bfo/RBACO_0000016">
    <rdfs:subClassOf rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000014"/>
    <dc11:identifier>016-RBACO</dc11:identifier>
    <rdfs:label xml:lang="en">whole-instance dynamic separation of duty constraint</rdfs:label>
    <skos:definition xml:lang="en">A dynamic separation of duty constraint that counts every member of its set an agent has had in the instance up to the request being decided, whether or not still held: every role explicitly activated, permission exercised or task performed.</skos:definition>
    <skos:scopeNote xml:lang="en">Beyond NIST. Blocks a submitter who drops the submitter role from approving the same change.</skos:scopeNote>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://w3id.org/rbaco/bfo/RBACO_0000106">
    <rdfs:domain rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000003"/>
    <rdfs:range rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000004"/>
    <dc11:identifier>106-RBACO</dc11:identifier>
    <rdfs:label xml:lang="en">is activated in</rdfs:label>
    <skos:definition xml:lang="en">Relates an active role to the business process instance in which it was activated and within which it authorizes access.</skos:definition>
    <skos:scopeNote xml:lang="en">New because no held relation fits. A specifically dependent continuant cannot depend on a process (BFO 2020 CLIF, specific-dependency [kkl-1]); RO's existence-overlaps family takes an independent continuant as subject (ro.owl RO_0002487); RO's is active in (RO_0002432) means enabling an activity located in a structure.</skos:scopeNote>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/rbaco/bfo/RBACO_0000145">
    <rdfs:subPropertyOf rdf:resource="https://www.commoncoreontologies.org/ont00001808"/>
    <rdfs:domain rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000049"/>
    <rdfs:range rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000040"/>
    <dc11:identifier>145-RBACO</dc11:identifier>
    <rdfs:label xml:lang="en">requires human agent for</rdfs:label>
    <skos:definition xml:lang="en">Relates a human performer requirement to the task specification whose instances must have a person as agent.</skos:definition>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://w3id.org/rbaco/bfo/RBACO_0000014">
    <rdfs:subClassOf rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000012"/>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="n98c48ae2dbe045be825f75f4e24d694fb63">
        <owl:onProperty rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000115"/>
        <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
        <owl:onClass rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000005"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <dc11:identifier>014-RBACO</dc11:identifier>
    <rdfs:label xml:lang="en">dynamic separation of duty constraint</rdfs:label>
    <skos:definition xml:lang="en">A separation of duty constraint that prohibits the role activations and access requests by which one agent would have, within one business process instance, n or more role definitions from the set explicitly activated, permissions from the set exercised, or task specifications from the set performed.</skos:definition>
    <skos:scopeNote xml:lang="en">NIST Def. 4 (p.241) counts explicitly activated roles only. A role constraint that is neither same-time nor whole-instance is evaluated as same-time; permission and task constraints are whole-instance, being about history (Botha and Eloff 2001, Table 2, p.676). Agents a dynamic conflicting agent designation names count as one, and acts count for their principal.</skos:scopeNote>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://w3id.org/rbaco/bfo/RBACO_0000105">
    <rdfs:subPropertyOf rdf:resource="https://www.commoncoreontologies.org/ont00001808"/>
    <rdfs:domain rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000006"/>
    <rdfs:range rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000001"/>
    <dc11:identifier>105-RBACO</dc11:identifier>
    <rdfs:label xml:lang="en">is assigned to role definition</rdfs:label>
    <skos:definition xml:lang="en">Relates an access regulation to the role definition it is assigned to.</skos:definition>
    <skos:scopeNote xml:lang="en">NIST permission assignment, PA (Ferraiolo et al. 2001, Def. 1, p.234). Each regulation is assigned to at most one role definition, so the same (operation, object) pair granted to two roles is two regulations. Revoking one is a policy retiring act with that regulation as input.</skos:scopeNote>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/rbaco/bfo/RBACO_0000121">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000033"/>
    <rdfs:range rdf:resource="https://www.commoncoreontologies.org/ont00001017"/>
    <dc11:identifier>121-RBACO</dc11:identifier>
    <rdfs:label xml:lang="en">has role issuer</rdfs:label>
    <skos:definition xml:lang="en">Relates an RT role definition to the principal whose role it is, the A of A.r.</skos:definition>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/rbaco/bfo/RBACO_0000125">
    <rdfs:subPropertyOf rdf:resource="https://www.commoncoreontologies.org/ont00001982"/>
    <rdfs:domain rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000018"/>
    <rdfs:range rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000012"/>
    <dc11:identifier>125-RBACO</dc11:identifier>
    <rdfs:label xml:lang="en">describes violated constraint</rdfs:label>
    <skos:definition xml:lang="en">Relates a conflict report to the separation of duty constraint it reports breached.</skos:definition>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://w3id.org/rbaco/bfo/RBACO_0000203">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000037"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <dc11:identifier>203-RBACO</dc11:identifier>
    <rdfs:label xml:lang="en">has linked role name</rdfs:label>
    <skos:definition xml:lang="en">The role name r2 of an RT linking inclusion statement A.r &lt;- B.r1.r2.</skos:definition>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://w3id.org/rbaco/bfo/RBACO_0000035">
    <rdfs:subClassOf rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000034"/>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="n98c48ae2dbe045be825f75f4e24d694fb95">
        <owl:onProperty rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000122"/>
        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
        <owl:onClass rdf:resource="http://purl.obolibrary.org/obo/BFO_0000040"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <dc11:identifier>035-RBACO</dc11:identifier>
    <rdfs:label xml:lang="en">RT simple member statement</rdfs:label>
    <skos:definition xml:lang="en">An RT statement A.r &lt;- D making the principal D a member of A.r.</skos:definition>
    <skos:scopeNote xml:lang="en">RT type 1 (ROWLBAC Fig. 2). Issuing it plays the part of a role assignment.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/rbaco/bfo/RBACO_0000021">
    <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000853"/>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="n98c48ae2dbe045be825f75f4e24d694fb72">
        <owl:onProperty rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000112"/>
        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
        <owl:onClass rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000024"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Class rdf:nodeID="n98c48ae2dbe045be825f75f4e24d694fb73">
        <owl:unionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="https://w3id.org/rbaco/bfo/RBACO_0000022"/>
          <rdf:Description rdf:about="https://w3id.org/rbaco/bfo/RBACO_0000023"/>
        </owl:unionOf>
      </owl:Class>
    </rdfs:subClassOf>
    <dc11:identifier>021-RBACO</dc11:identifier>
    <rdfs:label xml:lang="en">access decision</rdfs:label>
    <skos:definition xml:lang="en">A Descriptive Information Content Entity that describes whether one access request is granted or denied under the regulations in force.</skos:definition>
    <skos:scopeNote xml:lang="en">The result of NIST CheckAccess (p.254). ROWLBAC's disjoint and covering pair PermittedAction / ProhibitedAction (§3.2.1) is kept here, at the decision, where every request does get exactly one answer; at the level of acts it would make everything not granted forbidden.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/rbaco/bfo/RBACO_0000038">
    <rdfs:subClassOf rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000034"/>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="n98c48ae2dbe045be825f75f4e24d694fb98">
        <owl:onProperty rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000117"/>
        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</owl:qualifiedCardinality>
        <owl:onClass rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000033"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <dc11:identifier>038-RBACO</dc11:identifier>
    <rdfs:label xml:lang="en">RT intersection inclusion statement</rdfs:label>
    <skos:definition xml:lang="en">An RT statement A.r &lt;- B.r1 AND C.r2 making every principal that is a member of both B.r1 and C.r2 a member of A.r.</skos:definition>
    <skos:scopeNote xml:lang="en">RT type 4. ROWLBAC encodes it as an intersection class subsumed by A-r (Fig. 3).</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/rbaco/bfo/RBACO_0000018">
    <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000853"/>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="n98c48ae2dbe045be825f75f4e24d694fb66">
        <owl:onProperty rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000124"/>
        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
        <owl:onClass rdf:resource="https://www.commoncoreontologies.org/ont00001017"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="n98c48ae2dbe045be825f75f4e24d694fb67">
        <owl:onProperty rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000125"/>
        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
        <owl:onClass rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000012"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="n98c48ae2dbe045be825f75f4e24d694fb68">
        <owl:onProperty rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000149"/>
        <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</owl:minQualifiedCardinality>
        <owl:onClass rdf:resource="https://www.commoncoreontologies.org/ont00000965"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <dc11:identifier>018-RBACO</dc11:identifier>
    <rdfs:label xml:lang="en">conflict report</rdfs:label>
    <skos:definition xml:lang="en">A Descriptive Information Content Entity that describes one agent's breach of one separation of duty constraint, naming the members of its set involved: role definitions, access permissions or task specifications.</skos:definition>
    <skos:scopeNote xml:lang="en">ROWLBAC's SSODConflict and ProhibitedRoleActivation (§§3.3.5, 3.4.4), written by CONSTRUCT queries.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/rbaco/bfo/RBACO_0000045">
    <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000965"/>
    <dc11:identifier>045-RBACO</dc11:identifier>
    <rdfs:label xml:lang="en">conflicting agent designation</rdfs:label>
    <skos:definition xml:lang="en">A Prescriptive Information Content Entity naming agents, directly or as the member parts of a group of agents, whom the separation of duty constraints it applies to count as one agent.</skos:definition>
    <skos:scopeNote xml:lang="en">Botha and Eloff's conflicting users: "those users who may stand to gain by conspiring. In practice such users may be family members" (2001, p.671), to be "considered as the same user" (Table 1, p.673). Designations do not chain: two designations sharing an agent do not make the others one, which queries/check-designation-chains.rq reports.</skos:scopeNote>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://w3id.org/rbaco/bfo/RBACO_0000124">
    <rdfs:subPropertyOf rdf:resource="https://www.commoncoreontologies.org/ont00001982"/>
    <rdfs:domain rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000018"/>
    <rdfs:range rdf:resource="https://www.commoncoreontologies.org/ont00001017"/>
    <dc11:identifier>124-RBACO</dc11:identifier>
    <rdfs:label xml:lang="en">describes conflict subject</rdfs:label>
    <skos:definition xml:lang="en">Relates a conflict report to the agent the breach is charged to: the agent holding, exercising or performing the members involved (the principal, for an act done on another agent's behalf), counted together with any agent a conflicting agent designation makes one with them.</skos:definition>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://w3id.org/rbaco/bfo/RBACO_0000119">
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000116"/>
    <rdfs:domain rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000017"/>
    <rdfs:range rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000001"/>
    <dc11:identifier>119-RBACO</dc11:identifier>
    <rdfs:label xml:lang="en">has junior role definition</rdfs:label>
    <skos:definition xml:lang="en">Relates a role inheritance statement to its junior role definition, whose authorized members include the senior's.</skos:definition>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://w3id.org/rbaco/bfo/RBACO_0000020">
    <rdfs:subClassOf rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000018"/>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="n98c48ae2dbe045be825f75f4e24d694fb70">
        <owl:onProperty rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000125"/>
        <owl:allValuesFrom rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000014"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="n98c48ae2dbe045be825f75f4e24d694fb71">
        <owl:onProperty rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000127"/>
        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
        <owl:onClass rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000004"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <dc11:identifier>020-RBACO</dc11:identifier>
    <rdfs:label xml:lang="en">dynamic separation of duty conflict report</rdfs:label>
    <skos:definition xml:lang="en">A conflict report describing an activation or access request that would give an agent, within one instance, n or more members of a dynamic separation of duty constraint's set: role definitions explicitly active, permissions exercised or task specifications performed.</skos:definition>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/rbaco/bfo/RBACO_0000033">
    <rdfs:subClassOf rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000001"/>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="n98c48ae2dbe045be825f75f4e24d694fb92">
        <owl:onProperty rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000121"/>
        <owl:someValuesFrom rdf:resource="https://www.commoncoreontologies.org/ont00001017"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="n98c48ae2dbe045be825f75f4e24d694fb93">
        <owl:onProperty rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000202"/>
        <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <dc11:identifier>033-RBACO</dc11:identifier>
    <rdfs:label xml:lang="en">RT role definition</rdfs:label>
    <skos:definition xml:lang="en">A role definition belonging to a principal, the issuer, and named by a role name: the RT role A.r.</skos:definition>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/rbaco/bfo/RBACO_0000026">
    <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00001194"/>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="n98c48ae2dbe045be825f75f4e24d694fb84">
        <owl:onProperty rdf:resource="https://www.commoncoreontologies.org/ont00001986"/>
        <owl:someValuesFrom rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000003"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="n98c48ae2dbe045be825f75f4e24d694fb85">
        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000132"/>
        <owl:someValuesFrom rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000004"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <dc11:identifier>026-RBACO</dc11:identifier>
    <rdfs:label xml:lang="en">role activation</rdfs:label>
    <skos:definition xml:lang="en">A Gain of Role, part of a business process instance, whose output is an active role activated in that instance.</skos:definition>
    <skos:scopeNote xml:lang="en">Demarcates the start of the active role's existence, as CCO's Gain of Role scope note prescribes (EventOntology.ttl ont00001194).</skos:scopeNote>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://w3id.org/rbaco/bfo/RBACO_0000113">
    <rdfs:subPropertyOf rdf:resource="https://www.commoncoreontologies.org/ont00001808"/>
    <rdfs:domain rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000021"/>
    <rdfs:range>
      <owl:Class rdf:nodeID="n98c48ae2dbe045be825f75f4e24d694fb1">
        <owl:unionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="https://w3id.org/rbaco/bfo/RBACO_0000006"/>
          <rdf:Description rdf:about="https://w3id.org/rbaco/bfo/RBACO_0000012"/>
          <rdf:Description rdf:about="https://w3id.org/rbaco/bfo/RBACO_0000050"/>
        </owl:unionOf>
      </owl:Class>
    </rdfs:range>
    <dc11:identifier>113-RBACO</dc11:identifier>
    <rdfs:label xml:lang="en">cites regulation</rdfs:label>
    <skos:definition xml:lang="en">Relates an access decision to a regulation on which it rests.</skos:definition>
    <skos:scopeNote xml:lang="en">A grant cites the permission it used. A denial cites the prohibition that overrode a permission, the task-bound operation requirement the request failed, the permission-based separation of duty constraint that refused it, or nothing when no permission applied. The range admits separation of duty constraints and task-bound operation requirements so that citing one does not classify it as an access regulation.</skos:scopeNote>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://w3id.org/rbaco/bfo/RBACO_0000025">
    <rdfs:subClassOf rdf:resource="https://www.commoncoreontologies.org/ont00000769"/>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="n98c48ae2dbe045be825f75f4e24d694fb81">
        <owl:onProperty rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000107"/>
        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
        <owl:onClass rdf:resource="https://www.commoncoreontologies.org/ont00001017"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="n98c48ae2dbe045be825f75f4e24d694fb82">
        <owl:onProperty rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000110"/>
        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
        <owl:onClass rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000001"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="n98c48ae2dbe045be825f75f4e24d694fb83">
        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000132"/>
        <owl:someValuesFrom rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000004"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <dc11:identifier>025-RBACO</dc11:identifier>
    <rdfs:label xml:lang="en">role activation request</rdfs:label>
    <skos:definition xml:lang="en">An Act of Requesting, part of a business process instance, in which one agent asks to activate one role definition within that instance.</skos:definition>
    <skos:scopeNote xml:lang="en">ROWLBAC's ActivateRole (§3.3.5); NIST AddActiveRole (p.254).</skos:scopeNote>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://w3id.org/rbaco/bfo/RBACO_0000201">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000012"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#positiveInteger"/>
    <dc11:identifier>201-RBACO</dc11:identifier>
    <rdfs:label xml:lang="en">has cardinality</rdfs:label>
    <skos:definition xml:lang="en">The number n such that no agent may hold, exercise or perform n or more members of the constraint's set.</skos:definition>
    <skos:scopeNote xml:lang="en">NIST requires n &gt;= 2 (Defs. 3a and 4, pp.240-241); the class axiom on separation of duty constraint states it. That n is at most the size of the set is checked by queries/check-constraint-shape.rq. CCO deprecates its generic integer value property in favor of domain-specific ones.</skos:scopeNote>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://w3id.org/rbaco/bfo/RBACO_0000002">
    <owl:equivalentClass>
      <owl:Class rdf:nodeID="n98c48ae2dbe045be825f75f4e24d694fb10">
        <owl:intersectionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000023"/>
          <owl:Restriction rdf:nodeID="n98c48ae2dbe045be825f75f4e24d694fb11">
            <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000059"/>
            <owl:someValuesFrom rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000001"/>
          </owl:Restriction>
          <owl:Class rdf:nodeID="n98c48ae2dbe045be825f75f4e24d694fb12">
            <owl:complementOf rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000003"/>
          </owl:Class>
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
    <dc11:identifier>002-RBACO</dc11:identifier>
    <rdfs:label xml:lang="en">assigned role</rdfs:label>
    <skos:definition xml:lang="en">A Role that concretizes some role definition and is not an active role.</skos:definition>
    <skos:scopeNote xml:lang="en">One tenure of a NIST user assignment (UA, Def. 1, p.234). Each tenure is its own role particular, output of a role assignment and input of the role deassignment that ends it. Its bearer never changes; that dependents do not migrate between bearers is adopted as a convention from BFO 2.0 (BFO 2.0 Specification and User's Guide, PDF page 29), since the BFO 2020 CLIF does not state it.</skos:scopeNote>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/rbaco/bfo/RBACO_0000036">
    <rdfs:subClassOf rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000034"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000017"/>
    <dc11:identifier>036-RBACO</dc11:identifier>
    <rdfs:label xml:lang="en">RT simple inclusion statement</rdfs:label>
    <skos:definition xml:lang="en">An RT statement A.r &lt;- B.r1 making every member of B.r1 a member of A.r; a role inheritance statement with B.r1 senior and A.r junior.</skos:definition>
    <skos:scopeNote xml:lang="en">RT type 2. ROWLBAC encodes it as B-r1 rdfs:subClassOf A-r (Fig. 3).</skos:scopeNote>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://w3id.org/rbaco/bfo/RBACO_0000110">
    <rdfs:domain rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000025"/>
    <rdfs:range rdf:resource="https://w3id.org/rbaco/bfo/RBACO_0000001"/>
    <dc11:identifier>110-RBACO</dc11:identifier>
    <rdfs:label xml:lang="en">requests activation of</rdfs:label>
    <skos:definition xml:lang="en">Relates a role activation request to the role definition the requester asks to activate.</skos:definition>
  </owl:ObjectProperty>
</rdf:RDF>
