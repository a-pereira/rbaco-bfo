@prefix cco: <https://www.commoncoreontologies.org/> .
@prefix ex: <https://example.org/rbac-bfo/data/> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rbo: <https://example.org/rbac-bfo/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:purchase a owl:Ontology ;
    rdfs:comment "Botha and Eloff (2001): the purchase order workflow of Figure 2 on the role hierarchy of Figure 3, with Figure 6's Approver role, run under each of Table 2's dynamic interpretations (conflicting roles, permissions, users, tasks) in plans of their own, an internal purchase order process with a human performer requirement, a prior-task guard and a partial task binding, task-bound operations in the Figure 6 plan, and the static cross-entity rules of Tables 1 and 3. Each instance is one scenario."@en ;
    owl:imports rbo:rbo-domain.owl .                    #: RBO domain module: ROWLBAC scenario and attribute examples

ex:officer a cco:ont00001262 ;                          #: Person
    rdfs:label "the security officer"@en .

ex:officer-authority a cco:ont00000187 ;                #: Authority Role
    rdfs:label "authority role of the security officer"@en ;
    obo:BFO_0000197 ex:officer .                        #: inheres in

ex:def-employee a rbo:RBO_0000001 ;                     #: role definition
    rdfs:label "Employee role definition"@en .

ex:rec-def-employee a cco:ont00000253 ;                 #: Information Bearing Entity
    rdfs:label "database record of the Employee role definition"@en ;
    obo:BFO_0000101 ex:def-employee .                   #: is carrier of

ex:def-sc a rbo:RBO_0000001 ;                           #: role definition
    rdfs:label "Stock Controller role definition"@en .

ex:rec-def-sc a cco:ont00000253 ;                       #: Information Bearing Entity
    rdfs:label "database record of the Stock Controller role definition"@en ;
    obo:BFO_0000101 ex:def-sc .                         #: is carrier of

ex:def-buyer a rbo:RBO_0000001 ;                        #: role definition
    rdfs:label "Buyer role definition"@en .

ex:rec-def-buyer a cco:ont00000253 ;                    #: Information Bearing Entity
    rdfs:label "database record of the Buyer role definition"@en ;
    obo:BFO_0000101 ex:def-buyer .                      #: is carrier of

ex:def-accountant a rbo:RBO_0000001 ;                   #: role definition
    rdfs:label "Accountant role definition"@en .

ex:rec-def-accountant a cco:ont00000253 ;               #: Information Bearing Entity
    rdfs:label "database record of the Accountant role definition"@en ;
    obo:BFO_0000101 ex:def-accountant .                 #: is carrier of

ex:def-clerk a rbo:RBO_0000001 ;                        #: role definition
    rdfs:label "Clerk role definition"@en .

ex:rec-def-clerk a cco:ont00000253 ;                    #: Information Bearing Entity
    rdfs:label "database record of the Clerk role definition"@en ;
    obo:BFO_0000101 ex:def-clerk .                      #: is carrier of

ex:def-apm a rbo:RBO_0000001 ;                          #: role definition
    rdfs:label "Assistant Purchase Manager role definition"@en .

ex:rec-def-apm a cco:ont00000253 ;                      #: Information Bearing Entity
    rdfs:label "database record of the Assistant Purchase Manager role definition"@en ;
    obo:BFO_0000101 ex:def-apm .                        #: is carrier of

ex:def-approver a rbo:RBO_0000001 ;                     #: role definition
    rdfs:label "Approver role definition"@en .

ex:rec-def-approver a cco:ont00000253 ;                 #: Information Bearing Entity
    rdfs:label "database record of the Approver role definition"@en ;
    obo:BFO_0000101 ex:def-approver .                   #: is carrier of

ex:def-manager a rbo:RBO_0000001 ;                      #: role definition
    rdfs:label "Manager role definition"@en .

ex:rec-def-manager a cco:ont00000253 ;                  #: Information Bearing Entity
    rdfs:label "database record of the Manager role definition"@en ;
    obo:BFO_0000101 ex:def-manager .                    #: is carrier of

ex:def-stores a rbo:RBO_0000001 ;                       #: role definition
    rdfs:label "Stores role definition"@en .

ex:rec-def-stores a cco:ont00000253 ;                   #: Information Bearing Entity
    rdfs:label "database record of the Stores role definition"@en ;
    obo:BFO_0000101 ex:def-stores .                     #: is carrier of

ex:def-auditor a rbo:RBO_0000001 ;                      #: role definition
    rdfs:label "Auditor role definition"@en .

ex:rec-def-auditor a cco:ont00000253 ;                  #: Information Bearing Entity
    rdfs:label "database record of the Auditor role definition"@en ;
    obo:BFO_0000101 ex:def-auditor .                    #: is carrier of

ex:inh-apm-buyer a rbo:RBO_0000017 ;                    #: role inheritance statement
    rdfs:label "apm inherits from buyer"@en ;
    rbo:RBO_0000118 ex:def-apm ;                        #: has senior role definition
    rbo:RBO_0000119 ex:def-buyer .                      #: has junior role definition

ex:inh-apm-accountant a rbo:RBO_0000017 ;               #: role inheritance statement
    rdfs:label "apm inherits from accountant"@en ;
    rbo:RBO_0000118 ex:def-apm ;                        #: has senior role definition
    rbo:RBO_0000119 ex:def-accountant .                 #: has junior role definition

ex:inh-buyer-sc a rbo:RBO_0000017 ;                     #: role inheritance statement
    rdfs:label "buyer inherits from sc"@en ;
    rbo:RBO_0000118 ex:def-buyer ;                      #: has senior role definition
    rbo:RBO_0000119 ex:def-sc .                         #: has junior role definition

ex:inh-accountant-clerk a rbo:RBO_0000017 ;             #: role inheritance statement
    rdfs:label "accountant inherits from clerk"@en ;
    rbo:RBO_0000118 ex:def-accountant ;                 #: has senior role definition
    rbo:RBO_0000119 ex:def-clerk .                      #: has junior role definition

ex:inh-sc-employee a rbo:RBO_0000017 ;                  #: role inheritance statement
    rdfs:label "sc inherits from employee"@en ;
    rbo:RBO_0000118 ex:def-sc ;                         #: has senior role definition
    rbo:RBO_0000119 ex:def-employee .                   #: has junior role definition

ex:inh-clerk-employee a rbo:RBO_0000017 ;               #: role inheritance statement
    rdfs:label "clerk inherits from employee"@en ;
    rbo:RBO_0000118 ex:def-clerk ;                      #: has senior role definition
    rbo:RBO_0000119 ex:def-employee .                   #: has junior role definition

ex:inh-apm-approver a rbo:RBO_0000017 ;                 #: role inheritance statement
    rdfs:label "apm inherits from approver"@en ;
    rbo:RBO_0000118 ex:def-apm ;                        #: has senior role definition
    rbo:RBO_0000119 ex:def-approver .                   #: has junior role definition

ex:op-create-requisition a obo:IAO_0000104 ;            #: plan specification
    rdfs:label "create requisition procedure"@en .

ex:op-create-order a obo:IAO_0000104 ;                  #: plan specification
    rdfs:label "create order procedure"@en .

ex:op-view-order a obo:IAO_0000104 ;                    #: plan specification
    rdfs:label "view order procedure"@en .

ex:op-send-email a obo:IAO_0000104 ;                    #: plan specification
    rdfs:label "send e-mail procedure"@en .

ex:op-confirm-funds a obo:IAO_0000104 ;                 #: plan specification
    rdfs:label "confirm funds procedure"@en .

ex:op-approve-order a obo:IAO_0000104 ;                 #: plan specification
    rdfs:label "approve order procedure"@en .

ex:op-create-rejection-letter a obo:IAO_0000104 ;       #: plan specification
    rdfs:label "create rejection letter procedure"@en .

ex:op-complete-order-form a obo:IAO_0000104 ;           #: plan specification
    rdfs:label "complete order form procedure"@en .

ex:op-approve-po a obo:IAO_0000104 ;                    #: plan specification
    rdfs:label "approve purchase order procedure"@en .

ex:op-issue-items a obo:IAO_0000104 ;                   #: plan specification
    rdfs:label "issue items procedure"@en .

ex:op-approve-audit a obo:IAO_0000104 ;                 #: plan specification
    rdfs:label "approve audit procedure"@en .

ex:perm-employee-email a rbo:RBO_0000007 ;              #: access permission
    rdfs:label "Employee: permitted send e-mail"@en ;
    rbo:RBO_0000101 ex:op-send-email ;                  #: has operation
    rbo:RBO_0000105 ex:def-employee .                   #: is assigned to role definition

ex:perm-sc-requisition a rbo:RBO_0000007 ;              #: access permission
    rdfs:label "Stock Controller: permitted create requisition"@en ;
    rbo:RBO_0000101 ex:op-create-requisition ;          #: has operation
    rbo:RBO_0000105 ex:def-sc .                         #: is assigned to role definition

ex:perm-buyer-order a rbo:RBO_0000007 ;                 #: access permission
    rdfs:label "Buyer: permitted create order"@en ;
    rbo:RBO_0000101 ex:op-create-order ;                #: has operation
    rbo:RBO_0000105 ex:def-buyer .                      #: is assigned to role definition

ex:perm-buyer-view a rbo:RBO_0000007 ;                  #: access permission
    rdfs:label "Buyer: permitted view order"@en ;
    rbo:RBO_0000101 ex:op-view-order ;                  #: has operation
    rbo:RBO_0000105 ex:def-buyer .                      #: is assigned to role definition

ex:perm-accountant-funds a rbo:RBO_0000007 ;            #: access permission
    rdfs:label "Accountant: permitted confirm funds"@en ;
    rbo:RBO_0000101 ex:op-confirm-funds ;               #: has operation
    rbo:RBO_0000105 ex:def-accountant .                 #: is assigned to role definition

ex:perm-apm-approve a rbo:RBO_0000007 ;                 #: access permission
    rdfs:label "Assistant Purchase Manager: permitted approve order"@en ;
    rbo:RBO_0000101 ex:op-approve-order ;               #: has operation
    rbo:RBO_0000105 ex:def-apm .                        #: is assigned to role definition

ex:perm-apm-reject a rbo:RBO_0000007 ;                  #: access permission
    rdfs:label "Assistant Purchase Manager: permitted create rejection letter"@en ;
    rbo:RBO_0000101 ex:op-create-rejection-letter ;     #: has operation
    rbo:RBO_0000105 ex:def-apm .                        #: is assigned to role definition

ex:perm-approver-approve a rbo:RBO_0000007 ;            #: access permission
    rdfs:label "Approver: permitted approve order"@en ;
    rbo:RBO_0000101 ex:op-approve-order ;               #: has operation
    rbo:RBO_0000105 ex:def-approver .                   #: is assigned to role definition

ex:perm-manager-form a rbo:RBO_0000007 ;                #: access permission
    rdfs:label "Manager: permitted complete order form"@en ;
    rbo:RBO_0000101 ex:op-complete-order-form ;         #: has operation
    rbo:RBO_0000105 ex:def-manager .                    #: is assigned to role definition

ex:perm-manager-approve-po a rbo:RBO_0000007 ;          #: access permission
    rdfs:label "Manager: permitted approve purchase order"@en ;
    rbo:RBO_0000101 ex:op-approve-po ;                  #: has operation
    rbo:RBO_0000105 ex:def-manager .                    #: is assigned to role definition

ex:perm-stores-issue a rbo:RBO_0000007 ;                #: access permission
    rdfs:label "Stores: permitted issue items"@en ;
    rbo:RBO_0000101 ex:op-issue-items ;                 #: has operation
    rbo:RBO_0000105 ex:def-stores .                     #: is assigned to role definition

ex:perm-auditor-audit a rbo:RBO_0000007 ;               #: access permission
    rdfs:label "Auditor: permitted approve audit"@en ;
    rbo:RBO_0000101 ex:op-approve-audit ;               #: has operation
    rbo:RBO_0000105 ex:def-auditor .                    #: is assigned to role definition

ex:plan-t2-roles a rbo:RBO_0000005 ;                    #: business process plan
    rdfs:label "purchase order process, conflicting roles plan"@en .

ex:plan-t2-perms a rbo:RBO_0000005 ;                    #: business process plan
    rdfs:label "purchase order process, conflicting permissions plan"@en .

ex:plan-t2-users a rbo:RBO_0000005 ;                    #: business process plan
    rdfs:label "purchase order process, conflicting users plan"@en .

ex:plan-t2-tasks a rbo:RBO_0000005 ;                    #: business process plan
    rdfs:label "purchase order process, conflicting tasks plan"@en .

ex:plan-fig6 a rbo:RBO_0000005 ;                        #: business process plan
    rdfs:label "purchase order process, Figure 6 hierarchy plan"@en .

ex:plan-internal-po a rbo:RBO_0000005 ;                 #: business process plan
    rdfs:label "internal purchase order process plan"@en .

ex:plan-audit a rbo:RBO_0000005 ;                       #: business process plan
    rdfs:label "purchase audit process plan"@en .

ex:ts-prepare-requisition a rbo:RBO_0000040 ;           #: task specification
    rdfs:label "prepare requisition task specification"@en ;
    obo:BFO_0000176 ex:plan-fig6,                       #: continuant part of
        ex:plan-t2-perms,
        ex:plan-t2-roles,
        ex:plan-t2-tasks,
        ex:plan-t2-users ;
    rbo:RBO_0000132 ex:def-sc ;                         #: requires role definition
    rbo:RBO_0000133 ex:op-create-requisition .          #: requires operation

ex:ts-order-stock a rbo:RBO_0000040 ;                   #: task specification
    rdfs:label "order stock task specification"@en ;
    obo:BFO_0000176 ex:plan-t2-perms,                   #: continuant part of
        ex:plan-t2-roles,
        ex:plan-t2-tasks,
        ex:plan-t2-users ;
    rbo:RBO_0000132 ex:def-buyer ;                      #: requires role definition
    rbo:RBO_0000133 ex:op-create-order,                 #: requires operation
        ex:op-view-order .

ex:ts-check-funds a rbo:RBO_0000040 ;                   #: task specification
    rdfs:label "check funds task specification"@en ;
    obo:BFO_0000176 ex:plan-t2-perms,                   #: continuant part of
        ex:plan-t2-roles,
        ex:plan-t2-tasks,
        ex:plan-t2-users ;
    rbo:RBO_0000132 ex:def-accountant ;                 #: requires role definition
    rbo:RBO_0000133 ex:op-confirm-funds .               #: requires operation

ex:ts-approve-order a rbo:RBO_0000040 ;                 #: task specification
    rdfs:label "approve order task specification"@en ;
    obo:BFO_0000176 ex:plan-t2-perms,                   #: continuant part of
        ex:plan-t2-roles,
        ex:plan-t2-tasks,
        ex:plan-t2-users ;
    rbo:RBO_0000132 ex:def-apm ;                        #: requires role definition
    rbo:RBO_0000133 ex:op-approve-order .               #: requires operation

ex:ts-send-order a rbo:RBO_0000040 ;                    #: task specification
    rdfs:label "send order task specification"@en ;
    obo:BFO_0000176 ex:plan-t2-perms,                   #: continuant part of
        ex:plan-t2-roles,
        ex:plan-t2-tasks,
        ex:plan-t2-users ;
    rbo:RBO_0000132 ex:def-buyer ;                      #: requires role definition
    rbo:RBO_0000133 ex:op-send-email,                   #: requires operation
        ex:op-view-order .

ex:ts-approve-order-fig6 a rbo:RBO_0000040 ;            #: task specification
    rdfs:label "approve order (Figure 6) task specification"@en ;
    obo:BFO_0000176 ex:plan-fig6 ;                      #: continuant part of
    rbo:RBO_0000132 ex:def-approver ;                   #: requires role definition
    rbo:RBO_0000133 ex:op-approve-order .               #: requires operation

ex:ts-complete-form a rbo:RBO_0000040 ;                 #: task specification
    rdfs:label "complete order form task specification"@en ;
    obo:BFO_0000176 ex:plan-internal-po ;               #: continuant part of
    rbo:RBO_0000132 ex:def-manager ;                    #: requires role definition
    rbo:RBO_0000133 ex:op-complete-order-form .         #: requires operation

ex:ts-approve-po a rbo:RBO_0000040 ;                    #: task specification
    rdfs:label "approve purchase order task specification"@en ;
    obo:BFO_0000176 ex:plan-internal-po ;               #: continuant part of
    rbo:RBO_0000132 ex:def-manager ;                    #: requires role definition
    rbo:RBO_0000133 ex:op-approve-po .                  #: requires operation

ex:ts-issue-items a rbo:RBO_0000040 ;                   #: task specification
    rdfs:label "issue items task specification"@en ;
    obo:BFO_0000176 ex:plan-internal-po ;               #: continuant part of
    rbo:RBO_0000132 ex:def-stores ;                     #: requires role definition
    rbo:RBO_0000133 ex:op-issue-items ;                 #: requires operation
    rbo:RBO_0000144 ex:ts-approve-po .                  #: requires prior

ex:ts-approve-audit a rbo:RBO_0000040 ;                 #: task specification
    rdfs:label "approve audit task specification"@en ;
    obo:BFO_0000176 ex:plan-audit ;                     #: continuant part of
    rbo:RBO_0000132 ex:def-auditor ;                    #: requires role definition
    rbo:RBO_0000133 ex:op-approve-audit .               #: requires operation

ex:tom-dick-family a cco:ont00000837 ;                  #: Family
    rdfs:label "the family of Tom and Dick"@en .

ex:workflow-engine a cco:ont00001017 ;                  #: Agent
    rdfs:label "the workflow engine"@en .

ex:stores-host a cco:ont00001017 ;                      #: Agent
    rdfs:label "the stores application host"@en .

ex:approval-bot a cco:ont00001017 ;                     #: Agent
    rdfs:label "the approval robot"@en .

ex:tom a cco:ont00001262 ;                              #: Person
    rdfs:label "Tom"@en ;
    obo:BFO_0000129 ex:tom-dick-family .                #: member part of

ex:dick a cco:ont00001262 ;                             #: Person
    rdfs:label "Dick"@en ;
    obo:BFO_0000129 ex:tom-dick-family .                #: member part of

ex:harry a cco:ont00001262 ;                            #: Person
    rdfs:label "Harry"@en .

ex:ssd-auditor-apm a rbo:RBO_0000013 ;                  #: static separation of duty constraint
    rdfs:label "SSD {Auditor, APM}, n = 2"@en ;
    rbo:RBO_0000114 ex:def-apm,                         #: has constrained role definition
        ex:def-auditor ;
    rbo:RBO_0000201 "2"^^xsd:positiveInteger .          #: has cardinality

ex:pssd-approve-audit a rbo:RBO_0000013 ;               #: static separation of duty constraint
    rdfs:label "permission SSD {APM: approve order, Auditor: approve audit}, n = 2"@en ;
    rbo:RBO_0000134 ex:perm-apm-approve,                #: has constrained permission
        ex:perm-auditor-audit ;
    rbo:RBO_0000201 "2"^^xsd:positiveInteger .          #: has cardinality

ex:tssd-approve-audit a rbo:RBO_0000013 ;               #: static separation of duty constraint
    rdfs:label "task SSD {approve order, approve audit}, n = 2"@en ;
    rbo:RBO_0000135 ex:ts-approve-audit,                #: has constrained task specification
        ex:ts-approve-order ;
    rbo:RBO_0000201 "2"^^xsd:positiveInteger .          #: has cardinality

ex:sdes-family a rbo:RBO_0000046 ;                      #: static conflicting agent designation
    rdfs:label "static conflicting agents: the members of Tom and Dick's family"@en ;
    rbo:RBO_0000139 ex:tom-dick-family .                #: designates conflicting group

ex:pssd-issue-approve-po a rbo:RBO_0000013 ;            #: static separation of duty constraint
    rdfs:label "permission SSD {Stores: issue items, Manager: approve purchase order}, n = 2"@en ;
    rbo:RBO_0000134 ex:perm-manager-approve-po,         #: has constrained permission
        ex:perm-stores-issue ;
    rbo:RBO_0000201 "2"^^xsd:positiveInteger .          #: has cardinality

ex:tssd-issue-approve-po a rbo:RBO_0000013 ;            #: static separation of duty constraint
    rdfs:label "task SSD {issue items, approve purchase order}, n = 2"@en ;
    rbo:RBO_0000135 ex:ts-approve-po,                   #: has constrained task specification
        ex:ts-issue-items ;
    rbo:RBO_0000201 "2"^^xsd:positiveInteger .          #: has cardinality

ex:dsd-sc-apm a rbo:RBO_0000016 ;                       #: whole-instance dynamic separation of duty constraint
    rdfs:label "DSD {Stock Controller, APM}, n = 2, conflicting roles plan"@en ;
    rbo:RBO_0000114 ex:def-apm,                         #: has constrained role definition
        ex:def-sc ;
    rbo:RBO_0000115 ex:plan-t2-roles ;                  #: applies within
    rbo:RBO_0000201 "2"^^xsd:positiveInteger .          #: has cardinality

ex:pdsd-perms a rbo:RBO_0000016 ;                       #: whole-instance dynamic separation of duty constraint
    rdfs:label "permission DSD {SC: create requisition, APM: approve order}, n = 2, conflicting permissions plan"@en ;
    rbo:RBO_0000115 ex:plan-t2-perms ;                  #: applies within
    rbo:RBO_0000134 ex:perm-apm-approve,                #: has constrained permission
        ex:perm-sc-requisition ;
    rbo:RBO_0000201 "2"^^xsd:positiveInteger .          #: has cardinality

ex:pdsd-users a rbo:RBO_0000016 ;                       #: whole-instance dynamic separation of duty constraint
    rdfs:label "permission DSD {SC: create requisition, APM: approve order}, n = 2, conflicting users plan"@en ;
    rbo:RBO_0000115 ex:plan-t2-users ;                  #: applies within
    rbo:RBO_0000134 ex:perm-apm-approve,                #: has constrained permission
        ex:perm-sc-requisition ;
    rbo:RBO_0000201 "2"^^xsd:positiveInteger .          #: has cardinality

ex:ddes-users a rbo:RBO_0000047 ;                       #: dynamic conflicting agent designation
    rdfs:label "dynamic conflicting agents Tom and Dick, conflicting users plan"@en ;
    rbo:RBO_0000115 ex:plan-t2-users ;                  #: applies within
    rbo:RBO_0000138 ex:dick,                            #: designates conflicting agent
        ex:tom .

ex:tdsd-tasks a rbo:RBO_0000016 ;                       #: whole-instance dynamic separation of duty constraint
    rdfs:label "task DSD {prepare requisition, approve order}, n = 2, conflicting tasks plan"@en ;
    rbo:RBO_0000115 ex:plan-t2-tasks ;                  #: applies within
    rbo:RBO_0000135 ex:ts-approve-order,                #: has constrained task specification
        ex:ts-prepare-requisition ;
    rbo:RBO_0000201 "2"^^xsd:positiveInteger .          #: has cardinality

ex:dsd-sc-approver a rbo:RBO_0000016 ;                  #: whole-instance dynamic separation of duty constraint
    rdfs:label "DSD {Stock Controller, Approver}, n = 2, Figure 6 plan"@en ;
    rbo:RBO_0000114 ex:def-approver,                    #: has constrained role definition
        ex:def-sc ;
    rbo:RBO_0000115 ex:plan-fig6 ;                      #: applies within
    rbo:RBO_0000201 "2"^^xsd:positiveInteger .          #: has cardinality

ex:tdsd-internal a rbo:RBO_0000016 ;                    #: whole-instance dynamic separation of duty constraint
    rdfs:label "task DSD {complete order form, approve purchase order}, n = 2, internal purchase orders"@en ;
    rbo:RBO_0000115 ex:plan-internal-po ;               #: applies within
    rbo:RBO_0000135 ex:ts-approve-po,                   #: has constrained task specification
        ex:ts-complete-form ;
    rbo:RBO_0000201 "2"^^xsd:positiveInteger .          #: has cardinality

ex:ddes-internal a rbo:RBO_0000047 ;                    #: dynamic conflicting agent designation
    rdfs:label "dynamic conflicting agents Tom and Dick, internal purchase orders"@en ;
    rbo:RBO_0000115 ex:plan-internal-po ;               #: applies within
    rbo:RBO_0000138 ex:dick,                            #: designates conflicting agent
        ex:tom .

ex:human-approve-po a rbo:RBO_0000049 ;                 #: human performer requirement
    rdfs:label "a person approves internal purchase orders"@en ;
    rbo:RBO_0000115 ex:plan-internal-po ;               #: applies within
    rbo:RBO_0000145 ex:ts-approve-po .                  #: requires human agent for

ex:ddes-audit a rbo:RBO_0000047 ;                       #: dynamic conflicting agent designation
    rdfs:label "dynamic conflicting agents Dick and Harry, purchase audits"@en ;
    rbo:RBO_0000115 ex:plan-audit ;                     #: applies within
    rbo:RBO_0000138 ex:dick,                            #: designates conflicting agent
        ex:harry .

ex:tbr-fig6 a rbo:RBO_0000050 ;                         #: task-bound operation requirement
    rdfs:label "create requisition and approve order only within a task that requires them, Figure 6 plan"@en ;
    rbo:RBO_0000115 ex:plan-fig6 ;                      #: applies within
    rbo:RBO_0000148 ex:op-approve-order,                #: requires task binding for
        ex:op-create-requisition .

ex:tbr-internal a rbo:RBO_0000050 ;                     #: task-bound operation requirement
    rdfs:label "approve purchase order only within a task that requires it, internal purchase orders"@en ;
    rbo:RBO_0000115 ex:plan-internal-po ;               #: applies within
    rbo:RBO_0000148 ex:op-approve-po .                  #: requires task binding for

ex:policy-load-start a obo:BFO_0000203 ;                #: temporal instant
    rbo:RBO_0000205 "2026-01-01T08:00:00+00:00"^^xsd:dateTime .  #: has timestamp

ex:policy-load-interval a obo:BFO_0000202 ;             #: temporal interval
    obo:BFO_0000222 ex:policy-load-start .              #: has first instant

ex:policy-load a rbo:RBO_0000031 ;                      #: policy issuing act
    rdfs:label "policy issuing act policy-load"@en ;
    obo:BFO_0000055 ex:officer-authority ;              #: realizes
    obo:BFO_0000199 ex:policy-load-interval ;           #: occupies temporal region
    cco:ont00001833 ex:officer ;                        #: has agent
    cco:ont00001986 ex:ddes-audit,                      #: has output
        ex:ddes-internal,
        ex:ddes-users,
        ex:def-accountant,
        ex:def-apm,
        ex:def-approver,
        ex:def-auditor,
        ex:def-buyer,
        ex:def-clerk,
        ex:def-employee,
        ex:def-manager,
        ex:def-sc,
        ex:def-stores,
        ex:dsd-sc-apm,
        ex:dsd-sc-approver,
        ex:human-approve-po,
