    rdfs:label "marie asks to op-use-device on display-d7"@en ;
    obo:BFO_0000132 ex:marie-day ;                      #: occurrent part of
    obo:BFO_0000199 ex:marie-req-use-display-d7-interval ;  #: occupies temporal region
    rbaco:RBACO_0000107 ex:marie ;                      #: has requester
    rbaco:RBACO_0000108 ex:op-use-device ;              #: requests operation
    rbaco:RBACO_0000109 ex:display-d7 .                 #: requests access to

ex:marie-req-use-display-d8-start a obo:BFO_0000203 ;   #: temporal instant
    rbaco:RBACO_0000205 "2026-01-07T09:04:00+00:00"^^xsd:dateTime .  #: has timestamp

ex:marie-req-use-display-d8-interval a obo:BFO_0000202 ;  #: temporal interval
    obo:BFO_0000222 ex:marie-req-use-display-d8-start .  #: has first instant

ex:marie-req-use-display-d8 a rbaco:RBACO_0000024 ;     #: access request
    rdfs:label "marie asks to op-use-device on display-d8"@en ;
    obo:BFO_0000132 ex:marie-day ;                      #: occurrent part of
