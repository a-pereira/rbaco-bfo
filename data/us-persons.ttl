@prefix cco: <https://www.commoncoreontologies.org/> .
@prefix ex: <https://example.org/rbaco/data/> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rbaco: <https://w3id.org/rbaco/bfo/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:us-persons a owl:Ontology ;
    rdfs:comment "ROWLBAC section 3.1 scenario: the US persons role hierarchy (Figure 1), its permissions and prohibitions, two static and one dynamic separation of duty constraint, and Alice's and Bob's narratives, each hosted in one status eligibility review."@en ;
    owl:imports rbaco:rbaco-bfo-domain.owl .            #: RBACO-BFO domain module: ROWLBAC scenario and attribute examples

ex:officer a cco:ont00001262 ;                          #: Person
    rdfs:label "the security officer"@en .

ex:officer-authority a cco:ont00000187 ;                #: Authority Role
    rdfs:label "authority role of the security officer"@en ;
    obo:BFO_0000197 ex:officer .                        #: inheres in

ex:def-legal-person a rbaco:RBACO_0000001 ;             #: role definition
    rdfs:label "Person role definition"@en .

ex:rec-def-legal-person a cco:ont00000253 ;             #: Information Bearing Entity
    rdfs:label "database record of the Person role definition"@en ;
    obo:BFO_0000101 ex:def-legal-person .               #: is carrier of

ex:def-us-person a rbaco:RBACO_0000001 ;                #: role definition
    rdfs:label "US Person role definition"@en .

ex:rec-def-us-person a cco:ont00000253 ;                #: Information Bearing Entity
    rdfs:label "database record of the US Person role definition"@en ;
    obo:BFO_0000101 ex:def-us-person .                  #: is carrier of

ex:def-foreign-person a rbaco:RBACO_0000001 ;           #: role definition
    rdfs:label "Foreign Person role definition"@en .

ex:rec-def-foreign-person a cco:ont00000253 ;           #: Information Bearing Entity
    rdfs:label "database record of the Foreign Person role definition"@en ;
    obo:BFO_0000101 ex:def-foreign-person .             #: is carrier of

ex:def-citizen a rbaco:RBACO_0000001 ;                  #: role definition
    rdfs:label "Citizen role definition"@en .

ex:rec-def-citizen a cco:ont00000253 ;                  #: Information Bearing Entity
    rdfs:label "database record of the Citizen role definition"@en ;
    obo:BFO_0000101 ex:def-citizen .                    #: is carrier of

ex:def-resident a rbaco:RBACO_0000001 ;                 #: role definition
    rdfs:label "Resident role definition"@en .

ex:rec-def-resident a cco:ont00000253 ;                 #: Information Bearing Entity
    rdfs:label "database record of the Resident role definition"@en ;
    obo:BFO_0000101 ex:def-resident .                   #: is carrier of

ex:def-visitor a rbaco:RBACO_0000001 ;                  #: role definition
    rdfs:label "Visitor role definition"@en .

ex:rec-def-visitor a cco:ont00000253 ;                  #: Information Bearing Entity
    rdfs:label "database record of the Visitor role definition"@en ;
    obo:BFO_0000101 ex:def-visitor .                    #: is carrier of

ex:def-permanent-resident a rbaco:RBACO_0000001 ;       #: role definition
    rdfs:label "Permanent Resident role definition"@en .

ex:rec-def-permanent-resident a cco:ont00000253 ;       #: Information Bearing Entity
    rdfs:label "database record of the Permanent Resident role definition"@en ;
    obo:BFO_0000101 ex:def-permanent-resident .         #: is carrier of

ex:def-pr-applicant a rbaco:RBACO_0000001 ;             #: role definition
    rdfs:label "Perm Residency Applicant role definition"@en .

ex:rec-def-pr-applicant a cco:ont00000253 ;             #: Information Bearing Entity
    rdfs:label "database record of the Perm Residency Applicant role definition"@en ;
    obo:BFO_0000101 ex:def-pr-applicant .               #: is carrier of

ex:def-temporary-resident a rbaco:RBACO_0000001 ;       #: role definition
    rdfs:label "Temporary Resident role definition"@en .

ex:rec-def-temporary-resident a cco:ont00000253 ;       #: Information Bearing Entity
    rdfs:label "database record of the Temporary Resident role definition"@en ;
    obo:BFO_0000101 ex:def-temporary-resident .         #: is carrier of

ex:def-work-visa a rbaco:RBACO_0000001 ;                #: role definition
    rdfs:label "Work Visa Holder role definition"@en .

ex:rec-def-work-visa a cco:ont00000253 ;                #: Information Bearing Entity
    rdfs:label "database record of the Work Visa Holder role definition"@en ;
    obo:BFO_0000101 ex:def-work-visa .                  #: is carrier of

ex:def-business-visa a rbaco:RBACO_0000001 ;            #: role definition
    rdfs:label "Business Visa Holder role definition"@en .

ex:rec-def-business-visa a cco:ont00000253 ;            #: Information Bearing Entity
    rdfs:label "database record of the Business Visa Holder role definition"@en ;
    obo:BFO_0000101 ex:def-business-visa .              #: is carrier of

ex:def-student-visa a rbaco:RBACO_0000001 ;             #: role definition
    rdfs:label "Student Visa Holder role definition"@en .

ex:rec-def-student-visa a cco:ont00000253 ;             #: Information Bearing Entity
    rdfs:label "database record of the Student Visa Holder role definition"@en ;
    obo:BFO_0000101 ex:def-student-visa .               #: is carrier of

#: rbaco:RBACO_0001001  legal person role
rbaco:RBACO_0001001 rbaco:RBACO_0000301 ex:def-legal-person .  #: corresponds to role definition

#: rbaco:RBACO_0001002  US person role
rbaco:RBACO_0001002 rbaco:RBACO_0000301 ex:def-us-person .  #: corresponds to role definition

#: rbaco:RBACO_0001003  foreign person role
rbaco:RBACO_0001003 rbaco:RBACO_0000301 ex:def-foreign-person .  #: corresponds to role definition

#: rbaco:RBACO_0001004  US citizen role
rbaco:RBACO_0001004 rbaco:RBACO_0000301 ex:def-citizen .  #: corresponds to role definition

#: rbaco:RBACO_0001005  US resident role
rbaco:RBACO_0001005 rbaco:RBACO_0000301 ex:def-resident .  #: corresponds to role definition

#: rbaco:RBACO_0001006  US visitor role
rbaco:RBACO_0001006 rbaco:RBACO_0000301 ex:def-visitor .  #: corresponds to role definition

#: rbaco:RBACO_0001007  US permanent resident role
rbaco:RBACO_0001007 rbaco:RBACO_0000301 ex:def-permanent-resident .  #: corresponds to role definition

#: rbaco:RBACO_0001008  US permanent residency applicant role
rbaco:RBACO_0001008 rbaco:RBACO_0000301 ex:def-pr-applicant .  #: corresponds to role definition

#: rbaco:RBACO_0001009  US temporary resident role
rbaco:RBACO_0001009 rbaco:RBACO_0000301 ex:def-temporary-resident .  #: corresponds to role definition

#: rbaco:RBACO_0001010  US work visa holder role
rbaco:RBACO_0001010 rbaco:RBACO_0000301 ex:def-work-visa .  #: corresponds to role definition

#: rbaco:RBACO_0001011  US business visa holder role
rbaco:RBACO_0001011 rbaco:RBACO_0000301 ex:def-business-visa .  #: corresponds to role definition

#: rbaco:RBACO_0001012  US student visa holder role
rbaco:RBACO_0001012 rbaco:RBACO_0000301 ex:def-student-visa .  #: corresponds to role definition

ex:inh-us-person-legal-person a rbaco:RBACO_0000017 ;   #: role inheritance statement
    rdfs:label "us-person inherits from legal-person"@en ;
    rbaco:RBACO_0000118 ex:def-us-person ;              #: has senior role definition
    rbaco:RBACO_0000119 ex:def-legal-person .           #: has junior role definition

ex:inh-foreign-person-legal-person a rbaco:RBACO_0000017 ;  #: role inheritance statement
    rdfs:label "foreign-person inherits from legal-person"@en ;
    rbaco:RBACO_0000118 ex:def-foreign-person ;         #: has senior role definition
    rbaco:RBACO_0000119 ex:def-legal-person .           #: has junior role definition

ex:inh-citizen-us-person a rbaco:RBACO_0000017 ;        #: role inheritance statement
    rdfs:label "citizen inherits from us-person"@en ;
    rbaco:RBACO_0000118 ex:def-citizen ;                #: has senior role definition
    rbaco:RBACO_0000119 ex:def-us-person .              #: has junior role definition

ex:inh-resident-us-person a rbaco:RBACO_0000017 ;       #: role inheritance statement
    rdfs:label "resident inherits from us-person"@en ;
    rbaco:RBACO_0000118 ex:def-resident ;               #: has senior role definition
    rbaco:RBACO_0000119 ex:def-us-person .              #: has junior role definition

ex:inh-visitor-us-person a rbaco:RBACO_0000017 ;        #: role inheritance statement
    rdfs:label "visitor inherits from us-person"@en ;
    rbaco:RBACO_0000118 ex:def-visitor ;                #: has senior role definition
    rbaco:RBACO_0000119 ex:def-us-person .              #: has junior role definition

ex:inh-permanent-resident-resident a rbaco:RBACO_0000017 ;  #: role inheritance statement
    rdfs:label "permanent-resident inherits from resident"@en ;
    rbaco:RBACO_0000118 ex:def-permanent-resident ;     #: has senior role definition
    rbaco:RBACO_0000119 ex:def-resident .               #: has junior role definition

ex:inh-pr-applicant-resident a rbaco:RBACO_0000017 ;    #: role inheritance statement
    rdfs:label "pr-applicant inherits from resident"@en ;
    rbaco:RBACO_0000118 ex:def-pr-applicant ;           #: has senior role definition
    rbaco:RBACO_0000119 ex:def-resident .               #: has junior role definition

ex:inh-temporary-resident-resident a rbaco:RBACO_0000017 ;  #: role inheritance statement
    rdfs:label "temporary-resident inherits from resident"@en ;
    rbaco:RBACO_0000118 ex:def-temporary-resident ;     #: has senior role definition
    rbaco:RBACO_0000119 ex:def-resident .               #: has junior role definition

ex:inh-work-visa-temporary-resident a rbaco:RBACO_0000017 ;  #: role inheritance statement
    rdfs:label "work-visa inherits from temporary-resident"@en ;
    rbaco:RBACO_0000118 ex:def-work-visa ;              #: has senior role definition
    rbaco:RBACO_0000119 ex:def-temporary-resident .     #: has junior role definition

ex:inh-business-visa-temporary-resident a rbaco:RBACO_0000017 ;  #: role inheritance statement
    rdfs:label "business-visa inherits from temporary-resident"@en ;
    rbaco:RBACO_0000118 ex:def-business-visa ;          #: has senior role definition
    rbaco:RBACO_0000119 ex:def-temporary-resident .     #: has junior role definition

ex:inh-student-visa-temporary-resident a rbaco:RBACO_0000017 ;  #: role inheritance statement
    rdfs:label "student-visa inherits from temporary-resident"@en ;
    rbaco:RBACO_0000118 ex:def-student-visa ;           #: has senior role definition
    rbaco:RBACO_0000119 ex:def-temporary-resident .     #: has junior role definition

ex:op-vote a obo:IAO_0000104 ;                          #: plan specification
    rdfs:label "vote-casting procedure"@en .

ex:op-work a obo:IAO_0000104 ;                          #: plan specification
    rdfs:label "work procedure"@en .

ex:op-jury a obo:IAO_0000104 ;                          #: plan specification
    rdfs:label "jury service procedure"@en .

ex:perm-citizen-vote a rbaco:RBACO_0000007 ;            #: access permission
    rdfs:label "Citizen: permitted Vote"@en ;
    rbaco:RBACO_0000101 ex:op-vote ;                    #: has operation
    rbaco:RBACO_0000105 ex:def-citizen .                #: is assigned to role definition

ex:perm-citizen-work a rbaco:RBACO_0000007 ;            #: access permission
    rdfs:label "Citizen: permitted Work"@en ;
    rbaco:RBACO_0000101 ex:op-work ;                    #: has operation
    rbaco:RBACO_0000105 ex:def-citizen .                #: is assigned to role definition

ex:perm-citizen-jury a rbaco:RBACO_0000007 ;            #: access permission
    rdfs:label "Citizen: permitted Jury"@en ;
    rbaco:RBACO_0000101 ex:op-jury ;                    #: has operation
    rbaco:RBACO_0000105 ex:def-citizen .                #: is assigned to role definition

ex:perm-pr-work a rbaco:RBACO_0000007 ;                 #: access permission
    rdfs:label "Permanent Resident: permitted Work"@en ;
    rbaco:RBACO_0000101 ex:op-work ;                    #: has operation
    rbaco:RBACO_0000105 ex:def-permanent-resident .     #: is assigned to role definition

ex:perm-pra-work a rbaco:RBACO_0000007 ;                #: access permission
    rdfs:label "Perm Residency Applicant: permitted Work"@en ;
    rbaco:RBACO_0000101 ex:op-work ;                    #: has operation
    rbaco:RBACO_0000105 ex:def-pr-applicant .           #: is assigned to role definition

ex:perm-wvh-work a rbaco:RBACO_0000007 ;                #: access permission
    rdfs:label "Work Visa Holder: permitted Work"@en ;
    rbaco:RBACO_0000101 ex:op-work ;                    #: has operation
    rbaco:RBACO_0000105 ex:def-work-visa .              #: is assigned to role definition

ex:perm-bvh-work a rbaco:RBACO_0000007 ;                #: access permission
    rdfs:label "Business Visa Holder: permitted Work"@en ;
    rbaco:RBACO_0000101 ex:op-work ;                    #: has operation
    rbaco:RBACO_0000105 ex:def-business-visa .          #: is assigned to role definition

ex:proh-visitor-work a rbaco:RBACO_0000008 ;            #: access prohibition
    rdfs:label "Visitor: prohibited Work"@en ;
    rbaco:RBACO_0000101 ex:op-work ;                    #: has operation
    rbaco:RBACO_0000105 ex:def-visitor .                #: is assigned to role definition

ex:proh-svh-work a rbaco:RBACO_0000008 ;                #: access prohibition
    rdfs:label "Student Visa Holder: prohibited Work"@en ;
    rbaco:RBACO_0000101 ex:op-work ;                    #: has operation
    rbaco:RBACO_0000105 ex:def-student-visa .           #: is assigned to role definition

ex:ssd-resident-citizen a rbaco:RBACO_0000013 ;         #: static separation of duty constraint
    rdfs:label "SSD {Resident, Citizen}, n = 2"@en ;
    rbaco:RBACO_0000114 ex:def-citizen,                 #: has constrained role definition
        ex:def-resident ;
    rbaco:RBACO_0000201 "2"^^xsd:positiveInteger .      #: has cardinality

ex:ssd-pr-tr a rbaco:RBACO_0000013 ;                    #: static separation of duty constraint
    rdfs:label "SSD {Permanent Resident, Temporary Resident}, n = 2"@en ;
    rbaco:RBACO_0000114 ex:def-permanent-resident,      #: has constrained role definition
        ex:def-temporary-resident ;
    rbaco:RBACO_0000201 "2"^^xsd:positiveInteger .      #: has cardinality

ex:dsd-visitor-tr a rbaco:RBACO_0000015 ;               #: same-time dynamic separation of duty constraint
    rdfs:label "DSD {Visitor, Temporary Resident}, n = 2, global"@en ;
    rbaco:RBACO_0000114 ex:def-temporary-resident,      #: has constrained role definition
        ex:def-visitor ;
    rbaco:RBACO_0000201 "2"^^xsd:positiveInteger .      #: has cardinality

ex:plan-status-review a rbaco:RBACO_0000005 ;           #: business process plan
    rdfs:label "status eligibility review plan"@en .

ex:policy-load-start a obo:BFO_0000203 ;                #: temporal instant
    rbaco:RBACO_0000205 "2026-01-01T08:00:00+00:00"^^xsd:dateTime .  #: has timestamp

ex:policy-load-interval a obo:BFO_0000202 ;             #: temporal interval
    obo:BFO_0000222 ex:policy-load-start .              #: has first instant

ex:policy-load a rbaco:RBACO_0000031 ;                  #: policy issuing act
    rdfs:label "policy issuing act policy-load"@en ;
    obo:BFO_0000055 ex:officer-authority ;              #: realizes
    obo:BFO_0000199 ex:policy-load-interval ;           #: occupies temporal region
    cco:ont00001833 ex:officer ;                        #: has agent
    cco:ont00001986 ex:def-business-visa,               #: has output
        ex:def-citizen,
        ex:def-foreign-person,
        ex:def-legal-person,
        ex:def-permanent-resident,
        ex:def-pr-applicant,
        ex:def-resident,
        ex:def-student-visa,
        ex:def-temporary-resident,
        ex:def-us-person,
        ex:def-visitor,
        ex:def-work-visa,
        ex:dsd-visitor-tr,
        ex:inh-business-visa-temporary-resident,
        ex:inh-citizen-us-person,
        ex:inh-foreign-person-legal-person,
        ex:inh-permanent-resident-resident,
        ex:inh-pr-applicant-resident,
        ex:inh-resident-us-person,
        ex:inh-student-visa-temporary-resident,
        ex:inh-temporary-resident-resident,
        ex:inh-us-person-legal-person,
        ex:inh-visitor-us-person,
        ex:inh-work-visa-temporary-resident,
        ex:perm-bvh-work,
        ex:perm-citizen-jury,
        ex:perm-citizen-vote,
        ex:perm-citizen-work,
        ex:perm-pr-work,
        ex:perm-pra-work,
        ex:perm-wvh-work,
        ex:plan-status-review,
        ex:proh-svh-work,
        ex:proh-visitor-work,
        ex:ssd-pr-tr,
        ex:ssd-resident-citizen .

ex:alice a cco:ont00001262 ;                            #: Person
    rdfs:label "Alice"@en .

ex:bob a cco:ont00001262 ;                              #: Person
    rdfs:label "Bob"@en .

ex:alice-citizen-assigned-1 a rbaco:RBACO_0001004 ;     #: US citizen role
    rdfs:label "alice's assigned citizen role, tenure 1"@en ;
    obo:BFO_0000059 ex:def-citizen ;                    #: concretizes
    obo:BFO_0000197 ex:alice .                          #: inheres in

ex:alice-assign-citizen-1-start a obo:BFO_0000203 ;     #: temporal instant
    rbaco:RBACO_0000205 "2026-01-02T09:00:00+00:00"^^xsd:dateTime .  #: has timestamp

ex:alice-assign-citizen-1-interval a obo:BFO_0000202 ;  #: temporal interval
    obo:BFO_0000222 ex:alice-assign-citizen-1-start .   #: has first instant

ex:alice-assign-citizen-1 a rbaco:RBACO_0000028 ;       #: role assignment
    rdfs:label "assignment of alice to citizen"@en ;
    obo:BFO_0000055 ex:officer-authority ;              #: realizes
    obo:BFO_0000057 ex:alice ;                          #: has participant
    obo:BFO_0000199 ex:alice-assign-citizen-1-interval ;  #: occupies temporal region
    cco:ont00001833 ex:officer ;                        #: has agent
    cco:ont00001986 ex:alice-citizen-assigned-1 .       #: has output

ex:alice-permanent-resident-assigned-1 a rbaco:RBACO_0001007 ;  #: US permanent resident role
    rdfs:label "alice's assigned permanent-resident role, tenure 1"@en ;
    obo:BFO_0000059 ex:def-permanent-resident ;         #: concretizes
    obo:BFO_0000197 ex:alice .                          #: inheres in

ex:alice-assign-permanent-resident-1-start a obo:BFO_0000203 ;  #: temporal instant
    rbaco:RBACO_0000205 "2026-01-02T10:00:00+00:00"^^xsd:dateTime .  #: has timestamp

ex:alice-assign-permanent-resident-1-interval a obo:BFO_0000202 ;  #: temporal interval
    obo:BFO_0000222 ex:alice-assign-permanent-resident-1-start .  #: has first instant

ex:alice-assign-permanent-resident-1 a rbaco:RBACO_0000028 ;  #: role assignment
    rdfs:label "assignment of alice to permanent-resident"@en ;
    obo:BFO_0000055 ex:officer-authority ;              #: realizes
    obo:BFO_0000057 ex:alice ;                          #: has participant
    obo:BFO_0000199 ex:alice-assign-permanent-resident-1-interval ;  #: occupies temporal region
    cco:ont00001833 ex:officer ;                        #: has agent
    cco:ont00001986 ex:alice-permanent-resident-assigned-1 .  #: has output

ex:bob-visitor-assigned-1 a rbaco:RBACO_0001006 ;       #: US visitor role
    rdfs:label "bob's assigned visitor role, tenure 1"@en ;
    obo:BFO_0000059 ex:def-visitor ;                    #: concretizes
    obo:BFO_0000197 ex:bob .                            #: inheres in

ex:bob-assign-visitor-1-start a obo:BFO_0000203 ;       #: temporal instant
    rbaco:RBACO_0000205 "2026-01-02T09:00:00+00:00"^^xsd:dateTime .  #: has timestamp

ex:bob-assign-visitor-1-interval a obo:BFO_0000202 ;    #: temporal interval
    obo:BFO_0000222 ex:bob-assign-visitor-1-start .     #: has first instant

ex:bob-assign-visitor-1 a rbaco:RBACO_0000028 ;         #: role assignment
    rdfs:label "assignment of bob to visitor"@en ;
    obo:BFO_0000055 ex:officer-authority ;              #: realizes
    obo:BFO_0000057 ex:bob ;                            #: has participant
    obo:BFO_0000199 ex:bob-assign-visitor-1-interval ;  #: occupies temporal region
    cco:ont00001833 ex:officer ;                        #: has agent
    cco:ont00001986 ex:bob-visitor-assigned-1 .         #: has output

ex:bob-temporary-resident-assigned-1 a rbaco:RBACO_0001009 ;  #: US temporary resident role
    rdfs:label "bob's assigned temporary-resident role, tenure 1"@en ;
    obo:BFO_0000059 ex:def-temporary-resident ;         #: concretizes
    obo:BFO_0000197 ex:bob .                            #: inheres in

ex:bob-assign-temporary-resident-1-start a obo:BFO_0000203 ;  #: temporal instant
    rbaco:RBACO_0000205 "2026-01-02T10:00:00+00:00"^^xsd:dateTime .  #: has timestamp

ex:bob-assign-temporary-resident-1-interval a obo:BFO_0000202 ;  #: temporal interval
    obo:BFO_0000222 ex:bob-assign-temporary-resident-1-start .  #: has first instant

ex:bob-assign-temporary-resident-1 a rbaco:RBACO_0000028 ;  #: role assignment
    rdfs:label "assignment of bob to temporary-resident"@en ;
    obo:BFO_0000055 ex:officer-authority ;              #: realizes
    obo:BFO_0000057 ex:bob ;                            #: has participant
    obo:BFO_0000199 ex:bob-assign-temporary-resident-1-interval ;  #: occupies temporal region
    cco:ont00001833 ex:officer ;                        #: has agent
    cco:ont00001986 ex:bob-temporary-resident-assigned-1 .  #: has output

ex:alice-review-start a obo:BFO_0000203 ;               #: temporal instant
    rbaco:RBACO_0000205 "2026-01-05T09:00:00+00:00"^^xsd:dateTime .  #: has timestamp

ex:alice-review-end a obo:BFO_0000203 ;                 #: temporal instant
    rbaco:RBACO_0000205 "2026-01-05T17:00:00+00:00"^^xsd:dateTime .  #: has timestamp

ex:alice-review-interval a obo:BFO_0000202 ;            #: temporal interval
    obo:BFO_0000222 ex:alice-review-start ;             #: has first instant
    obo:BFO_0000224 ex:alice-review-end .               #: has last instant

ex:alice-review a rbaco:RBACO_0001016 ;                 #: status eligibility review
    rdfs:label "Alice's status eligibility review"@en ;
    obo:BFO_0000199 ex:alice-review-interval ;          #: occupies temporal region
    cco:ont00001920 ex:plan-status-review .             #: prescribed by

ex:alice-request-activate-citizen-1-start a obo:BFO_0000203 ;  #: temporal instant
    rbaco:RBACO_0000205 "2026-01-05T09:05:00+00:00"^^xsd:dateTime .  #: has timestamp

ex:alice-request-activate-citizen-1-interval a obo:BFO_0000202 ;  #: temporal interval
    obo:BFO_0000222 ex:alice-request-activate-citizen-1-start .  #: has first instant

ex:alice-activate-citizen-1-start a obo:BFO_0000203 ;   #: temporal instant
    rbaco:RBACO_0000205 "2026-01-05T09:05:00+00:00"^^xsd:dateTime .  #: has timestamp

ex:alice-activate-citizen-1-interval a obo:BFO_0000202 ;  #: temporal interval
    obo:BFO_0000222 ex:alice-activate-citizen-1-start .  #: has first instant

ex:alice-citizen-active-1 a rbaco:RBACO_0000003 ;       #: active role
    rdfs:label "alice's active citizen role in alice-review"@en ;
    obo:BFO_0000059 ex:def-citizen ;                    #: concretizes
    obo:BFO_0000195 ex:alice-citizen-assigned-1 ;       #: specifically depends on
    obo:BFO_0000197 ex:alice ;                          #: inheres in
    rbaco:RBACO_0000106 ex:alice-review .               #: is activated in

ex:alice-activate-citizen-1 a rbaco:RBACO_0000026 ;     #: role activation
    rdfs:label "activation of citizen by alice"@en ;
    obo:BFO_0000057 ex:alice ;                          #: has participant
    obo:BFO_0000132 ex:alice-review ;                   #: occurrent part of
    obo:BFO_0000199 ex:alice-activate-citizen-1-interval ;  #: occupies temporal region
    cco:ont00001986 ex:alice-citizen-active-1 .         #: has output

ex:alice-request-activate-citizen-1 a rbaco:RBACO_0000025 ;  #: role activation request
    rdfs:label "alice asks to activate citizen"@en ;
    obo:BFO_0000132 ex:alice-review ;                   #: occurrent part of
    obo:BFO_0000199 ex:alice-request-activate-citizen-1-interval ;  #: occupies temporal region
    rbaco:RBACO_0000107 ex:alice ;                      #: has requester
    rbaco:RBACO_0000110 ex:def-citizen ;                #: requests activation of
    rbaco:RBACO_0000111 ex:alice-activate-citizen-1 .   #: is fulfilled by

