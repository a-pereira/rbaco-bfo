@prefix ex: <https://example.org/rbaco/data/> .
@prefix rbaco: <https://w3id.org/rbaco/bfo/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:dana-req-approve-decision a rbaco:RBACO_0000023 ;    #: access denial
    rdfs:label "denial of https://example.org/rbaco/data/dana-req-approve" ;
    rbaco:RBACO_0000112 ex:dana-req-approve .           #: decides on

ex:dana-req-push-decision a rbaco:RBACO_0000022 ;       #: access grant
    rdfs:label "grant of https://example.org/rbaco/data/dana-req-push" ;
    rbaco:RBACO_0000112 ex:dana-req-push ;              #: decides on
    rbaco:RBACO_0000113 ex:perm-submitter-push .        #: cites regulation

ex:dana-request-activate-approver-1-dsd-conflict a rbaco:RBACO_0000020 ;  #: dynamic separation of duty conflict report
    rdfs:label "DSD conflict: https://example.org/rbaco/data/dana-request-activate-approver-1" ;
    rbaco:RBACO_0000124 ex:dana ;                       #: describes conflict subject
    rbaco:RBACO_0000125 ex:dsd-submitter-approver ;     #: describes violated constraint
    rbaco:RBACO_0000126 ex:def-approver,                #: describes conflicting role definition
        ex:def-submitter ;
    rbaco:RBACO_0000127 ex:cr-42 ;                      #: describes conflict instance
    rbaco:RBACO_0000128 ex:dana-request-activate-approver-1 ;  #: describes conflicting act
    rbaco:RBACO_0000204 "Violates DSD constraint DSD {Submitter, Approver}, n = 2, code change reviews, whole instance: the activation would give the requester 2 of its roles in one instance" .  #: has justification

ex:eve-req-approve-decision a rbaco:RBACO_0000022 ;     #: access grant
    rdfs:label "grant of https://example.org/rbaco/data/eve-req-approve" ;
    rbaco:RBACO_0000112 ex:eve-req-approve ;            #: decides on
    rbaco:RBACO_0000113 ex:perm-approver-approve .      #: cites regulation

