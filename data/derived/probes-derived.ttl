ex:harry-request-activate-sc-probe-8-task-dsd-conflict a rbo:RBO_0000020 ;  #: dynamic separation of duty conflict report
    rdfs:label "task DSD conflict: https://example.org/rbac-bfo/data/harry-request-activate-sc-probe-8" ;
    rbo:RBO_0000124 ex:harry ;                          #: describes conflict subject
    rbo:RBO_0000125 ex:tdsd-tasks ;                     #: describes violated constraint
    rbo:RBO_0000127 ex:probe-8 ;                        #: describes conflict instance
    rbo:RBO_0000128 ex:harry-request-activate-sc-probe-8 ;  #: describes conflicting act
    rbo:RBO_0000147 ex:ts-approve-order,                #: describes conflicting task specification
        ex:ts-prepare-requisition ;
    rbo:RBO_0000204 "Violates DSD constraint task DSD {prepare requisition, approve order}, n = 2, conflicting tasks plan: performing the task would give its principal, with any agent counted as one with them, 2 of its tasks in one instance" .  #: has justification

ex:probe-issue-inh-ssd-conflict-pssd-approve-audit-dick a rbo:RBO_0000019 ;  #: static separation of duty conflict report
    rdfs:label "SSD conflict: https://example.org/rbac-bfo/data/probe-issue-inh for https://example.org/rbac-bfo/data/dick" ;
    rbo:RBO_0000124 ex:dick ;                           #: describes conflict subject
    rbo:RBO_0000125 ex:pssd-approve-audit ;             #: describes violated constraint
    rbo:RBO_0000128 ex:probe-issue-inh ;                #: describes conflicting act
    rbo:RBO_0000146 ex:perm-apm-approve,                #: describes conflicting permission
        ex:perm-auditor-audit ;
    rbo:RBO_0000204 "Violates SSD constraint permission SSD {APM: approve order, Auditor: approve audit}, n = 2: the subject, with any agent counted as one with them, is authorized for 2 of its members (permissions with one operation and object scope count once)" .  #: has justification

