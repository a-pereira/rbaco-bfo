ex:approval-bot-request-activate-manager-po-11-task-dsd-conflict a rbaco:RBACO_0000020 ;  #: dynamic separation of duty conflict report
    rdfs:label "task DSD conflict: https://example.org/rbaco/data/approval-bot-request-activate-manager-po-11" ;
    rbaco:RBACO_0000124 ex:tom ;                        #: describes conflict subject
    rbaco:RBACO_0000125 ex:tdsd-internal ;              #: describes violated constraint
    rbaco:RBACO_0000127 ex:po-11 ;                      #: describes conflict instance
    rbaco:RBACO_0000128 ex:approval-bot-request-activate-manager-po-11 ;  #: describes conflicting act
    rbaco:RBACO_0000147 ex:ts-approve-po,               #: describes conflicting task specification
        ex:ts-complete-form ;
    rbaco:RBACO_0000204 "Violates DSD constraint task DSD {complete order form, approve purchase order}, n = 2, internal purchase orders: performing the task would give its principal, with any agent counted as one with them, 2 of its tasks in one instance" .  #: has justification

ex:dick-assign-auditor-1-ssd-conflict-pssd-approve-audit a rbaco:RBACO_0000019 ;  #: static separation of duty conflict report
    rdfs:label "SSD conflict: https://example.org/rbaco/data/dick-assign-auditor-1" ;
    rbaco:RBACO_0000124 ex:dick ;                       #: describes conflict subject
    rbaco:RBACO_0000125 ex:pssd-approve-audit ;         #: describes violated constraint
    rbaco:RBACO_0000128 ex:dick-assign-auditor-1 ;      #: describes conflicting act
    rbaco:RBACO_0000146 ex:perm-apm-approve,            #: describes conflicting permission
        ex:perm-auditor-audit ;
    rbaco:RBACO_0000204 "Violates SSD constraint permission SSD {APM: approve order, Auditor: approve audit}, n = 2: the assignee, with any agent counted as one with them, is authorized for 2 of its members (permissions with one operation and object scope count once)" .  #: has justification

ex:dick-assign-auditor-1-ssd-conflict-ssd-auditor-apm a rbaco:RBACO_0000019 ;  #: static separation of duty conflict report
    rdfs:label "SSD conflict: https://example.org/rbaco/data/dick-assign-auditor-1" ;
    rbaco:RBACO_0000124 ex:dick ;                       #: describes conflict subject
    rbaco:RBACO_0000125 ex:ssd-auditor-apm ;            #: describes violated constraint
    rbaco:RBACO_0000126 ex:def-apm,                     #: describes conflicting role definition
        ex:def-auditor ;
    rbaco:RBACO_0000128 ex:dick-assign-auditor-1 ;      #: describes conflicting act
    rbaco:RBACO_0000204 "Violates SSD constraint SSD {Auditor, APM}, n = 2: the assignee, with any agent counted as one with them, is authorized for 2 of its members" .  #: has justification

ex:dick-assign-auditor-1-ssd-conflict-tssd-approve-audit a rbaco:RBACO_0000019 ;  #: static separation of duty conflict report
