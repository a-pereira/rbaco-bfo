    rdfs:label "dana asks to activate approver"@en ;
    obo:BFO_0000132 ex:cr-42 ;                          #: occurrent part of
    obo:BFO_0000199 ex:dana-request-activate-approver-1-interval ;  #: occupies temporal region
    rbo:RBO_0000107 ex:dana ;                           #: has requester
    rbo:RBO_0000110 ex:def-approver .                   #: requests activation of

ex:dana-req-approve-start a obo:BFO_0000203 ;           #: temporal instant
    rbo:RBO_0000205 "2026-01-06T12:06:00+00:00"^^xsd:dateTime .  #: has timestamp

ex:dana-req-approve-interval a obo:BFO_0000202 ;        #: temporal interval
    obo:BFO_0000222 ex:dana-req-approve-start .         #: has first instant

ex:dana-req-approve a rbo:RBO_0000024 ;                 #: access request
    rdfs:label "dana asks to op-approve-merge on change-42"@en ;
    obo:BFO_0000132 ex:cr-42 ;                          #: occurrent part of
