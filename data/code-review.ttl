    rbo:RBO_0000205 "2026-01-06T12:00:00+00:00"^^xsd:dateTime .  #: has timestamp

ex:dana-deactivate-submitter-1-interval a obo:BFO_0000202 ;  #: temporal interval
    obo:BFO_0000222 ex:dana-deactivate-submitter-1-start .  #: has first instant

ex:dana-deactivate-submitter-1 a rbo:RBO_0000027 ;      #: role deactivation
    rdfs:label "deactivation of submitter by dana"@en ;
    obo:BFO_0000057 ex:dana ;                           #: has participant
    obo:BFO_0000132 ex:cr-42 ;                          #: occurrent part of
