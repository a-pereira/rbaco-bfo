    rbo:RBO_0000205 "2026-01-06T12:05:00+00:00"^^xsd:dateTime .  #: has timestamp

ex:dana-request-activate-approver-1-interval a obo:BFO_0000202 ;  #: temporal interval
    obo:BFO_0000222 ex:dana-request-activate-approver-1-start .  #: has first instant

