ex:eve-request-activate-approver-1 a rbo:RBO_0000025 ;  #: role activation request
    rdfs:label "eve asks to activate approver"@en ;
    obo:BFO_0000132 ex:cr-42 ;                          #: occurrent part of
    obo:BFO_0000199 ex:eve-request-activate-approver-1-interval ;  #: occupies temporal region
    rbo:RBO_0000107 ex:eve ;                            #: has requester
    rbo:RBO_0000110 ex:def-approver ;                   #: requests activation of
    rbo:RBO_0000111 ex:eve-activate-approver-1 .        #: is fulfilled by

ex:eve-req-approve-start a obo:BFO_0000203 ;            #: temporal instant
    rbo:RBO_0000205 "2026-01-06T11:05:00+00:00"^^xsd:dateTime .  #: has timestamp

ex:eve-req-approve-interval a obo:BFO_0000202 ;         #: temporal interval
    obo:BFO_0000222 ex:eve-req-approve-start .          #: has first instant

ex:eve-req-approve a rbo:RBO_0000024 ;                  #: access request
    rdfs:label "eve asks to op-approve-merge on change-42"@en ;
    obo:BFO_0000132 ex:cr-42 ;                          #: occurrent part of
    obo:BFO_0000199 ex:eve-req-approve-interval ;       #: occupies temporal region
    rbo:RBO_0000107 ex:eve ;                            #: has requester
    rbo:RBO_0000108 ex:op-approve-merge ;               #: requests operation
    rbo:RBO_0000109 ex:change-42 .                      #: requests access to

ex:eve-deactivate-approver-1-start a obo:BFO_0000203 ;  #: temporal instant
    rbo:RBO_0000205 "2026-01-06T11:10:00+00:00"^^xsd:dateTime .  #: has timestamp

ex:eve-deactivate-approver-1-interval a obo:BFO_0000202 ;  #: temporal interval
    obo:BFO_0000222 ex:eve-deactivate-approver-1-start .  #: has first instant

ex:eve-deactivate-approver-1 a rbo:RBO_0000027 ;        #: role deactivation
    rdfs:label "deactivation of approver by eve"@en ;
