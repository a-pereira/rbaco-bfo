    obo:BFO_0000197 ex:eve ;                            #: inheres in
    rbo:RBO_0000106 ex:cr-42 .                          #: is activated in

ex:eve-activate-approver-1 a rbo:RBO_0000026 ;          #: role activation
    rdfs:label "activation of approver by eve"@en ;
    obo:BFO_0000057 ex:eve ;                            #: has participant
    obo:BFO_0000132 ex:cr-42 ;                          #: occurrent part of
    obo:BFO_0000199 ex:eve-activate-approver-1-interval ;  #: occupies temporal region
