ex:eve-activate-approver-1-interval a obo:BFO_0000202 ;  #: temporal interval
    obo:BFO_0000222 ex:eve-activate-approver-1-start .  #: has first instant

ex:eve-approver-active-1 a rbo:RBO_0000003 ;            #: active role
