    rdfs:label "tom's active sc role in probe-1"@en ;
    obo:BFO_0000059 ex:def-sc ;                         #: concretizes
    obo:BFO_0000195 ex:tom-apm-assigned-1 ;             #: specifically depends on
    obo:BFO_0000197 ex:tom ;                            #: inheres in
    rbaco:RBACO_0000106 ex:probe-1 .                    #: is activated in

ex:tom-activate-sc-probe-1 a rbaco:RBACO_0000026 ;      #: role activation
    rdfs:label "activation of sc by tom"@en ;
    obo:BFO_0000057 ex:tom ;                            #: has participant
    obo:BFO_0000132 ex:probe-1 ;                        #: occurrent part of
    obo:BFO_0000199 ex:tom-activate-sc-probe-1-interval ;  #: occupies temporal region
    cco:ont00001986 ex:tom-sc-active-probe-1 .          #: has output

