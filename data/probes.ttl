@prefix cco: <https://www.commoncoreontologies.org/> .
@prefix ex: <https://example.org/rbaco/data/> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rbaco: <https://w3id.org/rbaco/bfo/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:probes a owl:Ontology ;
    rdfs:comment "Regression probes for the remediations of 2026-10-31, read together with purchase.ttl: permissions identified by content (probes 1 and 2), access requests at one instant (3), an active role ending with the assigned role it depends on (4), designations counted only while in force (5 and 6), static separation of duty at an issuing act (7), and activation requests at one instant (8). Each probe has an instance or act of its own; tools/run_queries.py checks the results each must give."@en ;
    owl:imports rbaco:rbaco-bfo-domain.owl .            #: RBACO-BFO domain module: ROWLBAC scenario and attribute examples

ex:probe-plan-2 a rbaco:RBACO_0000005 ;                 #: business process plan
    rdfs:label "probe 2 plan"@en .

ex:probe-plan-4 a rbaco:RBACO_0000005 ;                 #: business process plan
    rdfs:label "probe 4 plan"@en .

ex:probe-pdsd-2 a rbaco:RBACO_0000016 ;                 #: whole-instance dynamic separation of duty constraint
    rdfs:label "permission DSD {SC: create requisition, APM: approve order, Approver: approve order}, n = 2, probe 2 plan"@en ;
    rbaco:RBACO_0000115 ex:probe-plan-2 ;               #: applies within
    rbaco:RBACO_0000134 ex:perm-apm-approve,            #: has constrained permission
        ex:perm-approver-approve,
        ex:perm-sc-requisition ;
    rbaco:RBACO_0000201 "2"^^xsd:positiveInteger .      #: has cardinality

ex:probe-policy-start a obo:BFO_0000203 ;               #: temporal instant
    rbaco:RBACO_0000205 "2026-02-01T08:00:00+00:00"^^xsd:dateTime .  #: has timestamp

ex:probe-policy-interval a obo:BFO_0000202 ;            #: temporal interval
    obo:BFO_0000222 ex:probe-policy-start .             #: has first instant

ex:probe-policy a rbaco:RBACO_0000031 ;                 #: policy issuing act
    rdfs:label "policy issuing act probe-policy"@en ;
    obo:BFO_0000055 ex:officer-authority ;              #: realizes
    obo:BFO_0000199 ex:probe-policy-interval ;          #: occupies temporal region
    cco:ont00001833 ex:officer ;                        #: has agent
    cco:ont00001986 ex:probe-pdsd-2,                    #: has output
        ex:probe-plan-2,
        ex:probe-plan-4 .

ex:probe-1-start a obo:BFO_0000203 ;                    #: temporal instant
