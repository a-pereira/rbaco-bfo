formulas(assumptions).
isa_rbaco_dsd_constraint(c_pd, c_u). rbaco_has_cardinality(c_pd, 2). -(exists p rbaco_applies_within(c_pd, p)) # label(fact0).
rbaco_constrains_permission(c_pd, c_preq). rbaco_constrains_permission(c_pd, c_papm) # label(fact1).
(all p (rbaco_constrains_permission(c_pd, p) -> p = c_preq | p = c_papm)) # label(fact2).
(all o (rbaco_has_operation(c_preq, o) <-> o = c_create)). rbaco_has_operation(c_papm, c_approve). c_create != c_approve # label(fact3).
-(exists b rbaco_has_access_object(c_preq, b)). -(exists e rbaco_has_object_description(c_preq, e)) # label(fact4).
isa_rbaco_business_process(c_po, c_u). rbaco_in_force(c_pd, c_t) # label(fact5).
isa_rbaco_role_definition(c_dsc, c_t). isa_rbaco_role_definition(c_dbuy, c_t). isa_rbaco_role_definition(c_dapm, c_t) # label(fact6).
rbaco_in_force(c_s1, c_t). rbaco_has_senior(c_s1, c_dapm). rbaco_has_junior(c_s1, c_dbuy) # label(fact7).
rbaco_in_force(c_s2, c_t). rbaco_has_senior(c_s2, c_dbuy). rbaco_has_junior(c_s2, c_dsc) # label(fact8).
rbaco_in_force(c_dsc, c_t). rbaco_in_force(c_dbuy, c_t). rbaco_in_force(c_dapm, c_t) # label(fact9).
isa_rbaco_active_role(c_a, c_t). inheres_in(c_a, c_tom). rbaco_activated_in(c_a, c_po). concretizes(c_a, c_dapm, c_t) # label(fact10).
rbaco_has_requester(c_q1, c_tom). -(exists y rbaco_on_behalf_of(c_q1, y)). occurrent_part_of(c_q1, c_po) # label(fact11).
occupies_temporal_region(c_q1, c_uq1). has_first_instant(c_uq1, c_t). (all o (rbaco_requests_operation(c_q1, o) <-> o = c_approve)) # label(fact12).
rbaco_decides_on(c_d1, c_q1). isa_rbaco_access_grant(c_d1, c_t). rbaco_cites(c_d1, c_papm) # label(fact13).
rbaco_has_requester(c_q2, c_tom). -(exists y rbaco_on_behalf_of(c_q2, y)). occurrent_part_of(c_q2, c_po) # label(fact14).
occupies_temporal_region(c_q2, c_uq2). has_first_instant(c_uq2, c_t). rbaco_requests_operation(c_q2, c_create) # label(fact15).
-(exists b rbaco_requests_access_to(c_q2, b)) # label(fact16).
(all k all u -(occurrent_part_of(c_q2, k) & isa_rbaco_task_instance(k, u))) # label(fact17).
isa_rbaco_access_permission(c_preq, c_t). rbaco_in_force(c_preq, c_t). rbaco_assigned_to(c_preq, c_dsc) # label(fact18).
rbaco_decided_before(c_q1, c_q2). (all q -rbaco_decided_before(q, c_q1)) # label(fact19).
end_of_list.
