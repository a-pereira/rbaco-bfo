assign(max_seconds, 300).
assign(max_megs, 6000).
assign(start_size, 2).
assign(end_size, 24).
formulas(assumptions).
(all x_r all x_t (isa_rbaco_assigned_role(x_r, x_t) <-> (isa_role(x_r, x_t) & (exists x_d (isa_rbaco_role_definition(x_d, x_t) & concretizes(x_r, x_d, x_t))) & -(isa_rbaco_active_role(x_r, x_t))))) # label(rbaco_r1).
(all x_a all x_t (isa_rbaco_active_role(x_a, x_t) -> (isa_role(x_a, x_t) & (exists x_d exists x_x (isa_rbaco_role_definition(x_d, x_t) & concretizes(x_a, x_d, x_t) & inheres_in(x_a, x_x) & rbaco_authorized_for(x_x, x_d, x_t)))))) # label(rbaco_r2).
(all x_a all x_t (isa_rbaco_active_role(x_a, x_t) -> (exists x_i (rbaco_activated_in(x_a, x_i) & isa_rbaco_business_process(x_i, x_t) & (all x_j (rbaco_activated_in(x_a, x_j) -> (x_j = x_i))))))) # label(rbaco_r3).
(all x_a all x_i all x_x all x_t ((rbaco_activated_in(x_a, x_i) & inheres_in(x_a, x_x) & exists_at(x_a, x_t) & (exists x_u (occupies_temporal_region(x_i, x_u) & temporal_part_of(x_t, x_u)))) -> participates_in(x_x, x_i, x_t))) # label(rbaco_r4).
(all x_d1 all x_d2 all x_t (rbaco_senior_to(x_d1, x_d2, x_t) <-> ((exists x_s (rbaco_in_force(x_s, x_t) & rbaco_has_senior(x_s, x_d1) & rbaco_has_junior(x_s, x_d2) & rbaco_in_force(x_d1, x_t) & rbaco_in_force(x_d2, x_t))) | (exists x_d3 (rbaco_senior_to(x_d1, x_d3, x_t) & rbaco_senior_to(x_d3, x_d2, x_t)))))) # label(rbaco_h1).
(all x_d1 all x_d2 all x_t (rbaco_senior_or_same(x_d1, x_d2, x_t) <-> (((x_d1 = x_d2) & isa_rbaco_role_definition(x_d1, x_t)) | rbaco_senior_to(x_d1, x_d2, x_t)))) # label(rbaco_h2).
(all x_x all x_d all x_t (rbaco_authorized_for(x_x, x_d, x_t) <-> (exists x_r exists x_e (isa_rbaco_assigned_role(x_r, x_t) & inheres_in(x_r, x_x) & concretizes(x_r, x_e, x_t) & rbaco_in_force(x_e, x_t) & rbaco_senior_or_same(x_e, x_d, x_t))))) # label(rbaco_h3).
(all x_d all x_t -(rbaco_senior_to(x_d, x_d, x_t))) # label(rbaco_h4).
(all x_x all x_c all x_t ((isa_rbaco_ssd_constraint(x_c, x_t) & rbaco_has_cardinality(x_c, 2)) -> (rbaco_violates_ssd(x_x, x_c, x_t) <-> (exists x_d1 exists x_d2 exists x_y1 exists x_y2 (rbaco_in_force(x_c, x_t) & -((x_d1 = x_d2)) & rbaco_constrains(x_c, x_d1) & rbaco_constrains(x_c, x_d2) & rbaco_authorized_for(x_y1, x_d1, x_t) & rbaco_authorized_for(x_y2, x_d2, x_t) & rbaco_same_static_subject(x_x, x_y1, x_c, x_t) & rbaco_same_static_subject(x_x, x_y2, x_c, x_t)))))) # label(rbaco_s1).
(all x_c all x_i (rbaco_scope_fits(x_c, x_i) <-> (-((exists x_p rbaco_applies_within(x_c, x_p))) | (exists x_p (rbaco_applies_within(x_c, x_p) & cco_prescribed_by(x_i, x_p)))))) # label(rbaco_s2).
(all x_x all x_d all x_i all x_t (rbaco_explicitly_active(x_x, x_d, x_i, x_t) <-> (exists x_a (isa_rbaco_active_role(x_a, x_t) & inheres_in(x_a, x_x) & rbaco_activated_in(x_a, x_i) & concretizes(x_a, x_d, x_t))))) # label(rbaco_s3).
(all x_x all x_c all x_i (((exists x_t isa_rbaco_same_time_dsd(x_c, x_t)) & rbaco_has_cardinality(x_c, 2)) -> (rbaco_violates_dsd(x_x, x_c, x_i) <-> (exists x_d1 exists x_d2 exists x_t exists x_y1 exists x_y2 (rbaco_in_force(x_c, x_t) & -((x_d1 = x_d2)) & rbaco_constrains(x_c, x_d1) & rbaco_constrains(x_c, x_d2) & rbaco_scope_fits(x_c, x_i) & rbaco_explicitly_active(x_y1, x_d1, x_i, x_t) & rbaco_explicitly_active(x_y2, x_d2, x_i, x_t) & rbaco_same_dynamic_subject(x_x, x_y1, x_c, x_i, x_t) & rbaco_same_dynamic_subject(x_x, x_y2, x_c, x_i, x_t)))))) # label(rbaco_s4).
(all x_x all x_c all x_i (((exists x_t isa_rbaco_whole_instance_dsd(x_c, x_t)) & rbaco_has_cardinality(x_c, 2)) -> (rbaco_violates_dsd(x_x, x_c, x_i) <-> (exists x_d1 exists x_d2 exists x_t1 exists x_t2 exists x_y1 exists x_y2 (-((x_d1 = x_d2)) & rbaco_constrains(x_c, x_d1) & rbaco_constrains(x_c, x_d2) & rbaco_scope_fits(x_c, x_i) & ((x_t1 = x_t2) | precedes(x_t1, x_t2)) & rbaco_in_force(x_c, x_t2) & rbaco_explicitly_active(x_y1, x_d1, x_i, x_t1) & rbaco_explicitly_active(x_y2, x_d2, x_i, x_t2) & rbaco_same_dynamic_subject(x_x, x_y1, x_c, x_i, x_t2) & rbaco_same_dynamic_subject(x_x, x_y2, x_c, x_i, x_t2)))))) # label(rbaco_s5).
(all x_x all x_c all x_i all x_d1 all x_d2 all x_t ((-((x_d1 = x_d2)) & rbaco_constrains(x_c, x_d1) & rbaco_constrains(x_c, x_d2) & rbaco_scope_fits(x_c, x_i) & rbaco_explicitly_active(x_x, x_d1, x_i, x_t) & rbaco_explicitly_active(x_x, x_d2, x_i, x_t) & rbaco_in_force(x_c, x_t) & (exists x_u isa_rbaco_whole_instance_dsd(x_c, x_u)) & rbaco_has_cardinality(x_c, 2)) -> rbaco_violates_dsd(x_x, x_c, x_i))) # label(rbaco_s6).
(all x_q all x_t (rbaco_request_time(x_q, x_t) <-> (exists x_u (occupies_temporal_region(x_q, x_u) & has_first_instant(x_u, x_t))))) # label(rbaco_a1).
(all x_x all x_d all x_i all x_t (rbaco_active_for(x_x, x_d, x_i, x_t) <-> (exists x_a exists x_e (isa_rbaco_active_role(x_a, x_t) & inheres_in(x_a, x_x) & rbaco_activated_in(x_a, x_i) & concretizes(x_a, x_e, x_t) & rbaco_in_force(x_e, x_t) & rbaco_senior_or_same(x_e, x_d, x_t))))) # label(rbaco_a0).
(all x_x all x_d all x_q all x_i all x_t (rbaco_active_for_request(x_x, x_d, x_q, x_i, x_t) <-> (exists x_a exists x_e (isa_rbaco_active_role(x_a, x_t) & inheres_in(x_a, x_x) & rbaco_activated_in(x_a, x_i) & concretizes(x_a, x_e, x_t) & rbaco_in_force(x_e, x_t) & rbaco_senior_or_same(x_e, x_d, x_t) & (all x_k ((occurrent_part_of(x_q, x_k) & (exists x_u isa_rbaco_task_instance(x_k, x_u))) -> rbaco_activated_for(x_a, x_k))))))) # label(rbaco_a4).
(all x_g all x_q (rbaco_covers(x_g, x_q) <-> (exists x_x exists x_i exists x_d exists x_o exists x_t (rbaco_has_requester(x_q, x_x) & occurrent_part_of(x_q, x_i) & rbaco_request_time(x_q, x_t) & rbaco_in_force(x_g, x_t) & rbaco_has_operation(x_g, x_o) & rbaco_requests_operation(x_q, x_o) & rbaco_assigned_to(x_g, x_d) & rbaco_active_for_request(x_x, x_d, x_q, x_i, x_t) & ((exists x_b (rbaco_has_access_object(x_g, x_b) & rbaco_requests_access_to(x_q, x_b))) | (-((exists x_b rbaco_has_access_object(x_g, x_b))) & -((exists x_e rbaco_has_object_description(x_g, x_e))) & -((exists x_b rbaco_requests_access_to(x_q, x_b)))) | (exists x_e exists x_b (rbaco_has_object_description(x_g, x_e) & rbaco_requests_access_to(x_q, x_b) & rbaco_meets_description(x_b, x_e, x_q)))))))) # label(rbaco_a2).
(all x_q (rbaco_warrants_grant(x_q) <-> ((exists x_g ((exists x_t isa_rbaco_access_permission(x_g, x_t)) & rbaco_covers(x_g, x_q))) & -((exists x_h ((exists x_t isa_rbaco_access_prohibition(x_h, x_t)) & rbaco_covers(x_h, x_q)))) & -((exists x_h rbaco_violates_task_binding(x_h, x_q))) & -((exists x_c rbaco_refuses_permission_dsd(x_c, x_q)))))) # label(rbaco_a3).
(all x_e all x_x (rbaco_principal(x_e, x_x) <-> (rbaco_on_behalf_of(x_e, x_x) | (cco_has_agent(x_e, x_x) & -((exists x_y rbaco_on_behalf_of(x_e, x_y))))))) # label(rbaco_p1).
(all x_q all x_x (rbaco_has_requester(x_q, x_x) -> cco_has_agent(x_q, x_x))) # label(rbaco_p2).
(all x_g all x_c (rbaco_designation_applies(x_g, x_c) <-> ((((exists x_t isa_rbaco_static_designation(x_g, x_t)) & (exists x_t isa_rbaco_ssd_constraint(x_c, x_t))) | ((exists x_t isa_rbaco_dynamic_designation(x_g, x_t)) & (exists x_t isa_rbaco_dsd_constraint(x_c, x_t)))) & (-((exists x_c2 rbaco_applies_to_constraint(x_g, x_c2))) | rbaco_applies_to_constraint(x_g, x_c))))) # label(rbaco_u1).
(all x_g all x_x all x_t (rbaco_designates(x_g, x_x, x_t) <-> (rbaco_designates_agent(x_g, x_x) | (exists x_m (rbaco_designates_group(x_g, x_m) & member_part_of(x_x, x_m, x_t)))))) # label(rbaco_u2).
(all x_x all x_y all x_c all x_t (rbaco_same_static_subject(x_x, x_y, x_c, x_t) <-> ((x_x = x_y) | (exists x_g (rbaco_designation_applies(x_g, x_c) & rbaco_in_force(x_g, x_t) & rbaco_designates(x_g, x_x, x_t) & rbaco_designates(x_g, x_y, x_t)))))) # label(rbaco_u3).
(all x_x all x_y all x_c all x_i all x_t (rbaco_same_dynamic_subject(x_x, x_y, x_c, x_i, x_t) <-> ((x_x = x_y) | (exists x_g (rbaco_designation_applies(x_g, x_c) & rbaco_scope_fits(x_g, x_i) & rbaco_in_force(x_g, x_t) & rbaco_designates(x_g, x_x, x_t) & rbaco_designates(x_g, x_y, x_t)))))) # label(rbaco_u4).
(all x_s all x_t (isa_rbaco_task_specification(x_s, x_t) -> ((exists x_d rbaco_requires_role(x_s, x_d)) & (all x_d1 all x_d2 ((rbaco_requires_role(x_s, x_d1) & rbaco_requires_role(x_s, x_d2)) -> (x_d1 = x_d2)))))) # label(rbaco_k1).
(all x_a all x_k all x_i ((rbaco_activated_for(x_a, x_k) & rbaco_activated_in(x_a, x_i)) -> occurrent_part_of(x_k, x_i))) # label(rbaco_k2).
(all x_a all x_k all x_s all x_d all x_t ((rbaco_activated_for(x_a, x_k) & cco_prescribed_by(x_k, x_s) & rbaco_requires_role(x_s, x_d) & exists_at(x_a, x_t)) -> (concretizes(x_a, x_d, x_t) & (all x_x (inheres_in(x_a, x_x) -> cco_has_agent(x_k, x_x)))))) # label(rbaco_k3).
(all x_p1 all x_p2 (rbaco_same_content(x_p1, x_p2) <-> ((all x_o (rbaco_has_operation(x_p1, x_o) <-> rbaco_has_operation(x_p2, x_o))) & (all x_b (rbaco_has_access_object(x_p1, x_b) <-> rbaco_has_access_object(x_p2, x_b))) & (all x_e (rbaco_has_object_description(x_p1, x_e) <-> rbaco_has_object_description(x_p2, x_e)))))) # label(rbaco_s17).
(all x_x all x_p all x_t (rbaco_authorized_for_permission(x_x, x_p, x_t) <-> (exists x_g exists x_d (isa_rbaco_access_permission(x_g, x_t) & rbaco_in_force(x_g, x_t) & rbaco_same_content(x_g, x_p) & rbaco_assigned_to(x_g, x_d) & rbaco_authorized_for(x_x, x_d, x_t))))) # label(rbaco_s7).
(all x_x all x_c all x_t ((isa_rbaco_ssd_constraint(x_c, x_t) & rbaco_has_cardinality(x_c, 2)) -> (rbaco_violates_permission_ssd(x_x, x_c, x_t) <-> (exists x_p1 exists x_p2 exists x_y1 exists x_y2 (rbaco_in_force(x_c, x_t) & -(rbaco_same_content(x_p1, x_p2)) & rbaco_constrains_permission(x_c, x_p1) & rbaco_constrains_permission(x_c, x_p2) & rbaco_authorized_for_permission(x_y1, x_p1, x_t) & rbaco_authorized_for_permission(x_y2, x_p2, x_t) & rbaco_same_static_subject(x_x, x_y1, x_c, x_t) & rbaco_same_static_subject(x_x, x_y2, x_c, x_t)))))) # label(rbaco_s8).
(all x_x all x_p all x_i (rbaco_exercised(x_x, x_p, x_i) <-> (exists x_q exists x_d exists x_g (occurrent_part_of(x_q, x_i) & rbaco_principal(x_q, x_x) & rbaco_decides_on(x_d, x_q) & (exists x_t isa_rbaco_access_grant(x_d, x_t)) & rbaco_cites(x_d, x_g) & rbaco_same_content(x_g, x_p))))) # label(rbaco_s9).
(all x_x all x_c all x_i (((exists x_t isa_rbaco_dsd_constraint(x_c, x_t)) & rbaco_has_cardinality(x_c, 2)) -> (rbaco_violates_permission_dsd(x_x, x_c, x_i) <-> (exists x_p1 exists x_p2 exists x_y1 exists x_y2 exists x_t (rbaco_in_force(x_c, x_t) & -(rbaco_same_content(x_p1, x_p2)) & rbaco_constrains_permission(x_c, x_p1) & rbaco_constrains_permission(x_c, x_p2) & rbaco_scope_fits(x_c, x_i) & rbaco_exercised(x_y1, x_p1, x_i) & rbaco_exercised(x_y2, x_p2, x_i) & rbaco_same_dynamic_subject(x_x, x_y1, x_c, x_i, x_t) & rbaco_same_dynamic_subject(x_x, x_y2, x_c, x_i, x_t)))))) # label(rbaco_s10).
(all x_p all x_q (rbaco_hits(x_p, x_q) <-> (exists x_g exists x_t (isa_rbaco_access_permission(x_g, x_t) & rbaco_covers(x_g, x_q) & rbaco_same_content(x_g, x_p))))) # label(rbaco_s18).
(all x_y all x_p all x_q all x_i (rbaco_exercised_before(x_y, x_p, x_q, x_i) <-> (exists x_q2 exists x_d exists x_g (occurrent_part_of(x_q2, x_i) & rbaco_principal(x_q2, x_y) & rbaco_decided_before(x_q2, x_q) & rbaco_decides_on(x_d, x_q2) & (exists x_t isa_rbaco_access_grant(x_d, x_t)) & rbaco_cites(x_d, x_g) & rbaco_same_content(x_g, x_p))))) # label(rbaco_s16).
(all x_c all x_q ((rbaco_refuses_permission_dsd(x_c, x_q) -> (exists x_t isa_rbaco_dsd_constraint(x_c, x_t))) & (((exists x_t isa_rbaco_dsd_constraint(x_c, x_t)) & rbaco_has_cardinality(x_c, 2)) -> (rbaco_refuses_permission_dsd(x_c, x_q) <-> (exists x_x exists x_i exists x_t exists x_p1 exists x_p2 (rbaco_principal(x_q, x_x) & occurrent_part_of(x_q, x_i) & (exists x_u isa_rbaco_business_process(x_i, x_u)) & rbaco_request_time(x_q, x_t) & rbaco_in_force(x_c, x_t) & rbaco_scope_fits(x_c, x_i) & rbaco_constrains_permission(x_c, x_p1) & rbaco_constrains_permission(x_c, x_p2) & -(rbaco_same_content(x_p1, x_p2)) & rbaco_hits(x_p1, x_q) & (rbaco_hits(x_p2, x_q) | (exists x_y (rbaco_exercised_before(x_y, x_p2, x_q, x_i) & rbaco_same_dynamic_subject(x_x, x_y, x_c, x_i, x_t)))))))))) # label(rbaco_s15).
(all x_x all x_s all x_t (rbaco_authorized_for_task(x_x, x_s, x_t) <-> (exists x_d (rbaco_requires_role(x_s, x_d) & rbaco_authorized_for(x_x, x_d, x_t))))) # label(rbaco_s11).
(all x_x all x_c all x_t ((isa_rbaco_ssd_constraint(x_c, x_t) & rbaco_has_cardinality(x_c, 2)) -> (rbaco_violates_task_ssd(x_x, x_c, x_t) <-> (exists x_s1 exists x_s2 exists x_y1 exists x_y2 (rbaco_in_force(x_c, x_t) & -((x_s1 = x_s2)) & rbaco_constrains_task(x_c, x_s1) & rbaco_constrains_task(x_c, x_s2) & rbaco_authorized_for_task(x_y1, x_s1, x_t) & rbaco_authorized_for_task(x_y2, x_s2, x_t) & rbaco_same_static_subject(x_x, x_y1, x_c, x_t) & rbaco_same_static_subject(x_x, x_y2, x_c, x_t)))))) # label(rbaco_s12).
(all x_x all x_s all x_i (rbaco_performed(x_x, x_s, x_i) <-> (exists x_k (occurrent_part_of(x_k, x_i) & cco_prescribed_by(x_k, x_s) & rbaco_principal(x_k, x_x))))) # label(rbaco_s13).
(all x_x all x_c all x_i (((exists x_t isa_rbaco_dsd_constraint(x_c, x_t)) & rbaco_has_cardinality(x_c, 2)) -> (rbaco_violates_task_dsd(x_x, x_c, x_i) <-> (exists x_s1 exists x_s2 exists x_y1 exists x_y2 exists x_t (rbaco_in_force(x_c, x_t) & -((x_s1 = x_s2)) & rbaco_constrains_task(x_c, x_s1) & rbaco_constrains_task(x_c, x_s2) & rbaco_scope_fits(x_c, x_i) & rbaco_performed(x_y1, x_s1, x_i) & rbaco_performed(x_y2, x_s2, x_i) & rbaco_same_dynamic_subject(x_x, x_y1, x_c, x_i, x_t) & rbaco_same_dynamic_subject(x_x, x_y2, x_c, x_i, x_t)))))) # label(rbaco_s14).
(all x_h all x_k (rbaco_violates_human_requirement(x_h, x_k) <-> (exists x_s exists x_i exists x_x exists x_u exists x_t0 (rbaco_requires_human(x_h, x_s) & cco_prescribed_by(x_k, x_s) & occurrent_part_of(x_k, x_i) & rbaco_scope_fits(x_h, x_i) & occupies_temporal_region(x_k, x_u) & has_first_instant(x_u, x_t0) & rbaco_in_force(x_h, x_t0) & cco_has_agent(x_k, x_x) & -((exists x_t isa_cco_person(x_x, x_t))))))) # label(rbaco_g1).
(all x_k (rbaco_violates_prior_guard(x_k) <-> (exists x_s1 exists x_s2 exists x_i ((exists x_u isa_rbaco_task_instance(x_k, x_u)) & cco_prescribed_by(x_k, x_s2) & rbaco_requires_prior(x_s2, x_s1) & occurrent_part_of(x_k, x_i) & -((exists x_k1 exists x_x (cco_prescribed_by(x_k1, x_s1) & occurrent_part_of(x_k1, x_i) & precedes(x_k1, x_k) & cco_has_agent(x_k1, x_x) & (exists x_t isa_cco_person(x_x, x_t))))))))) # label(rbaco_g2).
(all x_h all x_q (rbaco_violates_task_binding(x_h, x_q) <-> (exists x_o exists x_t0 (rbaco_requires_task_binding(x_h, x_o) & rbaco_requests_operation(x_q, x_o) & rbaco_request_time(x_q, x_t0) & rbaco_in_force(x_h, x_t0) & (-((exists x_p rbaco_applies_within(x_h, x_p))) | (exists x_i (occurrent_part_of(x_q, x_i) & rbaco_scope_fits(x_h, x_i)))) & -((exists x_k exists x_s exists x_u (occurrent_part_of(x_q, x_k) & isa_rbaco_task_instance(x_k, x_u) & cco_prescribed_by(x_k, x_s) & rbaco_requires_operation(x_s, x_o)))))))) # label(rbaco_g3).
(all x_s all x_a all x_d all x_t ((rbaco_in_force(x_s, x_t) & rbaco_has_head(x_s, x_a) & rbaco_names_member(x_s, x_d)) -> rbaco_member_of(x_d, x_a, x_t))) # label(rbaco_t1).
(all x_s all x_a all x_b all x_x all x_t ((rbaco_in_force(x_s, x_t) & rbaco_has_head(x_s, x_a) & rbaco_has_senior(x_s, x_b) & rbaco_member_of(x_x, x_b, x_t)) -> rbaco_member_of(x_x, x_a, x_t))) # label(rbaco_t2).
(all x_s all x_a all x_b all x_n all x_x all x_y all x_e all x_t ((rbaco_in_force(x_s, x_t) & rbaco_has_head(x_s, x_a) & rbaco_has_linking_base(x_s, x_b) & rbaco_linked_role(x_s, x_n) & rbaco_member_of(x_y, x_b, x_t) & rbaco_role_of_name(x_y, x_n, x_e) & rbaco_member_of(x_x, x_e, x_t)) -> rbaco_member_of(x_x, x_a, x_t))) # label(rbaco_t3).
(all x_s all x_a all x_b1 all x_b2 all x_x all x_t ((rbaco_in_force(x_s, x_t) & rbaco_has_head(x_s, x_a) & rbaco_has_body(x_s, x_b1) & rbaco_has_body(x_s, x_b2) & -((x_b1 = x_b2)) & rbaco_member_of(x_x, x_b1, x_t) & rbaco_member_of(x_x, x_b2, x_t)) -> rbaco_member_of(x_x, x_a, x_t))) # label(rbaco_t4).
(all x_x all x_t (rbaco_member_of(x_x, c_rt_role, x_t) -> (exists x_s (rbaco_in_force(x_s, x_t) & rbaco_has_head(x_s, c_rt_role) & (rbaco_names_member(x_s, x_x) | (exists x_b (rbaco_has_senior(x_s, x_b) & rbaco_member_of(x_x, x_b, x_t))) | (exists x_b exists x_n exists x_y exists x_e (rbaco_has_linking_base(x_s, x_b) & rbaco_linked_role(x_s, x_n) & rbaco_member_of(x_y, x_b, x_t) & rbaco_role_of_name(x_y, x_n, x_e) & rbaco_member_of(x_x, x_e, x_t))) | (exists x_b1 exists x_b2 (rbaco_has_body(x_s, x_b1) & rbaco_has_body(x_s, x_b2) & -((x_b1 = x_b2)) & rbaco_member_of(x_x, x_b1, x_t) & rbaco_member_of(x_x, x_b2, x_t)))))))) # label(rbaco_t5).
end_of_list.
