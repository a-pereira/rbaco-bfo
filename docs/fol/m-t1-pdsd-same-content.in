formulas(assumptions).
isa_rbo_dsd_constraint(c_pd, c_u). rbo_has_cardinality(c_pd, 2). -(exists p rbo_applies_within(c_pd, p)) # label(fact0).
rbo_constrains_permission(c_pd, c_preq). rbo_constrains_permission(c_pd, c_papm) # label(fact1).
rbo_has_operation(c_preq, c_create). -rbo_has_operation(c_papm, c_create) # label(fact2).
(all o (rbo_has_operation(c_papm, o) <-> o = c_approve)). (all o (rbo_has_operation(c_pappr, o) <-> o = c_approve)) # label(fact3).
(all b -rbo_has_access_object(c_papm, b)). (all b -rbo_has_access_object(c_pappr, b)) # label(fact4).
(all e -rbo_has_object_description(c_papm, e)). (all e -rbo_has_object_description(c_pappr, e)) # label(fact5).
isa_rbo_business_process(c_po, c_u) # label(fact6).
occurrent_part_of(c_q1, c_po). cco_has_agent(c_q1, c_tom). -(exists y rbo_on_behalf_of(c_q1, y)) # label(fact7).
rbo_decides_on(c_d1, c_q1). isa_rbo_access_grant(c_d1, c_t1). rbo_cites(c_d1, c_preq). rbo_decided_before(c_q1, c_q2) # label(fact8).
rbo_has_requester(c_q2, c_tom). -(exists y rbo_on_behalf_of(c_q2, y)). occurrent_part_of(c_q2, c_po) # label(fact9).
occupies_temporal_region(c_q2, c_uq). has_first_instant(c_uq, c_t2). rbo_requests_operation(c_q2, c_approve) # label(fact10).
(all b -rbo_requests_access_to(c_q2, b)) # label(fact11).
(all k all u -(occurrent_part_of(c_q2, k) & isa_rbo_task_instance(k, u))). rbo_in_force(c_pd, c_t2) # label(fact12).
isa_rbo_access_permission(c_pappr, c_t2). rbo_in_force(c_pappr, c_t2). rbo_assigned_to(c_pappr, c_dappr) # label(fact13).
isa_rbo_role_definition(c_dappr, c_t2). rbo_in_force(c_dappr, c_t2) # label(fact14).
isa_rbo_active_role(c_a, c_t2). inheres_in(c_a, c_tom). rbo_activated_in(c_a, c_po). concretizes(c_a, c_dappr, c_t2) # label(fact15).
end_of_list.
