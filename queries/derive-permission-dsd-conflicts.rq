# DERIVATION. A dynamic separation of duty conflict report for the access request decide-access.rq takes
# next at ?evalTime, when a dynamic permission constraint refuses it (Botha and Eloff 2001, Table 2 rows 2
# and 3, p.676; clif [rbaco-s15]). Run over the in-force facts, permission contents and regulation coverage
# for the same time, before decide-access.rq, which denies a request such a report describes, citing the
# constraint. The runner alternates the two until every request at ?evalTime is decided.
# Order: requests at one instant are taken one at a time in IRI order, so that the first one's decision is
# in the graph when the second is counted (clif rbaco-decided-before). The request taken is the undecided
# one with the smallest IRI.
# Permissions are compared by content (derive-permission-content.rq), not as individuals. The request is
# refused when a permission covering it has the content of a member of the set and, counting that content
# and every member content already exercised in the instance, n or more are reached. "Exercised" is read
# as granted: a grant citing a permission with that content decides on a request that is part of the
# instance and was decided before this one. Requests count for their principal (clif [rbaco-p1]), and
# principals a dynamic conflicting agent designation in force counts as one with the requester's count
# together ([rbaco-u4]). The constraint and the designations must be in force at ?evalTime and fit the
# instance's plan. The report names the members whose contents were counted, read from the count itself.
# Refusal at the request only: activations are not refused, since that would withhold the role's
# other permissions; the worklist (cq-worklist.rq) keeps the task off the list instead.
PREFIX rbaco:  <https://w3id.org/rbaco/bfo/>
PREFIX rbacow: <https://example.org/rbaco/work#>
PREFIX obo:  <http://purl.obolibrary.org/obo/>
PREFIX cco:  <https://www.commoncoreontologies.org/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
CONSTRUCT {
  ?report a rbaco:RBACO_0000020 ;
          rdfs:label ?label ;
          rbaco:RBACO_0000124 ?x ;
          rbaco:RBACO_0000125 ?c ;
          rbaco:RBACO_0000146 ?counted ;
          rbaco:RBACO_0000127 ?instance ;
          rbaco:RBACO_0000128 ?req ;
          rbaco:RBACO_0000204 ?why .
}
WHERE {
  {
    SELECT ?req ?x ?instance ?c ?n (COUNT(DISTINCT ?key) AS ?k)
           (CONCAT(" ", GROUP_CONCAT(DISTINCT STR(?m); separator=" "), " ") AS ?members) WHERE {
      ?req a rbaco:RBACO_0000024 ; obo:BFO_0000132 ?instance ;
           obo:BFO_0000199/obo:BFO_0000222/rbaco:RBACO_0000205 ?t .
      ?instance a rbaco:RBACO_0000004 .
      FILTER (?t = ?evalTime)
      # the undecided request with the smallest IRI at ?evalTime
      FILTER NOT EXISTS { ?d0 rbaco:RBACO_0000112 ?req }
      FILTER NOT EXISTS { ?r0 a rbaco:RBACO_0000024 ;
                              obo:BFO_0000199/obo:BFO_0000222/rbaco:RBACO_0000205 ?t0 .
                          FILTER (?t0 = ?evalTime && STR(?r0) < STR(?req))
                          FILTER NOT EXISTS { ?d1 rbaco:RBACO_0000112 ?r0 } }
      { ?req rbaco:RBACO_0000143 ?x } UNION { ?req rbaco:RBACO_0000107 ?x FILTER NOT EXISTS { ?req rbaco:RBACO_0000143 ?obo } }
      ?c a rbaco:RBACO_0000014 ; rbacow:inForceAt ?evalTime ; rbaco:RBACO_0000201 ?n .
      FILTER (NOT EXISTS { ?c rbaco:RBACO_0000115 ?anyPlan }
              || EXISTS { ?c rbaco:RBACO_0000115 ?plan . ?instance cco:ont00001920 ?plan })
      # the request falls under the set: a permission covering it has the content of a member
      FILTER EXISTS { ?c rbaco:RBACO_0000134/rbacow:contentKey ?hitKey .
                      ?cov rbacow:covers ?req ; a rbaco:RBACO_0000007 ; rbacow:contentKey ?hitKey }
      ?c rbaco:RBACO_0000134 ?m . ?m rbacow:contentKey ?key .
      FILTER (EXISTS { ?cov2 rbacow:covers ?req ; a rbaco:RBACO_0000007 ; rbacow:contentKey ?key }
              || EXISTS {
        ?grant a rbaco:RBACO_0000022 ; rbaco:RBACO_0000112 ?q2 ; rbaco:RBACO_0000113 ?cited .
        ?cited rbacow:contentKey ?key .
        ?q2 obo:BFO_0000132 ?instance ; obo:BFO_0000199/obo:BFO_0000222/rbaco:RBACO_0000205 ?t2 .
        FILTER (?t2 < ?t || (?t2 = ?t && STR(?q2) < STR(?req)))
        { ?q2 rbaco:RBACO_0000143 ?y } UNION { ?q2 rbaco:RBACO_0000107 ?y FILTER NOT EXISTS { ?q2 rbaco:RBACO_0000143 ?obo2 } }
        FILTER (?y = ?x || EXISTS { ?g a rbaco:RBACO_0000047 ; rbacow:inForceAt ?evalTime ; rbacow:joins ?x , ?y ;
                                    rbacow:appliesTo ?c ; rbacow:appliesIn ?instance })
      })
    } GROUP BY ?req ?x ?instance ?c ?n
    HAVING (COUNT(DISTINCT ?key) >= ?n)
  }
  ?c rbaco:RBACO_0000134 ?counted .
  FILTER (CONTAINS(?members, CONCAT(" ", STR(?counted), " ")))
  OPTIONAL { ?c rdfs:label ?cLabel }
  BIND (IRI(CONCAT(STR(?req), "-permission-dsd-conflict")) AS ?report)
  BIND (CONCAT("permission DSD conflict: ", STR(?req)) AS ?label)
  BIND (CONCAT("Violates DSD constraint ", COALESCE(STR(?cLabel), STR(?c)),
               ": granting the request would give its principal, with any agent counted as one with them, ",
               STR(?k), " of its permissions exercised in one instance ",
               "(permissions with one operation and object scope count once)") AS ?why)
}
