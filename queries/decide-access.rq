# DERIVATION. One access decision for the access request taken next at ?evalTime: NIST CheckAccess (p.254)
# with deny-overrides (clif [rbaco-a3]). Requests at one instant are decided one at a time in IRI order: this
# query decides the undecided one with the smallest IRI, and the runner repeats it, after
# derive-permission-dsd-conflicts.rq each time, until every request at ?evalTime is decided, so that
# permission separation of duty counts the earlier ones (clif rbaco-decided-before). Run over the in-force
# facts and regulation coverage for the same time.
#   any covering prohibition          -> access denial citing the prohibition(s)
#   else a task-bound operation       -> access denial citing the requirement(s) (clif [rbaco-g3]): one
#        requirement in force and in     in force names the requested operation, applies within no plan
#        scope is unmet                  or within the plan of the request's instance, and the request is
#                                        part of no task instance whose specification requires the operation
#   else a permission DSD report      -> access denial citing the constraint(s) that refused it
#        describes the request           (derive-permission-dsd-conflicts.rq, run before this one)
#   else any covering permission      -> access grant citing the permission(s)
#   else                              -> access denial citing nothing (deny by default)
PREFIX rbaco:  <https://w3id.org/rbaco/bfo/>
PREFIX rbacow: <https://example.org/rbaco/work#>
PREFIX obo:  <http://purl.obolibrary.org/obo/>
PREFIX cco:  <https://www.commoncoreontologies.org/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
CONSTRUCT {
  ?decision a ?decisionClass ;
            rbaco:RBACO_0000112 ?req ;
            rbaco:RBACO_0000113 ?cited , ?citedConstraint , ?citedBinding ;
            rdfs:label ?label .
}
WHERE {
  ?req a rbaco:RBACO_0000024 ;
       obo:BFO_0000199/obo:BFO_0000222/rbaco:RBACO_0000205 ?t .
  FILTER (?t = ?evalTime)
  # the undecided request with the smallest IRI at ?evalTime
  FILTER NOT EXISTS { ?d0 rbaco:RBACO_0000112 ?req }
  FILTER NOT EXISTS { ?r0 a rbaco:RBACO_0000024 ;
                          obo:BFO_0000199/obo:BFO_0000222/rbaco:RBACO_0000205 ?t0 .
                      FILTER (?t0 = ?evalTime && STR(?r0) < STR(?req))
                      FILTER NOT EXISTS { ?d1 rbaco:RBACO_0000112 ?r0 } }
  BIND (IRI(CONCAT(STR(?req), "-decision")) AS ?decision)
  BIND (EXISTS { ?p1 rbacow:covers ?req . ?p1 a rbaco:RBACO_0000008 } AS ?prohibited)
  BIND (EXISTS { ?p2 rbacow:covers ?req . ?p2 a rbaco:RBACO_0000007 } AS ?permitted)
  BIND (EXISTS {
    ?req rbaco:RBACO_0000108 ?op .
    ?h1 a rbaco:RBACO_0000050 ; rbaco:RBACO_0000148 ?op ; rbacow:inForceAt ?evalTime .
    FILTER (NOT EXISTS { ?h1 rbaco:RBACO_0000115 ?anyPlan1 }
            || EXISTS { ?h1 rbaco:RBACO_0000115 ?plan1 . ?req obo:BFO_0000132 ?inst1 . ?inst1 cco:ont00001920 ?plan1 })
    FILTER NOT EXISTS { ?req obo:BFO_0000132 ?k1 . ?k1 a rbaco:RBACO_0000041 ;
                        cco:ont00001920 ?s1 . ?s1 rbaco:RBACO_0000133 ?op }
  } AS ?unbound)
  BIND (EXISTS { ?rep a rbaco:RBACO_0000020 ; rbaco:RBACO_0000128 ?req } AS ?sodRefused)
  BIND (IF(!?prohibited && !?unbound && !?sodRefused && ?permitted, rbaco:RBACO_0000022, rbaco:RBACO_0000023) AS ?decisionClass)
  BIND (IF(?prohibited, rbaco:RBACO_0000008, rbaco:RBACO_0000007) AS ?citedClass)
  BIND (CONCAT(IF(?decisionClass = rbaco:RBACO_0000022, "grant", "denial"), " of ", STR(?req)) AS ?label)
  OPTIONAL { ?cited rbacow:covers ?req . ?cited a ?citedClass .
             FILTER (?prohibited || (!?unbound && !?sodRefused)) }
  OPTIONAL {
    ?req rbaco:RBACO_0000108 ?op2 .
    ?citedBinding a rbaco:RBACO_0000050 ; rbaco:RBACO_0000148 ?op2 ; rbacow:inForceAt ?evalTime .
    FILTER (NOT EXISTS { ?citedBinding rbaco:RBACO_0000115 ?anyPlan2 }
            || EXISTS { ?citedBinding rbaco:RBACO_0000115 ?plan2 . ?req obo:BFO_0000132 ?inst2 . ?inst2 cco:ont00001920 ?plan2 })
    FILTER NOT EXISTS { ?req obo:BFO_0000132 ?k2 . ?k2 a rbaco:RBACO_0000041 ;
                        cco:ont00001920 ?s2 . ?s2 rbaco:RBACO_0000133 ?op2 }
    FILTER (!?prohibited)
  }
  OPTIONAL { ?rep2 a rbaco:RBACO_0000020 ; rbaco:RBACO_0000128 ?req ; rbaco:RBACO_0000125 ?citedConstraint .
             FILTER (?sodRefused && !?prohibited && !?unbound) }
}
