# COMPETENCY QUESTION (ROWLBAC section 3.5, class level: "can every student use lab printers?").
# For each role universal that mirrors a role definition: which operations does an active role of
# that kind permit at ?evalTime, counting inherited regulations (NIST Def. 2a) and letting a prohibition
# on the same operation override (deny-overrides)? Regulations count while in force. Run over the
# in-force facts and hierarchy snapshot for that time.
# Object scopes are compared as derive-regulation-coverage.rq matches them to requests. A prohibition
# overrides when its scope is the permission's: the same named object, the same object description, or
# neither on both sides, since a regulation naming neither covers only requests that name no object.
# When both sides are scoped but differently (another object, or an object description against an
# object), the prohibition may override for some objects: whether a description's criteria hold of an
# object can depend on the requester. A scoped and an unscoped regulation never meet. Prohibitions that
# name no role definition depend on the person, not the role, and are not considered.
PREFIX rbaco:  <https://w3id.org/rbaco/bfo/>
PREFIX rbacow: <https://example.org/rbaco/work#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?universal ?operation ?object ?description ?answer
WHERE {
  ?universal rbaco:RBACO_0000301 ?def .
  ?def rbaco:RBACO_0000120* ?junior .
  ?perm a rbaco:RBACO_0000007 ; rbaco:RBACO_0000105 ?junior ; rbaco:RBACO_0000101 ?operation ;
        rbacow:inForceAt ?evalTime .
  OPTIONAL { ?perm rbaco:RBACO_0000102 ?object }
  OPTIONAL { ?perm rbaco:RBACO_0000103 ?description }
  BIND (BOUND(?object) || BOUND(?description) AS ?scoped)
  BIND (EXISTS {
    ?def rbaco:RBACO_0000120* ?j2 .
    ?proh a rbaco:RBACO_0000008 ; rbaco:RBACO_0000105 ?j2 ; rbaco:RBACO_0000101 ?operation ;
          rbacow:inForceAt ?evalTime .
    FILTER ((BOUND(?object) && EXISTS { ?proh rbaco:RBACO_0000102 ?object })
            || (BOUND(?description) && EXISTS { ?proh rbaco:RBACO_0000103 ?description })
            || (!?scoped && NOT EXISTS { ?proh rbaco:RBACO_0000102 ?po } && NOT EXISTS { ?proh rbaco:RBACO_0000103 ?pd }))
  } AS ?overridden)
  BIND (EXISTS {
    ?def rbaco:RBACO_0000120* ?j3 .
    ?proh2 a rbaco:RBACO_0000008 ; rbaco:RBACO_0000105 ?j3 ; rbaco:RBACO_0000101 ?operation ;
           rbacow:inForceAt ?evalTime .
    FILTER (?scoped && (EXISTS { ?proh2 rbaco:RBACO_0000102 ?po2 } || EXISTS { ?proh2 rbaco:RBACO_0000103 ?pd2 }))
  } AS ?partly)
  BIND (IF(?overridden, "prohibited (a prohibition overrides)",
           IF(?partly, "permitted; a prohibition with another object scope may override", "permitted")) AS ?answer)
}
ORDER BY ?universal ?operation
