# DERIVATION. A dynamic separation of duty conflict report for each role activation request made at
# ?evalTime that a DSD constraint refuses: ROWLBAC's ProhibitedRoleActivation with its justification
# (section 3.3.5), corrected to count active roles in the instance rather than assigned roles.
# The report names the requested role definition and every counted one, read from the count itself. The
# subject is the request's principal (clif [rbaco-p1]); roles active for agents a dynamic conflicting agent
# designation in force counts as one with the principal count too (Botha and Eloff 2001, p.676; [rbaco-u4]).
# Run before decide-activation.rq for the same time, which refuses a request such a report describes. The
# count: the constraint and the designations in force at ?evalTime and fitting the instance's plan; for a
# same-time constraint, roles active at ?evalTime, an active role ending at its deactivation or at the Loss
# of Role of the assigned role it depends on; for a whole-instance one, every role activated at or before
# ?evalTime. A role activated at the request's own instant counts when an activation request with a
# smaller IRI, or none, asked for it: requests at one instant are taken in IRI order, as access requests
# are (decide-access.rq).
PREFIX rbaco:  <https://w3id.org/rbaco/bfo/>
PREFIX rbacow: <https://example.org/rbaco/work#>
PREFIX obo:  <http://purl.obolibrary.org/obo/>
PREFIX cco:  <https://www.commoncoreontologies.org/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
CONSTRUCT {
  ?report a rbaco:RBACO_0000020 ;
          rdfs:label ?label ;
          rbaco:RBACO_0000124 ?person ;
          rbaco:RBACO_0000125 ?c ;
          rbaco:RBACO_0000126 ?counted ;
          rbaco:RBACO_0000127 ?instance ;
          rbaco:RBACO_0000128 ?areq ;
          rbaco:RBACO_0000204 ?why .
}
WHERE {
  {
    SELECT ?areq ?person ?instance ?c ?n (COUNT(DISTINCT ?member) AS ?k)
           (CONCAT(" ", GROUP_CONCAT(DISTINCT STR(?member); separator=" "), " ") AS ?members) WHERE {
      ?areq a rbaco:RBACO_0000025 ; rbaco:RBACO_0000110 ?def ;
            obo:BFO_0000132 ?instance ; obo:BFO_0000199/obo:BFO_0000222/rbaco:RBACO_0000205 ?t .
      FILTER (?t = ?evalTime)
      { ?areq rbaco:RBACO_0000143 ?person } UNION { ?areq rbaco:RBACO_0000107 ?person FILTER NOT EXISTS { ?areq rbaco:RBACO_0000143 ?obo } }
      ?c a rbaco:RBACO_0000014 ; rbacow:inForceAt ?evalTime ; rbaco:RBACO_0000114 ?def ;
         rbaco:RBACO_0000114 ?member ; rbaco:RBACO_0000201 ?n .
      # scope: no business process plan named, or the instance is prescribed by the one named
      FILTER (NOT EXISTS { ?c rbaco:RBACO_0000115 ?anyPlan }
              || EXISTS { ?c rbaco:RBACO_0000115 ?plan . ?instance cco:ont00001920 ?plan })
      FILTER (?member = ?def || EXISTS {
        ?active rbaco:RBACO_0000106 ?instance ; obo:BFO_0000197 ?y ; obo:BFO_0000059 ?member .
        ?activation cco:ont00001986 ?active ; obo:BFO_0000199/obo:BFO_0000222/rbaco:RBACO_0000205 ?tAct .
        FILTER (?tAct < ?t || (?tAct = ?t && NOT EXISTS { ?a2 rbaco:RBACO_0000111 ?activation .
                                                          FILTER (STR(?a2) > STR(?areq)) }))
        FILTER (EXISTS { ?c a rbaco:RBACO_0000016 }
                || (NOT EXISTS { ?drop cco:ont00001921 ?active ;
                                 obo:BFO_0000199/obo:BFO_0000222/rbaco:RBACO_0000205 ?tDrop . FILTER (?tDrop <= ?t) }
                    && NOT EXISTS { ?active obo:BFO_0000195 ?held .
                                    ?loss cco:ont00001921 ?held ; a cco:ont00000613 ;
                                          obo:BFO_0000199/obo:BFO_0000222/rbaco:RBACO_0000205 ?tLoss .
                                    FILTER (?tLoss <= ?t) }))
        FILTER (?y = ?person || EXISTS { ?g a rbaco:RBACO_0000047 ; rbacow:inForceAt ?evalTime ; rbacow:joins ?person , ?y ;
                                         rbacow:appliesTo ?c ; rbacow:appliesIn ?instance })
      })
    } GROUP BY ?areq ?person ?instance ?c ?n
    HAVING (COUNT(DISTINCT ?member) >= ?n)
  }
  ?c rbaco:RBACO_0000114 ?counted .
  FILTER (CONTAINS(?members, CONCAT(" ", STR(?counted), " ")))
  OPTIONAL { ?c rdfs:label ?cLabel }
  BIND (IRI(CONCAT(STR(?areq), "-dsd-conflict")) AS ?report)
  BIND (CONCAT("DSD conflict: ", STR(?areq)) AS ?label)
  BIND (CONCAT("Violates DSD constraint ", COALESCE(STR(?cLabel), STR(?c)),
               ": the activation would give the requester ", STR(?k), " of its roles in one instance") AS ?why)
}
