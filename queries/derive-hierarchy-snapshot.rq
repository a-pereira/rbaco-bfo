# DERIVATION. Snapshot of the role hierarchy at ?evalTime (bound by the caller), after derive-in-force.rq
# for the same time. Each role inheritance statement in force at ?evalTime whose senior and junior role
# definitions are in force gives one direct rbaco:RBACO_0000120 (is senior to) edge, so a retired definition
# leaves the hierarchy along with its edges. Queries take the closure with the path
# rbaco:RBACO_0000120*.
PREFIX rbaco:  <https://w3id.org/rbaco/bfo/>
PREFIX rbacow: <https://example.org/rbaco/work#>
PREFIX obo:  <http://purl.obolibrary.org/obo/>
PREFIX cco:  <https://www.commoncoreontologies.org/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
CONSTRUCT { ?senior rbaco:RBACO_0000120 ?junior }
WHERE {
  ?st a rbaco:RBACO_0000017 ;
      rbacow:inForceAt ?evalTime ;
      rbaco:RBACO_0000118 ?senior ;
      rbaco:RBACO_0000119 ?junior .
  ?senior rbacow:inForceAt ?evalTime .
  ?junior rbacow:inForceAt ?evalTime .
}
