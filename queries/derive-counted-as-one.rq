# DERIVATION (intermediate, independent of time). For each conflicting agent designation, written with
# query-internal predicates outside the ontology: the agents it counts as one (rbacow:joins), the constraints
# it applies to (rbacow:appliesTo) and, for a dynamic one, the instances it applies in (rbacow:appliesIn). The
# conflict derivations and the worklist then read "an agent a designation in force counts as one with the
# principal" (Botha and Eloff 2001, Table 1 row 3 and Table 2; clif [rbaco-u3], [rbaco-u4]) as one pattern:
# ?g a <kind> ; rbacow:inForceAt ?evalTime ; rbacow:joins ?x , ?y ; rbacow:appliesTo ?c [; rbacow:appliesIn ?instance].
#   joins     - the agent it designates (RBACO_0000138), or each member (BFO_0000129) of the group it
#               designates (RBACO_0000139)
#   appliesTo - each constraint in its constraint scope (RBACO_0000140); with none, every constraint with a
#               cardinality (RBACO_0000201), as every constraint a query counts has
#   appliesIn - each instance prescribed by a plan in its plan scope (RBACO_0000115); with none, every
#               instance something is part of (BFO_0000132) or a work item is in (RBACO_0000142), which is
#               where the queries find the instances they count in
# Run once per dataset, before the evaluation times: none of this depends on time, and no derivation writes
# a triple it reads.
PREFIX rbaco:  <https://w3id.org/rbaco/bfo/>
PREFIX rbacow: <https://example.org/rbaco/work#>
PREFIX obo:  <http://purl.obolibrary.org/obo/>
PREFIX cco:  <https://www.commoncoreontologies.org/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
CONSTRUCT { ?g rbacow:joins ?agent ; rbacow:appliesTo ?c ; rbacow:appliesIn ?instance }
WHERE {
  {
    ?g a rbaco:RBACO_0000045 ; rbaco:RBACO_0000138|rbaco:RBACO_0000139/^obo:BFO_0000129 ?agent .
  } UNION {
    ?g a rbaco:RBACO_0000045 ; rbaco:RBACO_0000140 ?c .
  } UNION {
    ?g a rbaco:RBACO_0000045 .
    FILTER NOT EXISTS { ?g rbaco:RBACO_0000140 ?anyC }
    ?c rbaco:RBACO_0000201 ?n .
  } UNION {
    ?g a rbaco:RBACO_0000047 ; rbaco:RBACO_0000115 ?plan .
    ?instance cco:ont00001920 ?plan .
  } UNION {
    ?g a rbaco:RBACO_0000047 .
    FILTER NOT EXISTS { ?g rbaco:RBACO_0000115 ?anyPlan }
    { ?part obo:BFO_0000132 ?instance } UNION { ?item rbaco:RBACO_0000142 ?instance }
  }
}
