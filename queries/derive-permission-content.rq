# DERIVATION (intermediate, independent of time). The content of each access regulation, written as
# rbacow:contentKey, a query-internal predicate outside the ontology: its operation, named object and object
# description, as one string. NIST's permission-to-role assignment is many-to-many (Def. 1, p.234), while
# RBACO writes one regulation per role definition it is assigned to, so regulations with the same content are
# one NIST permission assigned to several roles. Separation of duty compares permissions by this key, not
# by individual (clif rbaco-same-content): a set naming APM's approve-order permission also catches
# Approver's, and naming both counts one approval once. Object descriptions are compared as individuals,
# not by their criteria. Run once per dataset, before the evaluation times.
PREFIX rbaco:  <https://w3id.org/rbaco/bfo/>
PREFIX rbacow: <https://example.org/rbaco/work#>
PREFIX obo:  <http://purl.obolibrary.org/obo/>
PREFIX cco:  <https://www.commoncoreontologies.org/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
CONSTRUCT { ?reg rbacow:contentKey ?key }
WHERE {
  ?reg a rbaco:RBACO_0000006 ;
       rbaco:RBACO_0000101 ?op .
  OPTIONAL { ?reg rbaco:RBACO_0000102 ?obj }
  OPTIONAL { ?reg rbaco:RBACO_0000103 ?desc }
  BIND (CONCAT(STR(?op), " ", COALESCE(STR(?obj), "-"), " ", COALESCE(STR(?desc), "-")) AS ?key)
}
