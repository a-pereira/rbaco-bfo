# CHECK. Task instances and the active roles activated for them, against the commitments and
# requirements OWL cannot state because they relate two values. Expect no rows.
#   task not in the role's instance  - clif [rbaco-k2]: the task instance is not an occurrent part of
#                                      the business process instance the role is activated in
#   not the task's required role     - [rbaco-k3]: the active role concretizes a definition other than
#                                      the one the task requires (strict least privilege)
#   bearer is not the task's agent   - [rbaco-k3]
#   agent is not a person            - [rbaco-g1]: a human performer requirement in scope, and in force
#                                      when the task instance began (issued at or before its start and
#                                      not retired by then), names the task's specification
#   no prior human instance          - [rbaco-g2]: the specification requires a prior one, and the
#                                      instance holds no instance of it that ended before this one
#                                      began with a person as agent
PREFIX rbaco:  <https://w3id.org/rbaco/bfo/>
PREFIX rbacow: <https://example.org/rbaco/work#>
PREFIX obo:  <http://purl.obolibrary.org/obo/>
PREFIX cco:  <https://www.commoncoreontologies.org/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
SELECT ?subject ?problem
WHERE {
  {
    ?subject a rbaco:RBACO_0000003 ; rbaco:RBACO_0000136 ?task ; rbaco:RBACO_0000106 ?instance .
    FILTER NOT EXISTS { ?task obo:BFO_0000132 ?instance }
    BIND ("task not in the role's instance" AS ?problem)
  } UNION {
    ?subject a rbaco:RBACO_0000003 ; rbaco:RBACO_0000136 ?task ; obo:BFO_0000059 ?def .
    ?task cco:ont00001920 ?spec . ?spec rbaco:RBACO_0000132 ?reqDef .
    FILTER (?def != ?reqDef)
    BIND ("not the task's required role" AS ?problem)
  } UNION {
    ?subject a rbaco:RBACO_0000003 ; rbaco:RBACO_0000136 ?task ; obo:BFO_0000197 ?bearer .
    FILTER NOT EXISTS { ?task cco:ont00001833 ?bearer }
    BIND ("bearer is not the task's agent" AS ?problem)
  } UNION {
    ?subject a rbaco:RBACO_0000041 ; cco:ont00001920 ?spec ; obo:BFO_0000132 ?instance ;
             cco:ont00001833 ?agent ; obo:BFO_0000199/obo:BFO_0000222/rbaco:RBACO_0000205 ?tBegin .
    ?instance a rbaco:RBACO_0000004 .
    ?h a rbaco:RBACO_0000049 ; rbaco:RBACO_0000145 ?spec .
    ?hIssue cco:ont00001986 ?h ; a rbaco:RBACO_0000031 ;
            obo:BFO_0000199/obo:BFO_0000222/rbaco:RBACO_0000205 ?tIssue . FILTER (?tIssue <= ?tBegin)
    FILTER NOT EXISTS { ?hRetire cco:ont00001921 ?h ; a rbaco:RBACO_0000032 ;
                        obo:BFO_0000199/obo:BFO_0000222/rbaco:RBACO_0000205 ?tRetire . FILTER (?tRetire <= ?tBegin) }
    FILTER (NOT EXISTS { ?h rbaco:RBACO_0000115 ?anyP } || EXISTS { ?h rbaco:RBACO_0000115 ?p . ?instance cco:ont00001920 ?p })
    FILTER NOT EXISTS { ?agent a cco:ont00001262 }
    BIND ("agent is not a person" AS ?problem)
  } UNION {
    ?subject a rbaco:RBACO_0000041 ; cco:ont00001920 ?spec ; obo:BFO_0000132 ?instance ;
             obo:BFO_0000199/obo:BFO_0000222/rbaco:RBACO_0000205 ?tStart .
    ?instance a rbaco:RBACO_0000004 .
    ?spec rbaco:RBACO_0000144 ?prior .
    FILTER NOT EXISTS {
      ?k1 a rbaco:RBACO_0000041 ; cco:ont00001920 ?prior ; obo:BFO_0000132 ?instance ;
          cco:ont00001833 ?a1 ; obo:BFO_0000199/obo:BFO_0000224/rbaco:RBACO_0000205 ?tEnd .
      ?a1 a cco:ont00001262 .
      FILTER (?tEnd <= ?tStart) }
    BIND ("no prior human instance" AS ?problem)
  }
}
