# CHECK. An RT statement is issued by the issuer of its head role: only A defines A.r.
# Lists statements whose issuing act has some other agent. Expect no rows.
PREFIX rbaco:  <https://w3id.org/rbaco/bfo/>
PREFIX rbacow: <https://example.org/rbaco/work#>
PREFIX obo:  <http://purl.obolibrary.org/obo/>
PREFIX cco:  <https://www.commoncoreontologies.org/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
SELECT ?statement ?issuer ?agent
WHERE {
  ?statement a rbaco:RBACO_0000034 ;
             rbaco:RBACO_0000116 ?head .
  ?head rbaco:RBACO_0000121 ?issuer .
  ?issue cco:ont00001986 ?statement ; cco:ont00001833 ?agent .
  FILTER (?agent != ?issuer)
}
